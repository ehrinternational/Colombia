<?xml version="1.0" encoding="utf-8"?>
<module name="Odontólogo" type="onload" trigger="GetLastDepartment,t_condition,Condition,SetDefaultSpecialty">
  <facet name="FileName" value="Dentistry"/>
  <facet name="PatientSearched" value="false"/>
  <facet name="DefaultPatientId"/>
  <facet name="DefaultOrderType"/>
  <facet name="DefaultOrderGuid"/>
  <facet name="DefaultAdmitType" value="Outpatient"/>
  <facet name="DefaultSpecialty" value="Dental"/>
  <facet name="DefaultExamType" value="Dental"/>
  <facet name="EditCalendarType" value="Dentistry"/>
  <facet name="EditCalendar" value="Odontología México"/>
   <!-- Import templates -->
  <partial link="Partials/ColombiaPartialTemplates.xml"/>
  <headerbutton name="btnReportsByType"
    icon="print" label="Informes"
    preset="Report_Type=Dentistry"
    trigger="ReportList"
    action="redirect" target="mdlReports"/>
  <headerbutton name="btnTaskCalendar"
    icon="calendar" label="Mis Tareas"
    preset="DefaultPatientId="
    trigger="MyTaskAppointmentTimes"
    action="redirect" target="mdlMyTaskAppointments"/>
  <headerbutton name="btnMyInterconsults"
    icon="calendar" label="Interconsultas"
    trigger="grdMyInternalConsultList"
    action="redirect" target="MyInternalConsultList"/>
  <headerbutton name="btnConsultCalendar"
    icon="calendar" label="Odontólogo"
    preset="DefaultPatientId=,DefaultOrderGuid=,ConsultCalendarType=Dentistry"
    trigger="ConsultVisit_selAppointmentTypeGuid"
    action="redirect" target="mdlConsultVisitCalendarAppointments"/>
  <!-- Display list of patients by department -->
  <partial link="Partials/ColombiaPartialAdmittedPatientsByDepartment.xml"/>
  <!-- Display a list of internal consult requests -->
  <partial link="Partials/ColombiaPartialServiceConsultRequestWorklist.xml"/>
  <!--Tabmodal for admitting/reviewing hospital patients-->
  <section type="tabmodal" badge="none" name="PatientTabModal" size="large" title="Información del Paciente">
    <group showif="never">
      <row>
        <!--Read the patient record and display-->
        <control type="text"
          name="PatientId"
          datarequest="GetPatientAllFields"
          appendrequest="PatientId=[PatientId]"
          inject="PatientInfo"
          set="[HasOpenVisit]=true;PatientVisitGuid=[[PatientVisit]]"
          provoke="[HasOpenVisit]=true;PatientVisitGuid,ButtonGroupSelect"/>
        <!-- Get patient visit information -->
        <control type="hidden" span="4" name="PatientVisitGuid" 
          datarequest="GetPatientVisitByUniqueId"
          appendrequest="UniqueId=[PatientVisitGuid]"
          inject="VisitInfo"
          provoke="[[CurrentDepartment]]=[DepartmentGuidLookup]+[DepartmentGuidLookup]!;SetHospitalService,
            [[CurrentDepartment]]![DepartmentGuidLookup]+[DepartmentGuidLookup]!;btnApproveDeptTransfer"/>
        <control type="button" name="btnApproveDeptTransfer" action="trigger"
          confirm="Este paciente tiene una visita abierta en otro departamento. Confirme que desea transferirlos a su departamento."
          provoke="SetHospitalService"/>
        <!-- Set the hospital service and update the provider list -->
        <control type="hidden" 
          name="SetHospitalService"
          datarequest="UpdatePatientVisitAllFields"
          appendrequest="patientId=[PatientId],departmentGuid=[DepartmentGuidLookup],patientVisitUniqueId=[PatientVisitGuid],hospitalService=Atención"
          provoke="PatientList"/>
        <!-- Close the patient tabmodal -->
        <control type="button" name="ClosePatientTabModal" action="close|new"/>
      </row>
    </group>
    <!--Patient information-->
    <group name="PatientInfo">
      <columns>
        <column span="10">
          <partial link="Partials/ColombiaPartialPatientInfo.xml"/>
        </column>
        <column span="2">
          <partial link="Partials/ColombiaPartialDentistryPatientButtons.xml"/>
        </column>
      </columns>
    </group> 
     <!-- Patient visit and physician buttons -->
    <group name="VisitInfo">
      <columns>
        <column span="10">
          <partial link="Partials/ColombiaPartialHospitalVisitInfo.xml"/>
        </column>
        <column span="2">
          <partial link="Partials/ColombiaPartialDentistryVisitButtons.xml"/>
        </column>
      </columns>
    </group>
    <!-- Patient chart datagrids -->
    <group name="PatientGridGroup" reveal="[PatientId]!">
      <row>
        <control type="buttongroup" 
          name="ButtonGroupSelect" 
          edit="true" mode="auto" span="12"
          source="Tasks,Problems,Physicians,Vitals,Studies,Medication,Identification,Addresses,Contacts,Documents,Appointments,Surgery,Services" 
          sourcelabels="Tareas,Diagnósticos,Consultas,Signos Vitales,Estudios,Medicamentos,Identificación,Direcciones,Contactos,Subir Documentos,Citas,Cirugía,Servicios" 
          default="Tasks"  
          provoke="GridOptions|options"/>
      </row>
      <row>
        <control type="options" name="GridOptions" affector="ButtonGroupSelect" span="12">
          <partial link="./Partial/Grids/PartialPatientTasksWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialDiagnosisHistoryForPatient.xml"/>
          <partial link="./Partial/Grids/PartialAllergiesNoEdit.xml"/>
          <partial link="./Partial/Grids/PartialVitalSignsWithNewAndGraph.xml"/>
          <partial link="Partials/ColombiaPartialIdentificationGrid.xml"/>
          <partial link="Partials/ColombiaPartialPatientAddressList.xml"/>
          <partial link="Partials/ColombiaPartialPatientContactsColombia.xml"/>
          <partial link="./Partial/Grids/PartialECDFormsWithNewAndEditWindowMode.xml"/>
          <partial link="Partials/ColombiaPartialScannedDocumentsWithNewAndCancel.xml"/>
          <partial link="Partials/ColombiaPartialAppointmentListDentistry.xml"/>
          <partial link="Partials/ColombiaPartialConsultRequestsForPatientNoHospitals.xml"/>
          <partial link="Partials/ColombiaPartialServiceConsultRequestsForPatientWithAddAndEdit.xml"/>
          <partial link="Partials/ColombiaPartialInpatientMedicationsWithTemplateNewAndAdminister.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationsCompleted.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationActiveAdministrations.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationCompletedAdministrations.xml"/>
          <partial link="./Partial/Grids/PartialHomeMedicationWithNewAndEdit.xml"/>
          <partial link="Partials/ColombiaPartialImagingOrdersWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialImagingOrderHistory.xml"/>
          <partial link="Partials/ColombiaPartialImagingReports.xml"/>
          <partial link="./Partial/Grids/PartialScannedImagingDocumentsInWindow.xml"/>
          <partial link="Partials/ColombiaPartialSurgeryListForPatientWithAdd.xml"/>
          <partial link="./Partial/Grids/PartialProcedureOrdersWithNewAndEdit.xml"/>
        </control>
      </row>
    </group>
  </section>
    <!-- Colombia partials -->
    <partial target="mdlSurgeryOrderModal" link="Partials/ColombiaPartialSurgeryOrderModal.xml"/>
    <partial target="mdlInternalConsultModal" link="Partials/ColombiaPartialServiceConsultRequest.xml"/>
    <partial target="NewConsultModal" link="Partials/ColombiaPartialInterconsultRequest.xml"/>
    <partial target="MyInternalConsultList" link="Partials/ColombiaPartialMyInternalConsultRequestList.xml"/>
    <partial  link="Partials/ColombiaPartialPatientContactsModal.xml"/>
    <partial target="mdlMovePatient" link="Partials/ColombiaPartialMovePatients.xml"/>
    <partial target="mdlTransferPatient" link="Partials/ColombiaPartialTransferPatientWithBedAssignment.xml"/>
    <!-- Dental partials -->
    <partial target="mdlDentalTreatment" link="./Partial/Modals/PartialDentalCharting.xml"/>
    <partial target="mdlSpecialtyExaminations" link="./Partial/Modals/PartialPatientSpecialtyExamsModal.xml"/>
    <partial target="mdlAddSpecialDentalExaminations" link="./Partial/Modals/PartialPatientSpecialDentalExamsModal.xml"/>
    <partial target="mdlFindRoomInDepartment" link="./Partial/Beds/PartialAssignPatientBedInDepartment.xml"/>
     <!-- Calendars -->
    <partial target="mdlConsultVisitCalendarAppointments" link="./Partial/Calendars/PartialCalendarConsultAppointmentsAsModal.xml"/>
    <partial target="mdlMyTaskAppointments" link="./Partial/Calendars/PartialCalendarMySalesTasksAsModal.xml"/>
    <!-- Calendar Appointment modals -->
    <partial link="./Partial/Calendars/PartialCalendarConsultVisitAppointmentModal.xml"/>
    <!-- Admin modals -->
    <partial target="mdlCombinedECDForms" link="./Partial/Modals/PartialCombineECDFormsToPDF.xml"/>
    <partial target="mdlFindPatients" link="./Partial/Admin/PartialPatientSearchmodal.xml"/>
    <partial target="mdlCalendarSearchModal" link="Partials/ColombiaPartialCalendarSearchModal.xml"/>
		<partial target="mdlReports" link="./Partial/Admin/PartialReportModals.xml"/> 
    <!-- Demographic modals -->
    <partial link="Partials/ColombiaPartialPatientAddresses.xml"/>
    
    <partial link="./Partial/Modals/PartialPatientIdModal.xml"/>
    <partial link="./Partial/Modals/PartialPatientPhoneModal.xml"/>
    <!-- Messaging -->
		<partial link="./Partial/Messaging/PartialSendWYSIWYGEmail.xml"/>
    <partial target="mdlSendTextMessage" link="./Partial/Messaging/PartialSendTextMessageToPatient.xml"/>
    <partial target="mdlNewProjectTasks" link="./Partial/Messaging/PartialNewProjectTasks.xml"/>
</module>