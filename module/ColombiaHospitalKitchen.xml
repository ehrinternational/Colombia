<?xml version="1.0" encoding="utf-8"?>
<module name="Servicios Nutricionales" type="onload" trigger="NutritionMealsList">
  <facet name="FileName" value="HospitalKitchen"/>
  <facet name="FieldEdit" value="4"/>
  <headerbutton name="btnReportsByType"
    icon="print" label="Informes"
    preset="Report_Type=Nutrition"
    trigger="ReportList"
    action="redirect" target="mdlReports"/>
  <!-- Display a list of patient meal orders -->
  <partial link="Partials/ColombiaPartialNutritionMealOrdersList.xml"/>
  <!-- Patient tabmodal displays the patient chart -->
  <section type="tabmodal" badge="none" name="PatientTabModal" size="large" title="Información del Paciente" edit="false">
    <group name="GuidStorage">
      <row showif="never">
        <control type="text" span="4" name="PatientId"
          datarequest="GetPatientAllFields"
          appendrequest="PatientId=[PatientId]"
          inject="PatientInfo,rowRoomFullName"
          provoke="ERAllergyList,ERProblemList,GetNutritionNotes"/>
        <control type="hidden" span="4" name="GetNutritionNotes"
          datarequest="GetPatientVisitByUniqueId"
          appendrequest="UniqueId=[PatientVisit]"
          set="DietType=[[DietType]]"/>
        <control type="hidden" span="4" name="MealOrderGuid"
          acctsvcreq="true"
          datarequest="GetNutritionMealOrdersByMealGuid"
          appendrequest="mealGuid=[MealOrderGuid]"
          inject="MealOrderInfo"
          provoke="MealOrderComponentList"/>
        <control type="button" name="ClosePatientTabModal" action="close|new"/>
      </row>
    </group>
    <!-- Patient information and nursing buttons -->
    <group name="PatientInfo">
      <columns>
        <column span="10">
          <partial link="Partials/ColombiaPartialPatientInfo.xml"/>
        </column>
        <column span="2">
          <partial link="Partials/ColombiaPartialKitchenPatientButtons.xml"/>
        </column>
      </columns>
    </group>
    <!-- Patient visit and nursing buttons -->
    <group name="MealOrderInfo" title="Orden de Comida">
      <columns>
        <column span="10">
          <partial link="Partials/ColombiaPartialMealOrderInfo.xml"/>
        </column>
        <column span="2">
          <partial link="Partials/ColombiaPartialKitchenVisitButtons.xml"/>
        </column>
      </columns>
    </group>
    <group name="PatientGridGroup">
      <row>
        <control type="buttongroup" 
          name="ButtonGroupSelect" 
          edit="true" mode="auto" 
          source="Meals,Problems,Allergies" 
          sourcelabels="Comida,Diagnósticos,Alergias" 
          span="12" 
          default="Meals" 
          value="Meals"  
          provoke="ERGridList|options"/>
      </row>
      <row>
        <control name="ERGridList" affector="ButtonGroupSelect" type="options" span="12">
          <partial link="./Partial/Grids/PartialMealOrderComponents.xml"/>
          <partial link="./Partial/Grids/PartialDiagnosisHistoryForPatient.xml"/>
          <partial link="./Partial/Grids/PartialAllergiesNoEditAsAllergies.xml"/>
        </control>
       </row>
     </group>
   </section>
   <partial target="mdlReports" link="./Partial/Admin/PartialReportModals.xml"/>
   </module>