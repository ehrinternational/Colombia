<?xml version="1.0" encoding="utf-8"?>
<module name="Investigación Consulta" type="onload" trigger="GetLastDepartment">
  <facet name="FileName" value="OutpatientInvestigation"/>
  <facet name="InventoryLocationType" value="Nursing"/>
  <facet name="EditMode" value="Surgery"/>
  <facet name="ShowDataGrids" value="Medical"/>
  <facet name="DefaultPatientId"/>
  <facet name="DefaultOrderType"/>
  <facet name="DefaultOrderGuid"/>
  <!-- Import templates -->
  <partial link="Partials/ColombiaPartialTemplates.xml"/>
  <!-- Headerbutton displays report list -->
  <headerbutton name="btnReportsByType"
    icon="print" label="Informes"
    preset="Report_Type=Investigation"
    trigger="ReportList"
    action="redirect" target="mdlReports"/>
  <headerbutton name="btnConsultCalendar"
    icon="calendar" label="Consulta"
    preset="DefaultPatientId=,DefaultOrderGuid=,ConsultCalendarType=ConsultVisit"
    trigger="ConsultVisit_selAppointmentTypeGuid"
    action="redirect" target="mdlConsultVisitCalendarAppointments"/>
  <!-- Display list of patients by department -->
  <partial link="Partials/ColombiaPartialConsultInvestigationPatientList.xml"/>
  <!-- Patient tabmodal displays the patient chart -->
  <section type="tabmodal" badge="none" name="PatientTabModal" size="large" title="Información del Paciente" edit="false">
    <group name="GuidStorage">
      <row showif="never">
        <!-- Get patient information -->
        <control type="text" span="4" name="PatientId"
          datarequest="GetPatientAllFields"
          appendrequest="PatientId=[PatientId]"
          inject="PatientInfo"
          set="[[HasOpenVisit]]=true;PatientVisitGuid=[[PatientVisit]]"
          provoke="[[HasOpenVisit]]=true;PatientVisitGuid"/>
        <!-- Get visit information -->
        <control type="hidden" span="4" name="PatientVisitGuid"
          datarequest="GetPatientVisitByUniqueId"
          appendrequest="UniqueId=[PatientVisitGuid]"
          inject="VisitInfo"
          set="UnAcknowledgedOrders=[[UnAcknowledgedOrders]]"
          provoke="ERNursingOrders|active,ERNursingOrdersComplete|active,ERPatientLines|active"/>
        <!-- Insert new bed assignment -->
        <control type="text" span="4" name="InsertNewBedAssignment"
          datarequest="GetPatientVisitByUniqueId"
          appendrequest="UniqueId=[PatientVisitGuid]"
          set="mdlAdmit_OpenRoom=[[OpenRoom]]"/>
        <!-- Get unacknowledged orders -->
        <control type="hidden" name="GetUnAcknowledgedOrders"
          datarequest="GetPatientVisitByUniqueId"
          appendrequest="UniqueId=[PatientVisitGuid]"
          set="UnAcknowledgedOrders=[[UnAcknowledgedOrders]]"/>
        <!-- Close patient tab modal -->
        <control type="button" name="ClosePatientTabModal" action="close|new"/>
        <control type="hidden" name="UnAcknowledgedOrders"/>
      </row>
    </group>
    <!-- Patient information and nursing buttons -->
    <group name="PatientInfo">
      <columns>
        <column span="10">
          <partial link="Partials/ColombiaPartialPatientInfo.xml"/>
        </column>
        <column span="2">
          <partial link="Partials/ColombiaPartialOutpatientInvestigationPatientButtons.xml"/>
        </column>
      </columns>
    </group>
    <!-- Patient visit and nursing buttons -->
    <group name="VisitInfo">
      <columns>
        <column span="10">
          <partial link="Partials/ColombiaPartialHospitalVisitInfo.xml"/>
        </column>
        <column span="2">
          <partial link="Partials/ColombiaPartialConsultNurseVisitButtons.xml"/>
        </column>
      </columns>
    </group>
    <group name="PatientGridGroup">
      <!-- Patient datagrids -->
      <!-- demographic data grids -->
      <row name="rowDemographics" reveal="[ShowDataGrids]=Demographic">
        <control type="button" name="btnMedical" span="1"
            icon="medkit" label="" action="trigger" set="ShowDataGrids=Medical"
            provoke="ButtonGroupSelect"/>
        <control type="buttongroup" 
          name="ButtonGroupSelect2" 
          edit="true" mode="auto" span="11"
          source="Tasks,Identification,Addresses,Contacts,Appointments" 
          sourcelabels="Tareas,Identificación,Direcciones,Contactos,Citas" 
          default="Tasks"  
          provoke="GridOptions2,PatientTasks,Identification,PatientPhones,Addresses,Contacts,
            ScannedForms,Appointments"/>
      </row>
      <row name="rowDemographicDataGrids" reveal="[ShowDataGrids]=Demographic">
        <control type="options" name="GridOptions2" affector="ButtonGroupSelect2" span="12">
          <partial link="./Partial/Grids/PartialPatientTasksWithNewAndEdit.xml"/>
          <partial link="Partials/ColombiaPartialIdentificationGrid.xml"/>
          <partial link="Partials/ColombiaPartialPatientAddressesForColombia.xml"/>
          
          <partial link="Partials/ColombiaPartialPatientContactsColombia.xml"/>
          <partial link="Partials/ColombiaPartialAppointmentListOutpatientNurse.xml"/>
        </control>
      </row>
      <!-- Medical data grids -->
      <row name="rowMedical" reveal="[ShowDataGrids]=Medical">
        <control type="button" name="btnDempgraphics" span="1"
          icon="home" label="" action="trigger" set="ShowDataGrids=Demographic"
          provoke="ButtonGroupSelect2"/>
        <control type="buttongroup" name="ButtonGroupSelect" 
          edit="true" mode="auto" span="11" default="Nursing"
          source="Nursing,Problems,Vitals,Physicians,Studies,Medication,Surgery,Documents,Programs" 
          sourcelabels="Enfermería,Diagnósticos,Vitales,Médicos,Estudios,
          Medicamentos,Procedimientos,Documentos,Programas" 
          provoke="ERGridList|options"/>
      </row>
      <row name="rowMedicalDataGrids" reveal="[ShowDataGrids]=Medical">
          <control name="ERGridList" affector="ButtonGroupSelect" type="options" span="12">
          <partial link="./Partial/Grids/PartialNursingOrdersWithNewAndManage.xml"/>
          <partial link="./Partial/Grids/PartialNursingOrdersCompleted.xml"/>
          <partial link="./Partial/Grids/PartialDietaryOrdersWithAddAndEdit.xml"/>
          
          <partial link="./Partial/Grids/PartialInterdisciplinaryNotesForPatientWithAddNewNursingType.xml"/>
          <partial link="./Partial/Grids/PartialPatientLines.xml"/>
          <partial link="./Partial/Grids/PartialDiagnosisActiveForPatient.xml"/>
          <partial link="./Partial/Grids/PartialDiagnosisHistoryForPatient.xml"/>
          <partial link="./Partial/Grids/PartialAllergiesWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialVitalSignsWithNewAndGraph.xml"/>
          <partial link="./Partial/Grids/PartialFluidsWithTotalsAnd24Hour.xml"/>
          <partial link="./Partial/Grids/PartialBloodSugarVitalSignsWithNew.xml"/>
          <partial link="./Partial/Grids/PartialNeuroVitalSignsWithNew.xml"/>
          <partial link="./Partial/Grids/PartialPhysicianAssignmentsWithNewAndEdit.xml"/>
          <partial link="Partials/ColombiaPartialConsultRequestsForPatientNoHospitals.xml"/>
          <partial link="./Partial/Grids/PartialLabOrdersWithScannedResultsNewEditAndExternalLabs.xml"/>
          <partial link="./Partial/Grids/PartialLabOrderResults.xml"/>
          <partial link="./Partial/Grids/PartialPathologyOrdersByPatientNoEdit.xml"/>
          <partial link="Partials/ColombiaPartialImagingOrdersWithNewEditAndExternalLab.xml"/>
          <partial link="Partials/ColombiaPartialImagingReports.xml"/>
          <partial link="./Partial/Grids/PartialScannedImagingDocumentsInWindow.xml"/>
          <partial link="Partials/ColombiaPartialInpatientMedicationWithAdministration.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationsCompleted.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationActiveAdministrations.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationCompletedAdministrations.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationAdministrationsHistory.xml"/>
          <partial link="./Partial/Grids/PartialHomeMedicationNoEdit.xml"/>
          <partial link="./Partial/Grids/PartialOutpatientMedicationsNoEdit.xml"/>
          <partial link="./Partial/Grids/PartialProcedureOrdersWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialSurgeryListForPatient.xml"/>
          <partial link="./Partial/Grids/PartialBloodBankOrdersNoEdit.xml"/>
          <partial link="./Partial/Grids/PartialECDFormsWithNewAndEditWindowMode.xml"/>
          <partial link="Partials/ColombiaPartialScannedDocumentsWithNewAndCancelInWindow.xml"/>
          <partial link="./Partial/Grids/PartialAdverseMedicationEventsNoEdit.xml"/>
          <partial link="./Partial/Grids/PartialInternalConsultRequestsForPatient.xml"/>
          <partial link="./Partial/Grids/PartialPatientPrograms.xml"/>
        </control>
       </row>
     </group>
   </section>
   <!-- Colombia partials -->
    <partial target="NewConsultModal" link="Partials/ColombiaPartialInterconsultRequest.xml"/>
    <partial  link="Partials/ColombiaPartialPatientContactsModal.xml"/>
    <partial target="mdlMovePatient" link="Partials/ColombiaPartialMovePatients.xml"/>
    <partial target="mdlPathologyOrders" link="Partials/ColombiaPartialPathologyOrders.xml"/>
    <partial target="mdlMedicalDeviceWorkOrderRequest" link="Partials/ColombiaPartialBiomedicalWorkOrderRequest.xml"/>
    <partial target="mdlBuildingWorkOrderRequest" link="Partials/ColombiaPartialMaintenanceWorkOrderRequest.xml"/>
    <partial target="mdlTransferPatient" link="Partials/ColombiaPartialTransferPatientWithBedAssignment.xml"/>
    <partial target="mdlSurgeryViewModal" link="Partials/ColombiaPartialSurgeryTabModal.xml"/>
    <partial target="mdlMyBuildingWorkOrderRequests" link="Partials/ColombiaPartialMyBuildingWorkOrders.xml"/>
    <partial target="mdlMyBiomedicalWorkOrderRequests" link="Partials/ColombiaPartialMyBiomedicalWorkOrders.xml"/>
     <!-- Calendars -->
    <partial target="mdlConsultVisitCalendarAppointments" link="./Partial/Calendars/PartialCalendarConsultAppointmentsAsModal.xml"/>
    <partial target="mdlSurgeryViewAppointments" link="./Partial/Calendars/PartialCalendarSurgeryAppointmentsViewOnlyAsModal.xml"/>
    <partial target="mdlCalendarSearchModal" link="Partials/ColombiaPartialCalendarSearchModal.xml"/>
    <partial target="mdlMyTaskAppointments" link="./Partial/Calendars/PartialCalendarMySalesTasksAsModal.xml"/>
    <!-- Calendar Appointment modals -->
    <partial link="./Partial/Calendars/PartialCalendarConsultVisitAppointmentModal.xml"/>
    <partial target="mdlNewProjectTasks" link="./Partial/Messaging/PartialNewProjectTasks.xml"/>
    <!-- General modals -->
    <partial target="mdlCombinedECDForms" link="./Partial/Modals/PartialCombineECDFormsToPDF.xml"/>
    <partial target="mdlFindPatients" link="./Partial/Admin/PartialPatientSearchmodal.xml"/>
    <partial target="mdlInitiateFindPatients" link="./Partial/Admin/PartialInitiatePatientSearchModalAllPatients.xml"/>
    <partial target="mdlInternalConsultModal" link="./Partial/Requests/PartialInternalConsultRequest.xml"/>
    <partial target="mdlLabOrders" link="./Partial/Modals/PartialLabOrdersWithScanResultsModalNoEdit.xml"/>
    <partial target="mdlFluidTotals" link="./Partial/Grids/PartialFluidTotals.xml"/>
    <partial target="mdlReports" link="./Partial/Admin/PartialReportModals.xml"/>
    <partial target="mdlReadyForDischarge" link="./Partial/Admin/PartialReadyForDischarge.xml"/>
    <partial target="NewChargesModal" link="./Partial/Modals/PartialPatientChargesModal.xml"/>
    <partial link="./Partial/Grids/Partial24HourBalance.xml"/>
    <partial target="mdlReferringMd" link="./Partial/Modals/PartialReferringMds.xml"/>
    <partial link="./Partial/Modals/PartialProgramTracking.xml"/>
    <!-- Messaging -->
    <partial link="./Partial/Messaging/PartialSendWYSIWYGEmail.xml"/>
    <partial target="mdlSendTextMessage" link="./Partial/Messaging/PartialSendTextMessageToPatient.xml"/>
    <!-- Inventory Patient charge of stock items -->
    <partial target="mdlInventoryChargeToPatient" link="../../ERPSpanish/module/Partials/PartialESInventoryPatientCharges.xml"/>
    
    <partial target="mdlStockItemsByLocation" link="../../ERPSpanish/module/Partials/PartialESStockItemLocationModal.xml"/>
   </module>