<?xml version="1.0" encoding="utf-8"?>
<module name="Médico de Tratamiento" type="onload" trigger="GetLastDepartment">
  <facet name="FileName" value="TreatmentDoctor"/>
  <facet name="DefaultPatientId"/>
   <!-- Import templates -->
  <partial link="Partials/ColombiaPartialTemplates.xml"/>
  <headerbutton name="btnReportsByType"
    icon="print" label="Informes"
    preset="Report_Type=Physician"
    trigger="ReportList"
    action="redirect" 
    target="mdlReports"/>
  <headerbutton name="btnTreatmentCalendar"
    icon="calendar" label="Tratamiento"
    trigger="TreatmentAppointmentTimes"
    preset="DefaultPatientId=[PatientId],DefaultOrderGuid="
    action="redirect" target="mdlTreatmentAppointments"/>
  <!-- Display a list of radio oncology admitted patients-->
  <partial link="./Partial/Lists/PartialRadioOncologyPatientsByDepartment.xml"/>
  <!-- PatientTabModal is the patient chart -->
  <section type="tabmodal" badge="none" name="PatientTabModal" title="Información del Paciente" size="medium">
    <group showif="never">
      <row>
        <!-- Get patient information -->
        <control type="hidden" span="4" name="PatientId"
          datarequest="GetPatientAllFields"
          appendrequest="PatientId=[PatientId]"
          inject="PatientInfo"
          provoke="[HasOpenVisit]=true;SetPatientVisit"/>
        <control type="button" name="SetPatientVisit"
          action="trigger"
          set="PatientVisitGuid=[PatientVisit]"
          provoke="PatientVisitGuid"/>
        <!-- Get visit information -->
        <control type="hidden" span="4" name="PatientVisitGuid" 
          datarequest="GetPatientVisitByUniqueId"
          appendrequest="UniqueId=[PatientVisitGuid]"
          inject="VisitInfo"
          provoke="ButtonGroupSelect,(user.UserRoles)%Physician;SetHospitalService"/>
        <!-- Set the hospital service and update the provider list -->
        <control type="hidden" 
          name="SetHospitalService"
          datarequest="UpdatePatientVisitAndProviderList"
          appendrequest="patientId=[PatientId],departmentGuid=[DepartmentGuidLookup],patientVisitUniqueId=[PatientVisitGuid],hospitalService=Tratamiento,attendingDoctor=(userName),physicianRole=Consulting"/>
      </row>
      <row>
        <!-- Close patient tab modal -->
        <control type="button" name="ClosePatientTabModal" action="close|new"/>
      </row>
    </group>
    <!-- Patient information and physician buttons -->
    <group name="PatientInfo">
      <columns>
        <column span="10">
           <partial link="Partials/ColombiaPartialHospitalPatientInformation.xml"/>
        </column>
        <column span="2">
          <partial link="Partials/ColombiaPartialConsultPhysicianPatientButtons.xml"/>
        </column>
      </columns>
    </group>
    <!-- Patient visit and physician buttons -->
    <group name="VisitInfo" reveal="[PatientId]!+[PatientVisitGuid]!">
      <columns>
        <column span="10">
          <partial link="Partials/ColombiaPartialHospitalVisitInformation.xml"/>
        </column>
        <column span="2">
          <partial link="Partials/ColombiaPartialTreatmentPhysicianVisitButtons.xml"/>
        </column>
      </columns>
    </group>
    <!-- Patient datagrids -->
    <group name="PatientGridGroup" reveal="[PatientId]!">
      <row>
        <control type="buttongroup" 
          name="ButtonGroupSelect" 
          edit="true" 
          source="Problems,Vitals,Physicians,Nursing,Studies,Medication,Surgery,Documents,Protocols,Appointments,Quotes" 
          sourcelabels="Diagnósticos,Vitales,Médicos,Enfermeria,Estudios,Medicamentos,Cirugía,Documentos,Esquemas,Citas,Cotizaciones" 
          span="12" mode="auto"
          default="Problems" 
          value="Problems"  
          provoke="ERGridList,ERProblemList,ERPastProblemList,ERAllergyList,ERVitalSigns,ERFluids,24HourNetFluids,ERNeuroVitalSigns,ERBloodSugarVitalSigns,ERPhysicianAssignments,ERNursingOrders,ERNursingOrdersComplete,ConsultList,ERLabOrders,ERLabResults,ERMedications,ERMedicationsCompleted,ERMedicationAdminActive,ERMedicationAdminComplete,ERMedicationAdminHistory,ERMedicationHistory,ERRadiologyOrders,ERRadiologyReports,EREcdForms,PastMedications,ERHomeMedications,ERSurgeries,ERProcedures,ERPatientLines,ERChemoProtocols,Appointments,CTCAEList,ERPatientQuotes,ScannedForms,PathologyScannedForms,GenomicScannedForms,InternalConsultList"/>
      </row>
      <row>
        <control name="ERGridList" affector="ButtonGroupSelect" type="options" span="12">
          <partial link="./Partial/Grids/PartialDiagnosisActiveForPatient.xml"/>
          <partial link="./Partial/Grids/PartialDiagnosisHistoryForPatient.xml"/>
          <partial link="./Partial/Grids/PartialAllergiesWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialVitalSignsWithNewAndGraph.xml"/>
          <partial link="./Partial/Grids/PartialFluidsWithTotalsAnd24Hour.xml"/>
          <partial link="./Partial/Grids/PartialBloodSugarVitalSignsWithNew.xml"/>
          <partial link="./Partial/Grids/PartialNeuroVitalSignsWithNew.xml"/>
          <partial link="./Partial/Grids/PartialPhysicianAssignmentsWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialNursingOrdersWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialNursingOrdersCompleted.xml"/>
          <partial link="./Partial/Grids/PartialLabOrdersWithScannedResultsNewAndEditByPatientId.xml"/>
          <partial link="./Partial/Grids/PartialPathologyReportsNewAndCancel.xml"/>
          <partial link="./Partial/Grids/PartialGenomicReportsNewAndCancel.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationsWithTemplateNewAndAdminister.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationsCompleted.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationActiveAdministrations.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationCompletedAdministrations.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationAdministrationsHistory.xml"/>
          <partial link="./Partial/Grids/PartialHomeMedicationWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialImagingOrdersWithOsirixNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialProcedureOrdersWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialSurgeryListForPatient.xml"/>
          <partial link="./Partial/Grids/PartialECDFormsWithNewEditAndCancelOnlyByUserWindowMode.xml"/>
          <partial link="./Partial/Grids/PartialScannedDocumentsWithNewAndCancel.xml"/>
          <partial link="./Partial/Grids/PartialChemoProtocolsWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialAdverseMedicationEvents.xml"/>
          <partial link="./Partial/Grids/PartialAppointmentListForPatientNoEdit.xml"/>
          <partial link="./Partial/Grids/PartialInternalConsultRequestsForPatient.xml"/>
          <partial link="./Partial/Grids/PartialPatientQuotesPrintOnlyNoAmounts.xml"/>
        </control>
       </row>
     </group>
   </section>
  <!-- Global partials Requests-->
  <partial link="./Partial/Requests/PartialInternalConsultRequest.xml"/>
  <partial link="./Partial/Requests/PartialDocumentRequestNoSpecialty.xml"/>
  <!--  Global partials Modals-->
  <partial link="./Partial/Modals/PartialChemotherapyProtocolModal2.xml"/>
  <partial link="./Partial/Modals/PartialLabOrdersWithScanResultsModalNoEdit.xml"/>
  <partial link="./Partial/Modals/PartialReferringMds.xml"/>
  <!-- Global partials Admin -->
  <partial target="mdlCombinedECDForms" link="./Partial/Modals/PartialCombineECDFormsToPDF.xml"/>
  <partial link="./Partial/Admin/PartialPatientSearchModal.xml"/>
  <partial link="./Partial/Admin/PartialReadyForDischarge.xml"/>
  <partial link="./Partial/Beds/PartialClinicBedAssignment.xml"/>
  <partial link="./Partial/Grids/PartialFluidTotals.xml"/>
  <partial link="./Partial/Grids/Partial24HourBalance.xml"/>
  <partial link="./Partial/Admin/PartialReportModals.xml"/>
  <partial link="./Partial/Admin/PartialAssignAttendingPhysician.xml"/>
  <partial link="./Partial/Move/PartialTransferPatientWithBedAssignment.xml"/>
  <partial link="./Partial/Messaging/PartialSendTextMessageToPatient.xml"/>
	<partial link="./Partial/Messaging/PartialSendEmailMessageToPatient.xml"/>
  <!-- Global partials Calendars -->
  <partial link="./Partial/Calendars/PartialCalendarCancelCOIAppointments.xml"/>
  <partial link="./Partial/Calendars/PartialCalendarTreatmentAsModal.xml"/>
  <partial link="./Partial/Calendars/PartialCalendarTreatmentAppointmentModal.xml"/>
</module>