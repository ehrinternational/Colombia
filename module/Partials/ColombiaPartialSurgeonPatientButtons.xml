<partial>
  <row name="rowUpdateButton" reveal="[PatientId]!">
    <control type="button" 
      name="Consult_PatientUpdate"
      reveal="[Surgeon_HasOpenVisit]=true" 
      span="12" 
      label="Actualizar"
      affector="PatientId"
      setaffector="RecordUniqueId"
      capture="PatientInfo" 
      icon="cloud-upload"
      action="save"
      confirm="Por favor confirme que quiere actualizar a este paciente."
      dataupdate="UpdatePatient"
      appendupdate="PatientId=[PatientId]"
      provoke="[PatientId]!+[PatientVisitGuid]!;btnUpdatePatientVisit"/>
  </row>
  <row showif="never">
    <control type="button" name="btnUpdatePatientVisit"
      action="save|close|new"
      affector="PatientVisitGuid"
      setaffector="PatientVisitUniqueId"
      capture="VisitInfo"
      acctsvc="true"
      dataupdate="UpdatePatientVisitNoDepartmentTracking"
      appendupdate="patientVisitUniqueId=[PatientVisitGuid]"
      provoke="PatientList"/>
  </row>
  <row>
    <control type="button" name="btnReports"
      reveal="[PatientId]!"
      span="12"
      icon="print" label="Informes"
      preset="Report_PatientId=[PatientId],Report_Type=Patient,Report_PatientFirstName=[Consult_PatientFirstName],Report_PatientMiddleName=[Consult_PatientMiddleName],Report_PatientLastName=[Consult_PatientLastName]"
      trigger="ReportList,Report_VisitId"
      action="redirect" target="mdlReports"/>
  </row>
  <row>
      <!-- Display the first surgery with a Scheduled status -->
      <control type="button" name="btnShowCurrentSurgery"
        span="12" icon="search" label="Cirugía"
        reveal="[PatientVisitGuid]!+[PatientId]!"
        compare="FindSurgeryGuid!|No se encontró cirugía en proceso para este paciente."
        preset="SurgeryViewGuid=[FindSurgeryGuid]"
        trigger="SurgeryViewGuid"
        action="redirect"
        target="mdlSurgeryViewModal"/>
    </row>
    <row>
      <!-- Display the patient timeline -->
      <control type="button" name="btnTimeline"
        reveal="[PatientId]!+[PatientVisitGuid]!"
        span="12"
        color="yellow" icon="time" 
        label="Cronograma"
        action="redirect|view"
        target="timeline"
        append="patientid=[PatientId],patientvisit=[PatientVisitGuid],distinct=true"/>
    </row>
    <row>
      <control type="button" name="btnAddSurgeonNotes" span="12"
        reveal="[PatientId]!+[PatientVisitGuid]!"
        color="yellowgreen"
        action="redirect|view"
        target="patient-notes"
        append="patientid=[PatientId],patientvisit=[PatientVisitGuid],notetype=Physician"
        label="Notas"
        icon="user-md"/>
    </row>
    <row name="rowReadyForDischargeButtons" reveal="[Surgeon_HasOpenVisit]=true">
      <control type="button" name="btnAltaMedica"
        reveal="[ReadyForDischarge]=true+[PatientVisitGuid]!"
        span="12" icon="home" label="Alta Médica"
        color="green" action="redirect"
        trigger="GetReadyForDischarge"
        preset="Ready_PatientId=[PatientId],Ready_PatientVisitGuid=[PatientVisitGuid]"
        target="mdlReadyForDischarge"/>
      <control type="button" name="btnNoAltaMedica"
        reveal="[ReadyForDischarge]=false+[PatientVisitGuid]!"
        span="12" icon="home" label="Alta Médica"
        color="grey" action="redirect"
        trigger="GetReadyForDischarge"
        preset="Ready_PatientId=[PatientId],Ready_PatientVisitGuid=[PatientVisitGuid]"
        target="mdlReadyForDischarge"/>
    </row>
    <row>
        <control type="button" name="btnNewSurgeryRequest" span="12" label="Solicitud Cirugía"
          reveal="[PatientId]!+[FileName]=SurgeryDoctor"
          action="redirect"
          target="NewSurgeryRequestModal"
          preset="SurgeryRequest_PatientId=[PatientId]"
          trigger="SurgeryRequest_PatientId"/>
    </row>
    <row>
      <control type="button" name="btnEmailPatient" reveal="[PatientId]!"
        span="12" icon="envelope" label="Email"
        preset="bmd_PatientId=[PatientId],
        bmd_PatientFirstName=[Consult_PatientFirstName],
        bmd_PatientMiddleName=[Consult_PatientMiddleName],
        bmd_PatientLastName=[Consult_PatientLastName],
        bmd_EmailAddress=[Consult_PatientEmail]"
        trigger="grdEmailAndText,bmd_PatientAttachmentGuids"   
        action="redirect" target="mdlSendWYSIWYGEmail"/>
    </row>
    <row>
      <control type="button" name="btnInitiateTextMessage" 
        reveal="[PatientId]!"
        span="12" icon="envelope" label="Enviar Texto"
        trigger="grdPhysicianMessages2"
        preset="Send_PhoneNumber=[Consult_PatientCellPhone],Send_PatientId=[PatientId]"
        action="redirect" target="mdlSendTextMessage"/>
    </row>
    <row>
      <control type="button" name="btnInitiateSurgeryECDs" 
        reveal="[PatientId]!"
        span="12" icon="edit" label="Documentos Cirugía"
        trigger="SurgeriesForECDs"
        action="redirect" target="mdlSurgeryECDs"/>
    </row>
    <!-- AI buttons -->
    <partial link="Partials/ColombiaPartialCLARAButtons.xml"/>
</partial>