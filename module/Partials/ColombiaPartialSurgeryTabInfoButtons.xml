<partial>

   <!-- Update a surgery -->
  <row>
    <control type="button" name="btnViewUpdateSurgery" span="12" label="Actualizar"
      reveal="[SurgeryViewGuid]!+[Surgery_Status}=Requested|Scheduled|In Process"
      action="save"
      affector="none"
      capture="SurgeryInfo" 
      icon="cloud-upload"
      confirm="Por favor confirme que quiere actualizar esta cirugía."
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryViewGuid]"
      provoke="SurgeryTimes"/>
  </row>
  <!-- Confirm surgery that has a patient assigned -->
  <row>
    <control type="button" name="btnViewConfirmSurgery" span="12" color="green" label="Confirmar"
      reveal="[SurgeryViewGuid]!+[Surgery_Status]=Scheduled|Requested"
      affector="SurgeryGuid"
      setaffector="SurgeryGuid"
      capture="SurgeryInfo" 
      icon="cloud-upload"
      action="save"
      confirm="Por favor confirme que quiere confirmar esta cirugía."
      preset="NewStatus=Confirmed"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid]"
      provoke="btnViewNewStatus"/>
  </row>
  <!-- Set surgery to In Process and insert the patient visit into the surgery.-->
  <row>
    <control type="button" name="btnViewSurgeryInProcess" span="12" color="purple" label="En Proceso" icon="cloud-upload"
      reveal="[SurgeryViewGuid]!+[Surgery_Status]=Scheduled|Confirmed|Requested"   
      affector="none" 
      action="save"
      confirm="Por favor confirme que quiere proceso esta cirugía."
      preset="NewStatus=In Process"
      compare="[Surgery_HasOpenVisit]=true|Este paciente no tiene una visita abierta. Admita al paciente que continúe."
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryViewGuid],patientVisit=[Surgery_PatientVisit]"
      provoke="btnViewNewStatus"/>
  </row>
  <!-- Set the surgery to completed status and update the patient information-->
  <row>
    <control type="button" name="btnViewCompleteSurgery" span="12" color="yellowgreen" label="Completar" icon="cloud-upload"
      reveal="[SurgeryViewGuid]!+[Surgery_Status]=In Process"   
      affector="none"
      capture="SurgeryInfo" 
      action="save"
      confirm="Por favor confirme que quiere completar esta cirugía."
      preset="NewStatus=Completed"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryViewGuid],DateTimeCompleted=(now)"
      provoke="[Surgery_WaitListGuid]!;btnUpdateSurgeryWaitList,btnNewStatus"/>
  </row>
  <row>
    <control type="button" name="btnViewCancelSurgery" span="12" color="red" label="Cancelar" icon="cloud-upload"
      reveal="[SurgeryViewGuid]!+[Surgery_Status]=Scheduled|Confirmed|Requested"   
      affector="none"
      capture="SurgeryInfo" 
      action="save"
      confirm="Por favor confirme que quiere cancelar esta cirugía."
      preset="NewStatus=Canceled"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid]"
      provoke="btnViewNewStatus"/>
  </row>
  <!-- Update and apply new status -->
  <row showif="never">
    <!-- When a surgery has an attached ConsultRequest, change the ConsultRequestStatus to completed -->
    <control type="button" name="btnViewUpdateSurgeryWaitList"
      action="save"
      affector="none"
      acctsvc="true"
      dataupdate="UpdateConsultRequests"
      appendupdate="ConsultRequestGuid=[Surgery_WaitListGuid],ConsultRequestStatus=Completed"/>
    <control type="button" name="btnViewNewStatus"
      action="save|close|new"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid],Status=[NewStatus]"
      provoke="SurgeryTimes"/>
  </row>
  <row >
    <control type="button" name="btnEducationECD" color="green" action="trigger"
      reveal="[SurgeryViewGuid]!+[FileName]=SurgeryDoctor+[Surgery_Status]=Scheduled|Cpnfirmed|In Process"
      span="12" icon="edit" label="Educación del Paciente"/>
  </row>
  <row >
    <control type="button" name="btnNutritionECD" color="green" action="trigger"
      reveal="[SurgeryViewGuid]!+[FileName]=SurgeryDoctor+[Surgery_Status]=Scheduled|Cpnfirmed|In Process"
      span="12" icon="edit" label="Cribado Nutricional"/>
  </row>
  <row>
    <control type="button" name="btnMentalECD" color="green" action="trigger"
      reveal="[SurgeryViewGuid]!+[FileName]=SurgeryDoctor+[Surgery_Status]=Scheduled|Cpnfirmed|In Process"
      span="12" icon="edit" label="Salud Mental"/>
  </row>
  <row>
    <control type="button" name="btnPreopECD" color="green" action="trigger"
      reveal="[SurgeryViewGuid]!+[FileName]=SurgeryDoctor+[Surgery_Status]=Scheduled|Cpnfirmed|In Process"
      span="12" icon="edit" label="Nota Preoperatoria"/>
  </row>
  <row>
    <control type="button" name="btnPostopECD" color="green" action="trigger"
      reveal="[SurgeryViewGuid]!+[FileName]=SurgeryDoctor+[Surgery_Status]=Scheduled|Cpnfirmed|In Process"
      span="12" icon="edit" label="Nota Postoperatoria"/>
  </row>
  <row >
    <control type="button" name="btnViewBloodBankOrders"
      reveal="[SurgeryViewGuid]!+[FileName]=SurgeryDoctor+[Surgery_Status]=Scheduled|Cpnfirmed|In Process"
      span="12" icon="edit" label="Ordenes de Sangre"
      action="redirect" target="tbmSurgeryBloodBankOrders"/>
  </row>
  <row>
    <control type="button" name="btnViewSurgeryTeam"
      reveal="[SurgeryViewGuid]!+[Surgery_Status]=Scheduled|Cpnfirmed"
      span="12" icon="edit" label="Personal"
      action="redirect" target="tbmSurgeryTeam"/>
  </row>
  <row >
    <control type="button" name="btnViewSurgeryStockRequests"
      reveal="[SurgeryViewGuid]!+[Surgery_Status]=Scheduled|Cpnfirmed"
      span="12" icon="edit" label="Requisiciones Quirúrgico"
      action="redirect" target="tbmSurgeryStockRequests"/>
  </row>
  <row >
    <control type="button" name="btnViewSurgeryPurchaseRequests"
      reveal="[SurgeryViewGuid]!+[Surgery_Status]=Scheduled|Cpnfirmed"
      span="12" icon="edit" label="Compras Quirúrgico"
      action="redirect" target="tbmSurgeryPurchaseRequests"/>
  </row>
  <row >
    <control type="button" name="btnViewSurgeryPurchaseDocuments"
      reveal="[SurgeryViewGuid]!+[Surgery_Status]=Scheduled|Cpnfirmed"
      span="12" icon="edit" label="Documentos"
      action="redirect" target="tbmSurgeryDocuments"/>
  </row>
</partial>