<partial>
<control type="datagrid" label="Órdenes de Laboratorio" name="ERLabOrders"
  option="Studies"
  span="12"
  rows="5"
  action="redirect"
  target="mdlLabOrders"
  idle="[PatientVisitGuid]=|reset"
  datarequest="GetPatientLabTestOrdersByPatientVisit"
  appendrequest="patientVisit=[PatientVisitGuid]"
  source="DateTimeOrdered,DateTimeScheduled,OrderNumber,CPTDescription,OrderInstructions,Status,OrderedByFullName"
  sourcelabels="Fecha y Hora,Fecha Programada,Orden,Pruebas de Laboratorio,Instrucciones,Estatus,Ordenado por"
  align="left|left|left|left|left|left|left|left"
  translate="Status"
  format="datetime|datetime"
  sort="DateTimeOrdered=desc"
  key="OrderGuid"
  onselectset="LabOrderGuid=[[OrderGuid]]"
  onselect="LabOrderGuid">
  <control type="button" name="btnSetStatusToCompleted" label="Completar" showif="feature"
    reveal="[[Status]]=Active"
    action="save"
    dataupdate="UpdatePatientLabTestOrderSetStatus"
    appendupdate="OrderGuid=[[OrderGuid]],Status=Completed"
    provoke="ERLabOrders"/>
 <control type="button" name="PrintSingleCopyLabOrders" 
    reveal="[PatientVisitGuid]!+(facilityData.HospitalName)%Shriners"
    action="print"
    mode="report" 
    label="Receta Única" 
    icon="print"
    confirm="Recordatorio: Solo se imprimirán los órdenes para la visita actual."
    append="id=d8a49da8644,UserId=(userName),UserName=(userName),CurrentDateTime=(dateTimeNow),FacilityId=(facilityData.HospitalGuid),PatientId=[PatientId],PatientVisitId=[PatientVisitGuid]"/>
  <control type="button" name="PrintLabOrdersTwoCopies" 
    reveal="[PatientVisitGuid]!"
    action="print"
    mode="report" 
    label="Receta Múltiple" 
    icon="print"
    confirm="Recordatorio: Solo se imprimirán los órdenes para la visita actual."
    append="id=3989ea7c458,UserId=(userName),UserName=(userName),CurrentDateTime=(dateTimeNow),FacilityId=(facilityData.HospitalGuid),PatientId=[PatientId],PatientVisitId=[PatientVisitGuid]"/>
  <control type="button" 
    name="PrintLabOrder" 
    action="print" 
    showif="feature" 
    mode="report" 
    label="Receta Sola" 
    icon="print"                 
    append="id=098dc6bcfd8,UserName=(userName),CurrentDateTime=(dateTimeNow),FacilityId=(facilityData.HospitalGuid),PatientId=[PatientId],OrderGuid=[[OrderGuid]]" />
<!-- Update lab orders -->
  <control type="button" 
    name="btnUpdateLabs"
    reveal="[HasOpenVisit]=true"
    showif="feature"
    icon="edit"
    label="Editar"
    action="redirect|view"
    target="labs-update"
    append="size=small,recordGuid=[[OrderGuid]],patientid=[PatientId],patientvisit=[PatientVisitGuid],distinct=true"
    provoke="ERLabOrders"/>
  <!-- New lab orders -->
  <control type="button" 
    name="btnLabOrders"
    reveal="[HasOpenVisit]=true"
    icon="plus"
    label="Añadir Nuevo"
    action="redirect|view"
    target="labs-order"
    append="size=small,patientid=[PatientId],patientvisit=[PatientVisitGuid],distinct=true,(facilityData.HospitalName)%Laureate;orderedByType=VORB"
    provoke="ERLabOrders"/>
  </control>
</partial>