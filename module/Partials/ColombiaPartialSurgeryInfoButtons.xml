<partial>
  <row name="rowDetailSearchButton" reveal="[PatientId]=">
    <control type="button" name="btnDetailSearchPatients" span="12"
      label="Buscar Paciente" icon="search"
      preset="PatientSearched=true,PatientSearchSource=62"
      trigger="Search_FindPatient"
      action="redirect" target="mdlFindPatients"/>
  </row>
  <row showif="never">
     <!-- Get the returned patientid and insert the patient -->
    <control type="button" name="SurgeryScheduleSearch" action="trigger"
        preset="PatientId=[PatientSearchResults],
        Surgery_PatientId=[PatientSearchResults]"
        provoke="PatientId"/>
    <control type="button" name="btnAssignPatientId"
      affector="none"
      action="save"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid],patientId=[PatientId]"
      provoke="btnAssignPatientToPOs,SurgeryTimes"/>
    <!-- Insert the patient into any purchase orders for this surgery -->
    <control type="button" name="btnAssignPatientToPOs"
      action="save" acctsvc="true"
      affector="none"
      dataupdate="AssignPatientToPurchaseOrders"
      appendupdate="surgeryGuid=[SurgeryGuid],patientId=[PatientId]"/>
  </row>
  <!-- Save a new surgery -->
  <row name="rowSaveNewSurgery" reveal="[SurgeryGuid]=">
    <control type="button" name="btnSaveNewSurgery" label="Nueva Cirugía"
      span="12"
      affector="SurgeryGuid"
      setaffector="SurgeryGuid"
      capture="SurgeryInfo" 
      compare="Surgery_PatientId!|Por favor seleccione un paciente"
      icon="cloud-upload"
      action="save"
      confirm="Por favor confirme que quiere generar esta Nueva Cirugía."
      datainsert="InsertScheduledSurgeries"
      provoke="SurgeryGuid"
      />
  </row>
  <!-- Update a surgery -->
  <row name="rowUpdateSurgery" reveal="[SurgeryGuid]!">
    <control type="button" name="btnUpdateSurgery"
      action="save|close|new"
      span="12"
      label="Actualizar"
      affector="none"
      capture="SurgeryInfo" 
      icon="cloud-upload"
      confirm="Por favor confirme que quiere actualizar esta cirugía."
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid]"
      provoke="SurgeryTimes"/>
  </row>
  <row showif="never">
    <control type="calc" name="Prc_CalcOrdinal" source="Length(dgrSurgeryProcedures)+1"/>
  </row>
  <row name="rowSurgeryProcedures" reveal="[SurgeryGuid]!+[PrimaryProcedure]!">
    <control type="button" name="btnSurgeryProcedures" span="12" label="Procedimientos" icon="edit"
      preset="[Prc_CalcOrdinal]=1;[Prc_IsPrimary]=True^False"
      action="redirect" target="mdlSurgeryProcedures"/>
  </row>
  <row name="rowSurgeryBundle" reveal="[SurgeryGuid]!">
    <control type="button" name="btnSurgeryBundle" span="12" label="Paquete" icon="dollar" 
      action="redirect" target="mdlSurgeryBundle"/>
  </row>
  <row name="rowScheduleOrder" reveal="[SurgeryGuid]!+[Surgery_CalendarGuid]=">
    <control type="button" name="btnScheduleOrder" span="12" label="Agendar Solicitud" 
      icon="calendar" color="green"
      action="redirect" target="mdlSurgeryOrderAppointments"/>
  </row>
  <!-- Confirm surgery that has a patient assigned -->
  <row name="rowConfirmSurgery" reveal="[SurgeryGuid]!+[PatientId]!+[Surgery_CalendarGuid]!">
    <control type="button" name="btnConfirmSurgery" span="12" color="green" label="Confirmar"
      reveal="[Surgery_Status]=Scheduled|Requested"
      affector="SurgeryGuid"
      setaffector="SurgeryGuid"
      capture="SurgeryInfo" 
      icon="cloud-upload"
      action="save"
      confirm="Por favor confirme que quiere confirmar esta cirugía."
      preset="NewSurgeryStatus=Confirmed"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid]"
      provoke="btnNewSurgeryStatus"/>
  </row>
  <!-- Set surgery to In Process and insert the patient visit into the surgery.-->
  <!--?? compare="[Spi_HasOpenVisit]=true|Este paciente no tiene una visita abierta. Admita al paciente para continuar."-->
  <row name="rowSurgeryInProcess" reveal="[SurgeryGuid]!+[PatientId]!+[Surgery_CalendarGuid]!">
    <control type="button" name="btnSurgeryInProcess" span="12" color="purple" label="En Proceso" icon="cloud-upload"
      reveal="[Surgery_Status]=Scheduled|Confirmed|Requested"   
      affector="none" 
      action="save"
      confirm="Por favor confirme que quiere proceso esta cirugía."
      compare="[Spi_HasOpenVisit]!false|Este paciente no tiene una visita abierta. Admita al paciente para continuar."
      preset="NewSurgeryStatus=In Process"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid]"
      provoke="btnNewSurgeryStatus"/>
  </row>
  <!-- Set the surgery to completed status and update the patient information-->
  <row name="rowCompleteSurgery" reveal="[SurgeryGuid]!+[PatientId]!+[Surgery_CalendarGuid]!">
    <control type="button" name="btnCompleteSurgery" span="12" color="yellowgreen" label="Completar" icon="cloud-upload"
      reveal="[Surgery_Status]=Scheduled|Confirmed|Requested|In Process"   
      affector="none"
      capture="SurgeryInfo" 
      action="save"
      confirm="Por favor confirme que quiere completar esta cirugía."
      preset="NewSurgeryStatus=Completed"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid],DateTimeCompleted=(now)"
      provoke="btnNewSurgeryStatus"/>
  </row>
  <!-- Cancel the surgery -->
  <row name="rowCancelSurgery" reveal="[SurgeryGuid]!+[Surgery_CalendarGuid]!">
    <control type="button" name="btnCancelSurgery" span="12" color="red" label="Cancelar" icon="cloud-upload"
      reveal="[Surgery_Status]=Scheduled|Confirmed|Requested|In Process"   
      affector="none"
      capture="SurgeryInfo" 
      action="save"
      confirm="Por favor confirme que quiere cancelar esta cirugía."
      preset="NewSurgeryStatus=Canceled"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid]"
      provoke="btnNewSurgeryStatus"/>
  </row>
  <!-- Update apply new status -->
  <row showif="never">
     <control type="hidden" name="NewSurgeryStatus" persist="true"/>
    <control type="button" name="btnNewSurgeryStatus"
      action="save|close|new"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid],Status=[NewSurgeryStatus],
        [NewSurgeryStatus]=Completed|In Process;PatientVisit=[Spi_PatientVisit]"
      provoke="SurgeryTimes,dgrSurgeryAdminList"/>
  </row>
  <row> <!-- Validated -->
    <control type="button" name="btnViewSurgeryTeam"
      reveal="[SurgeryGuid]!+[Surgery_Status]=Scheduled|Confirmed|In Process|Completed+[Surgery_CalendarGuid]!"
      span="12" label="Personal"
      trigger="dgrSurgeryTeam"
      action="redirect" target="mdlSurgeryTeamModal"/>
  </row>
  <row> <!-- Validated -->
    <control type="button" name="btnViewSurgeryEquipment"
      reveal="[SurgeryGuid]!+[Surgery_Status]=Scheduled|Confirmed|In Process|Completed+[Surgery_CalendarGuid]!"
      span="12"  label="Equipo"
      trigger="dgrScheduledEquipment"
      action="redirect" target="mdlScheduledSurgeryEquipment"/>
  </row>
  <row> <!-- Validated -->
    <control type="button" name="btnViewSurgeryCharges"
      reveal="[SurgeryGuid]!+[Surgery_Status]=Scheduled|Confirmed|In Process|Completed+[Surgery_CalendarGuid]!"
      span="12"  label="Cargos"
      trigger="dgrSurgeryCharges"
      action="redirect" target="mdlSurgeryChargesList"/>
  </row>
  <row >
    <control type="button" name="btnViewSurgeryStockRequests"
      reveal="[SurgeryGuid]!+[Surgery_Status]=Scheduled|Confirmed|In Process|Completed+[Surgery_CalendarGuid]!"
      span="12"  label="Stock"
      trigger="dgrSurgeryStockRequests"
      action="redirect" target="mdlSurgeryStockRequestList"/>
  </row>
  <!--
  <row >
    <control type="button" name="btnViewSurgeryPurchaseRequests"
      reveal="[SurgeryGuid]!+[Surgery_Status]=Scheduled|Confirmed|In Process|Completed+[Surgery_CalendarGuid]!"
      span="12"  label="Compras"
      trigger=""
      action="redirect" target="tbmSurgeryPurchaseRequests"/>
  </row>-->
  <row> <!-- Validated -->
    <control type="button" name="btnViewSurgerySupplies"
      reveal="[SurgeryGuid]!+[Surgery_Status]=Scheduled|Confirmed|In Process|Completed+[Surgery_CalendarGuid]!"
      span="12"  label="Suministros"
      trigger="dgrSurgerySupplies" 
      action="redirect" target="mdlSurgerySuppliesList"/>
  </row>
  <row> <!-- Validated -->
    <control type="button" name="btnViewSurgeryKits"
      reveal="[SurgeryGuid]!+[Surgery_Status]=Scheduled|Confirmed|In Process|Completed+[Surgery_CalendarGuid]!"
      span="12"  label="Kits"
      trigger="dgrScheduledSurgeryKits"
      action="redirect" target="mdlScheduledSurgeryKits"/>
  </row>
</partial>