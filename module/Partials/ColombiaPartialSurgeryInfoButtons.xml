<partial>
  <row name="rowDetailSearchButton" reveal="[PatientId]=">
    <control type="button" name="btnDetailSearchPatients" span="12"
      label="Buscar Paciente" icon="search"
      preset="PatientSearched=true,PatientSearchSource=16,Search_PatientFirstName=[Surgery_PatientFirstName],Search_PatientMiddleName=[Surgery_PatientMiddleName],Search_PatientLastName=[Surgery_PatientLastName]"
      trigger="Search_FindPatient"
      action="redirect" target="mdlFindPatients"/>
    <!-- Get the returned patientid and insert the patient -->
    <control type="hidden" name="SurgerySearchReturn"
      set="PatientId=[PatientSearchResults],
        Surgery_PatientId=[PatientSearchResults]"
      provoke="PatientId,[SurgeryGuid]!;btnAssignPatientId"/>
  </row>
  <row name="rowPatientPayers" reveal="[PatientId]!">
    <control type="button" name="btnPatientPayers" icon="search"
      span="12" label="Beneficios" action="redirect" target="mdlPayerList"
      trigger="PatientPayers"/>
  </row>
  <row showif="never">
    <control type="button" 
      name="btnAssignPatientId"
      affector="none"
      action="save"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid],patientId=[PatientId]"
      set="Surgery_PatientId=[PatientId]"
      provoke="btnAssignPatientToPOs,SurgeryTimes"
      emit="trigger|SurgeryTimes"/>
    <!-- Insert the patient into any purchase orders for this surgery -->
    <control type="button" name="btnAssignPatientToPOs"
      action="save" acctsvc="true"
      affector="none"
      dataupdate="AssignPatientToPurchaseOrders"
      appendupdate="surgeryGuid=[SurgeryGuid],patientId=[PatientId]"/>
  </row>
  <!-- Save a new surgery -->
  <row name="rowSaveNewSurgery" reveal="[SurgeryGuid]=+[EditMode]=Surgery|Labor">
    <control type="button" name="btnSaveNewSurgery" label="Nueva Cirugía"
      span="12"
      affector="SurgeryGuid"
      setaffector="SurgeryGuid"
      capture="SurgeryInfo" 
      compare="Surgery_PatientId!|Por favor seleccione un paciente"
      icon="cloud-upload"
      action="save"
      confirm="Por favor confirme que quiere generar esta Nueva Cirugía."
      datainsert="InsertScheduledSurgeries"
      provoke="SurgeryGuid,SurgeryTimes,[DefaultSurgeryRequestGuid]!;btnUpdateDefaultSurgeryRequest"
      emit="trigger|SurgeryTimes"/>
  </row>
  <row showif="never">
    <!-- Set the status on the surgery request to scheduled and clear the default request-->
    <control type="button" name="btnUpdateDefaultSurgeryRequest"
      action="save"
      affector="none"
      acctsvc="true"
      dataupdate="UpdateConsultRequests"
      appendupdate="ConsultRequestGuid=[DefaultSurgeryRequestGuid],ConsultRequestStatus=Scheduled"
      set="DefaultSurgeryRequestGuid=,SurgeryRequest_ConsultRequestStatus=Scheduled"/>
  </row>
  <!-- Update a surgery -->
  <row name="rowUpdateSurgery" reveal="[SurgeryGuid]!+[EditMode]=Surgery|Labor">
    <control type="button" name="btnUpdateSurgery"
      action="save"
      span="12"
      label="Actualizar"
      affector="none"
      capture="SurgeryInfo" 
      icon="cloud-upload"
      confirm="Por favor confirme que quiere actualizar esta cirugía."
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid]"
      provoke="[PatientId]!;btnPatientAdmitUpdate^btnCloseSurgeryTabModal,[EditMode]=Surgery;SurgeryTimes"
      emit="trigger|SurgeryTimes"/>
  </row>
  <!-- Update patient information -->
  <row showif="never">
    <control type="button" 
      name="btnPatientAdmitUpdate"
      affector="PatientId"
      setaffector="RecordUniqueId"
      capture="SurgSchPatientInfo" 
      action="save|close|new"
      dataupdate="UpdatePatient"
      appendupdate="PatientId=[PatientId]"/>
  </row>
  <!-- Save a template to a surgery -->
  <row name="rowSaveNewSurgeryFromTemplate" 
    reveal="[SurgeryGuid]=+[EditMode]=Surgery+[DefaultSurgeryRequestGuid]=">
    <control type="button"  
      name="btnSaveNewSurgeryFromTemplate"
      span="12" preset="DefaultRoom=[Surgery_RoomGuid]"
      trigger="mdlSurgeryTemplateList"
      label="De la plantilla"
      action="redirect" target="mdlSelectTemplate"/>
  </row>
  <!-- Save a template to a surgery -->
  <row name="rowSaveNewLaborFromTemplate" reveal="[SurgeryGuid]=+[EditMode]=Labor">
    <control type="button"  name="btnSaveNewLaborFromTemplate" span="12" preset="DefaultRoom=[Labor_RoomGuid]"
      trigger="mdlSurgeryTemplateList"
      label="De la plantilla" icon="search"
      action="redirect" target="mdlSelectTemplate"/>
  </row>
  <!-- Save a new surgery template -->
  <row name="rowSaveNewTemplate" reveal="[SurgeryGuid]=+[EditMode]=Template">
    <control type="button" name="btnSaveNewSurgeryTemplate" span="12" label="Plantilla Nueva"
      affector="SurgeryGuid"
      setaffector="SurgeryGuid"
      capture="SurgeryInfo" 
      icon="cloud-upload"
      action="save"
      confirm="Por favor confirme que quiere generar esta plantilla Nueva."
      datainsert="InsertScheduledSurgeries"
      provoke="SurgeryGuid,SurgeryTemplateList"
      emit="trigger|SurgeryTemplateList"/>
  </row>
  <!-- Update an existing surgery template -->
  <row name="rowUpdateTemplate" reveal="[SurgeryGuid]!+[EditMode]=Template">
    <control type="button" name="btnUpdateTemplate" span="12" label="Actualizar Plantilla" icon="cloud-upload"
      affector="none"
      capture="SurgeryInfo" 
      action="save|close|new"
      confirm="Por favor confirme que quiere actualizar esta plantilla."
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid]"
      provoke="SurgeryTemplateList"
      emit="trigger|SurgeryTemplateList"/>
  </row>
  <!-- Remove an existing surgery template -->
  <row name="rowCancelTemplate" reveal="[SurgeryGuid]!+[EditMode]=Template">
    <control type="button" name="btnCancelTemplate" span="12" label="Cancelar Plantilla" icon="remove"
      affector="none"
      action="save|close|new"
      confirm="Por favor confirme que quiere cancelar esta plantilla."
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid],Status=Removed"
      provoke="SurgeryTemplateList"
      emit="trigger|SurgeryTemplateList"/>
  </row>
  <!-- Confirm surgery that has a patient assigned -->
  <row name="rowConfirmSurgery" reveal="[SurgeryGuid]!+[PatientId]!+[EditMode]=Surgery|Labor">
    <control type="button" name="btnConfirmSurgery" span="12" color="green" label="Confirmar"
      reveal="[Surgery_Status]=Scheduled|Requested"
      affector="SurgeryGuid"
      setaffector="SurgeryGuid"
      capture="SurgeryInfo" 
      icon="cloud-upload"
      action="save"
      confirm="Por favor confirme que quiere confirmar esta cirugía."
      preset="NewStatus=Confirmed"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid]"
      provoke="btnNewStatus"/>
  </row>
  <!-- Set surgery to In Process and insert the patient visit into the surgery.-->
  <row name="rowSurgeryInProcess" reveal="[SurgeryGuid]!+[PatientId]!+[EditMode]=Surgery|Labor">
    <control type="button" name="btnSurgeryInProcess" span="12" color="purple" label="En Proceso" icon="cloud-upload"
      reveal="[Surgery_Status]=Scheduled|Confirmed|Requested"   
      affector="none" 
      action="save"
      confirm="Por favor confirme que quiere proceso esta cirugía."
      preset="NewStatus=In Process"
      compare="[Surgery_HasOpenVisit]=true|Este paciente no tiene una visita abierta. Admita al paciente que continúe."
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid],patientVisit=[Surgery_PatientVisit]"
      provoke="btnNewStatus"/>
  </row>
  <!-- Set the surgery to completed status and update the patient information-->
  <row name="rowCompleteSurgery" reveal="[SurgeryGuid]!+[PatientId]!+[EditMode]=Surgery|Labor">
    <control type="button" name="btnCompleteSurgery" span="12" color="yellowgreen" label="Completar" icon="cloud-upload"
      reveal="[Surgery_Status]=Scheduled|Confirmed|Requested|In Process"   
      affector="none"
      capture="SurgeryInfo" 
      action="save"
      confirm="Por favor confirme que quiere completar esta cirugía."
      preset="NewStatus=Completed"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid],DateTimeCompleted=(now)"
      provoke="[Surgery_WaitListGuid]!;btnUpdateSurgeryWaitList,btnNewStatus"/>
  </row>
  <!-- Cancel the surgery -->
  <row name="rowCancelSurgery" reveal="[SurgeryGuid]!+[EditMode]=Surgery|Labor">
    <control type="button" name="btnCancelSurgery" span="12" color="red" label="Cancelar" icon="cloud-upload"
      reveal="[Surgery_Status]=Scheduled|Confirmed|Requested|In Process"   
      affector="none"
      capture="SurgeryInfo" 
      action="save"
      confirm="Por favor confirme que quiere cancelar esta cirugía."
      preset="NewStatus=Canceled"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid]"
      provoke="btnNewStatus"/>
  </row>
  <!-- Update patient information and apply new status -->
  <row showif="never">
    <!-- When a surgery has an attached ConsultRequest, change the ConsultRequestStatus to completed -->
    <control type="button" name="btnUpdateSurgeryWaitList"
      action="save"
      affector="none"
      acctsvc="true"
      dataupdate="UpdateConsultRequests"
      appendupdate="ConsultRequestGuid=[Surgery_WaitListGuid],ConsultRequestStatus=Completed"/>
    <control type="button" name="btnNewStatus"
      action="save|close|new"
      dataupdate="UpdateScheduledSurgeries"
      appendupdate="surgeryGuid=[SurgeryGuid],Status=[NewStatus]"
      provoke="SurgeryTimes"/>
  </row>
  <!-- Surgery quote modal -->
  <row name="rowSurgeryQuote" reveal="[SurgeryGuid]!">
    <control type="button" name="btnSurgeryQuote"
      span="12" icon="hand-right" color="green" label="Cotización"
      trigger="SurgeryQuoteItems"
      action="redirect" target="mdlSurgeryQuote"/>
  </row>
  <!-- Surgery quote template list to insert a quote from a template -->
  <row name="rowSelectSurgeryQuote" reveal="[SurgeryGuid]!+[Surgery_QuoteTemplateGuid]=">
    <control type="button" name="btnSurgeryQuoteTemplateList"
      span="12" icon="search" color="green" label="Plantillas de Cotización"
      trigger="SelectSurgeryQuoteTemplateList"
      action="redirect" target="mdlSelectQuoteTemplate"/>
  </row>
</partial>