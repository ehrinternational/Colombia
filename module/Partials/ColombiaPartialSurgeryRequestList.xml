<partial>
  <!-- Partial surgery request wait list -->
  <section type="tab" name="tabSurgeryRequestList" title="Solicitudes de Cirugía" trigger="SurgeryRequestList">
    <group>
      <row>
        <!-- Change mode to read waitng list records -->
        <control type="datagrid" label="Solicitudes de Cirugía" name="SurgeryRequestList" 
          refresh="60"
          span="12" rows="20"
          searchable="true"
          fitrows="true"
          rowcolor="Priority|Urgente=red"
          action="redirect"
          target="SurgeryTabModal"
          datarequest="GetScheduledSurgeries"
          appendrequest="Location=(facilityData.LocationId),byStatus=Requested"
          source="DateTimeEntered,Priority,MedicalSpecialtyName,PrimaryProcedureName,SecondaryProcedureName,PatientName,SurgeonName"
          sourcelabels="Solicitud,Tipo,Especialidad,Procedimiento Primario,Procedimiento Segundo,Paciente,Cirujano"
          align="|left|left|left|left|left|left|left|left"
          format="datetime"
          sort="DateTimeEntered=asc"
          key="SurgeryGuid"
          onselectset="SurgeryGuid=[[SurgeryGuid]]"
          onselect="SurgeryGuid">
          <control type="button" name="btnNewSurgeryRequest" label="Añadir Nuevo" icon="plus"
            action="redirect" trigger="SurgeryOrderPatientId"
            target="mdlSurgeryOrderModal"/>
          <control type="button" name="RefreshSurgeryRequestList" label="Actualizar" icon="refresh"
            action="trigger"
            trigger="SurgeryRequestList"/>
        </control>
      </row>
    </group>
  </section>
</partial>