<partial>
  <!-- Tab modal to display surgery details -->
  <section type="tabmodal" name="mdlSurgeryViewModal" title="Cirugía" badge="none" size="medium">
    <group>
      <row>
        <control type="hidden" name="SurgeryViewGuid"
          datarequest="GetScheduledSurgeryBySurgeryGuid"
          appendrequest="SurgeryGuid=[SurgeryViewGuid]"
          inject="SurgeryViewInfo"
          set="SurgeryViewPatientId=[[PatientId]]"
          provoke="SurgeryGridList,SurgeryTeam,SurgeryViewPatientId"/>
        <control type="hidden" name="SurgeryViewPatientId"
          datarequest="GetPatientAllFields"
          appendrequest="PatientId=[SurgeryViewPatientId]"
          inject="SurgeryViewPatientInfo"/>
      </row>
    </group>
    <group name="SurgeryViewPatientInfo">
      <row>
        <control type="hidden" name="HasOpenVisit"/>
        <control type="hidden" name="DateTimeOfDeath"/>
        <control type="hidden" name="PatientVisit"/>
        <control type="hidden" name="HasOpenCharges"/>
        <control type="hidden" name="HasOpenPayments"/>
        <control type="hidden" name="HasPatientPayer"/>
        <control type="hidden" name="PatientFullName"/>
      </row>
      <row>
          <control type="label" label="Nombre" align="left" span="3"/>
          <control type="label" label="Segundo Nombre" align="left" span="3"/>
          <control type="label" label="Primer Apellido" align="left" span="3"/>
          <control type="label" label="Segundo Apellido" align="left" span="3"/>
      </row>
      <row>
        <control type="text" name="Consult_PatientFirstName" span="3" readonly="true"/>
        <control type="text" name="Consult_PatientNameSuffix" span="3" readonly="true"/>
        <control type="text" name="Consult_PatientMiddleName" span="3" readonly="true"/>
        <control type="text" name="Consult_PatientLastName" span="3" readonly="true"/>
      </row>
      <row>
        <control type="label" label="Expediente" span="2"/>
        <control type="text" name="Consult_MedicalRecordNumber" span="2" readonly="true"/> 
      <control type="label" label="Nacionalidad" span="2"/>
        <control type="select" name="Consult_Nationality" span="2" readonly="true"
          default="(facilityData.HospitalCountry)"
          sort="CountrySpanish=asc"
          datasource="GetCountries" 
          source="CountrySpanish,Code"/>   
        <control type="label" label="Sangre" span="2" />
        <control type="select" name="Consult_BloodType" span="2" readonly="true"
          source="A+,A-,B+,B-,O+,O-,AB+,AB-,Desconoce"/>
      </row>
      <row>
        <control type="label" label="Fecha Nacimiento" span="2"/>
        <control type="date" name="Consult_PatientDOB" span="3" readonly="true"/>
        <control type="text" name="Consult_PatientAge" span="2" readonly="true"/>
        <control type="label" label="Hora Nacimiento" span="3" />
        <control type="time" name="Consult_TimeOfBirth" span="2" readonly="true"/>
      </row>
      <row showif="never">
        <control type="timediff" name="Consult_AgeInHours" span="1" source="[Consult_PatientDOB],(now),hours"/>
        <control type="timediff" name="Consult_AgeInDays" span="1" source="[Consult_PatientDOB],(now),days"/>
        <control type="timediff" name="Consult_AgeInMonths" span="1" source="[Consult_PatientDOB],(now),months"/>
        <control type="timediff" name="Consult_AgeInYears" span="1" source="[Consult_PatientDOB],(now),years"/>
      </row>
      <row>
        <control type="label" label="Sexo" span="2" />
        <control type="select" name="Consult_PatientSex" span="2" readonly="true" 
          source="Male,Female,Indeterminate" explicit="true"
          sourcelabels="Masculino,Femenino,Indeterminado"/>
        <control type="label" label="Id Genero" span="2"/>
        <control type="select" name="Consult_PatientGenderId" span="2" readonly="true"
          required="[Consult_AgeInYears]»17"
          source="0,1,2,3,4,5"
          sourcelabels="0 Sin información,1	Masculino,2	Femenino,3	Transgénero,4	Neutro,5	No lo declareara"
          when="[Consult_AgeInYears]«5;"/>
        <control type="label" label="Orientación" span="2"/>
        <control type="select" name="Consult_PatientGenderIdText" span="2" readonly="true"
          required="[Consult_AgeInYears]»17"
          source="1,2,3,4,5"
          sourcelabels="1	Lesbiana,2	Bisexual,3	Transexual,4	Intersexual,5	Heterosexual"
          when="[Consult_AgeInYears]«5;"/>
      </row>
      <row>
        <control type="label" label="Teléfono Primario" span="2"/>
        <control type="text" name="Consult_PtPhoneNumber" span="2"  
          readonly="true"/>
        <control type="label" label="Segundo" span="1"/>
        <control type="text" name="Consult_PatientCellPhone" span="2"  
          readonly="true"/>    
        <control type="label" label="Correo Electrónico" span="2"/>
        <control type="text" name="Consult_PatientEmail" span="3"readonly="true" />
      </row>
      <row>
        <control type="label" label="Discapacidades" span="2"/>
        <control type="buttongroup" name="Consult_HasDisabilities" span="2" readonly="true"
          source="True,False"
          sourcelabels="SI,NO"/> 
        <control type="label" label="Tipo Discapacidad" span="2"/>
        <control type="select" name="Consult_Disabilities" span="6" readonly="true"
          edit="[Consult_HasDisabilities]=True" searchable="multiple"
          source="01,02,03,04,05,06"
          sourcelabels="01 Discapacidad física,02 Discapacidad visual,03 Discapacidad auditiva,04 Discapacidad intelectual,05 Discapacidad psicosocial,06 Sordoceguera"/>
      </row>   
    </group>
    <!-- Surgery information -->
    <group name="SurgeryViewInfo">
      <partial link="Partials/ColombiaPartialSurgeryViewInfo.xml"/>
    </group>
    <!-- Surgery grids -->
    <group>
      <row>
        <control type="buttongroup" name="SurgeryButtonGroupSelect" 
          edit="true" mode="auto"          
          source="Team,Equipment,SurgeryKits,Resources,Supplies,Implants"
          sourcelabels="Personal,Equipo,Kits,Recursos,Suministros,Implantes"
          span="12" 
          default="Team" 
          provoke="SurgeryGridList|options"/>
      </row>
      <row>
        <control name="SurgeryGridList" affector="SurgeryButtonGroupSelect" type="options" span="12">
          <!-- Partial surgery team members -->
          <control type="datagrid" label="Personal de Cirugía" name="SurgeryTeam"
            option="Team"
            rows="10"
            fitrows="true"
            datarequest="GetScheduledSurgeryTeams"
            appendrequest="surgeryGuid=[SurgeryViewGuid]"
            source="Active,Role,UserName,Notes"
            sourcelabels="Activo,Rol,Usuario,Notas"
            align="|left|left|left"
            format="boolean"
            key="TeamMemberGuid"/>
          <!-- Partial surgery equipment -->
          <control type="datagrid" label="Equipo de Cirugía" name="ScheduledEquipment" 
            option="Equipment"
            rows="10"
            fitrows="true"
            datarequest="GetScheduledEquipment"
            appendrequest="SurgeryGuid=[SurgeryViewGuid]"
            source="Active,EquipmentName,EquipmentSerialNumber,Notes"
            sourcelabels="Activo,Descripción,Serie,Notas"
            align="|left|left|left|left|left"
            format="boolean"
            key="ScheduledGuid"/>
          <control type="datagrid" label="Kits de CEYE Programados" name="ScheduledSurgeryKits" 
            option="SurgeryKits"
            rows="10"
            fitrows="true"
            datarequest="GetScheduledSurgeryKits"
            appendrequest="SurgeryGuid=[SurgeryViewGuid]"
            source="Active,KitTypeName,KitName,Description,Notes"
            sourcelabels="Activo,Tipo,Nombre,Descripción,Notas"
            align="|left|left|left"
            format="boolean"
            key="ScheduledKitGuid"/>
          <!-- Partial surgery scheduled resources -->
          <control type="datagrid" label="Recursos de Cirugía" name="SurgeryResources"
            option="Resources" 
            rows="10"
            fitrows="true"
            datarequest="GetScheduledSurgeryResources"
            appendrequest="SurgeryGuid=[SurgeryViewGuid]"
            source="Active,Description,Quantity,Notes"
            sourcelabels="Activo,Descripción,Cantidad,Notas"
            align="|left|left|left"
            format="boolean"
            key="ResourceGuid"/>
          <!-- Partial Surgery scheduled supplies -->
          <control type="datagrid" label="Suministros de Cirugía" name="SurgerySupplies" 
            option="Supplies"
            rows="10"
            fitrows="true"
            datarequest="GetScheduledSurgerySupplies"
            appendrequest="SurgeryGuid=[SurgeryViewGuid]"
            source="Active,ItemDescription,Quantity,UOM,Notes"
            sourcelabels="Activo,Suministros,Cantidad,UDM,Notas"
            align="|left|left|left|left"
            format="boolean"
            key="SupplyGuid"/>
          <!-- Partial surgery scheduled implants -->
          <control type="datagrid" label="Implantes de Cirugía" name="SurgeryImplants"
            option="Implants"
            rows="10"
            fitrows="true"
            datarequest="GetScheduledImplants"
            appendrequest="SurgeryGuid=[SurgeryViewGuid]"
            source="Active,ImplantTypeName,Description,InvoiceNumber,SerialNumber,Notes"
            sourcelabels="Activo,Tipo,Descripción,Factura,Serie,Notas"
            align="|left|left|left|left|left|left"
            format="boolean"
            key="ImplantGuid"/>
        </control>
      </row>
    </group>
  </section>
</partial>