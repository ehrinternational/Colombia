<partial>
  <!-- Tab modal to display surgery details -->
  <section type="tabmodal" name="mdlSurgeryViewModal" title="Cirugía" badge="none" size="medium">
    <group>
      <row>
        <control type="hidden" name="SurgeryViewGuid"
          datarequest="GetScheduledSurgeryBySurgeryGuid"
          appendrequest="SurgeryGuid=[SurgeryViewGuid]"
          inject="SurgeryViewInfo"
          set="SurgeryViewPatientId=[[PatientId]]"
          provoke="SurgeryViewPatientId"/>
        <control type="hidden" name="SurgeryViewPatientId"
          datarequest="GetPatientAllFields"
          appendrequest="PatientId=[SurgeryViewPatientId]"
          inject="SurgeryViewPatientInfo"/>
      </row>
    </group>
    <group name="SurgeryViewPatientInfo">
      <partial link="Partials/ColombiaPartialSurgeryPatientInfo.xml"/>
    </group>
    <!-- Surgery information -->
    <group name="SurgeryViewInfo">
      <columns>
        <column span="10">
          <partial link="Partials/ColombiaPartialSurgeryInfo.xml"/>
        </column>
        <column span="2">
          <partial link="Partials/ColombiaPartialSurgeryTabInfoButtons.xml"/>
        </column>
      </columns>
    </group>
  </section>
  <section type="tabmodal" name="tbmSurgeryBloodBankOrders" title="Ordenes de Sangre" badge="none" trigger="SurgeryBloodBankOrders">
    <group>
      <row>
         <partial link="Partials/ColombiaPartialSurgeryBloodBankOrdersWithNewAndEdit.xml"/>
      </row>
    </group>
  </section>
     <!-- Tabmodals -->
  <section type="tabmodal" name="tbmSurgeryTeam" title="Personal de Cirugía" badge="none" trigger="SurgeryTeam">
    <group>
      <row>
        <partial link="Partials/ColombiaPartialSurgeryTeam.xml"/>
      </row>
    </group>
  </section>
  <section type="tabmodal" name="tbmSurgeryEquipment" title="Equipo de Cirugía" badge="none" trigger="ScheduledEquipment">
    <group>
      <row>
        <partial link="Partials/ColombiaPartialSurgeryScheduledEquipment.xml"/>
      </row>
    </group>
  </section>
  <section type="tabmodal" name="tbmSurgeryKits" badge="none" title="Kits de CEYE Programados" trigger="ScheduledSurgeryKits">
    <group>
      <row>
        <partial link="Partials/ColombiaPartialSurgeryScheduledKits.xml"/>
      </row>
    </group>
  </section>
  <section type="tabmodal" name="tbmSurgeryStockRequests" title="Requisiciónes de Stock" badge="none" trigger="SurgeryStockRequests">
    <group>
      <row>
        <partial link="Partials/ColombiaPartialSurgeryStockRequests.xml"/>
      </row>
    </group>
  </section>
  <section type="tabmodal" name="tbmSurgeryPurchaseRequests" title="Compras de Cirugía" badge="none" trigger="SurgeryPurchaseOrders">
    <group>
      <row>
        <partial link="Partials/ColombiaPartialSurgeryScheduledPurchases.xml"/>
      </row>
    </group>
  </section>
  <section type="tabmodal" name="tbmSurgeryDocuments" badge="none" title="Documentos de Cirugía" trigger="SurgeryEcdForms,SurgeryScannedForms">
    <group>
      <row>
        <partial link="Partials/ColombiaPartialECDFormsForSurgery.xml"/>
        <partial link="Partials/ColombiaPartialSurgeryScannedDocuments.xml"/>
      </row>
    </group>
  </section>
   <!-- Surgery Modals -->
    <partial link="./Partial/Modals/PartialAISurgerySummary.xml"/>
    <partial link="./Partial/Modals/PartialSurgeryTeamModal.xml"/>
    <partial link="./Partial/Modals/PartialScheduledSurgeryKitsModal.xml"/>
    <partial link="./Partial/Modals/PartialSurgeryEquipmentModal.xml"/>
    <partial link="./Partial/Modals/PartialSurgeryStockRequestModal.xml"/>
    <partial link="./Partial/Modals/PartialSurgeryTemplateListModal.xml"/>
    <partial target="mdlPatientPurchaseOrderRequest" link="./Partial/Modals/PartialPatientPurchaseOrderRequestsModal.xml"/>
</partial>