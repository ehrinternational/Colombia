<partial>
    <!-- AI buttons -->
    <facet name="GetSummaryData" mode="tojson"
      datarequest="GetPatientClinicalSummary" acctsvcreq="true" provoke="SaveSummaryData"
      appendrequest="PatientId=[PatientId],currentDateTime=(now)"/>
    <facet name="SaveSummaryData" mode="facetasfile" action="export"
      target="GetSummaryData" title="Patient Summary"/>
    <row>
      <control type="button" name="btnClaraMedicalLite" label="Clara AI Lite" span="12" action="queryai" color="lightblue"
        reveal="(FileName)%Nurse"
        datasource="GetAIPrompts" acctsvc="true"
        append="promptGuid=b0ba70aa-fe25-4fdb-80b3-9aeac3d6a569"
        source="[[PromptText]]" svctype="[[Type]]"
        datarequest="[[QueryName]]" acctsvcreq="true" mode="tojson"
        appendrequest="PatientId=[PatientId],currentDateTime=(now)"
        title="CLARA Medical Assistant" filename="[[PromptName]]"
        limit="[[OutputTokens]]" linksource="[[id]]" model="[[AIModel]]"
        generator="[[AIGenerator]]"/>
    </row>
    <row>
      <control type="button" name="btnClaraMedicalPro" label="Clara AI Pro" span="12" action="queryai"
        reveal="(uFileName)%Physician|Doctor|Surgeon"
        datasource="GetAIPrompts" acctsvc="true"
        append="promptGuid=02a98eb5-65c2-4273-b187-6a9e670bb92a"
        source="[[PromptText]]" svctype="[[Type]]"
        datarequest="[[QueryName]]" acctsvcreq="true" mode="tojson"
        appendrequest="PatientId=[PatientId],currentDateTime=(now)"
        title="CLARA Medical Assistant Pro" filename="[[PromptName]]"
        limit="[[OutputTokens]]" linksource="[[id]]" model="[[AIModel]]"
        generator="[[AIGenerator]]"/>
    </row>
    <row>
      <control type="button" name="btnClaraRisk" label="Clara AX" span="12" action="queryai" color="yellow"
        reveal="(FileNAme)%Physician|Doctor"
        datasource="GetAIPrompts" acctsvc="true"
        append="promptGuid=bb6c4467-af3f-47d7-a1e4-9bde8d432851"
        source="[[PromptText]]" svctype="[[Type]]"
        datarequest="[[QueryName]]" acctsvcreq="true" mode="tojson"
        appendrequest="PatientId=[PatientId],currentDateTime=(now)"
        title="[[PromptName]]" filename="[[PromptName]]"
        limit="[[OutputTokens]]" linksource="[[id]]" model="[[AIModel]]"
        generator="[[AIGenerator]]"/>
    </row>
