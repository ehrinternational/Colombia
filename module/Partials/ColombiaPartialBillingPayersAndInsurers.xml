<partial>
  <!-- Payer and insurer setup -->
  <section type="tab" name="tabPayersAndInsurers" title="Empresas" trigger="grdPayersAndInsurers">
    <group>
     <row>      
        <control type="datagrid" label="Empresas" name="grdPayersAndInsurers"
          searchable="true" span="12" rows="20"
          action="redirect"
          target="mdlNewPayer"
          acctsvcreq="true"
          datarequest="GetPayers"
          source="Active,RFC,PayerName"
          sourcelabels="Activo,Codigo,Pagador o Asegurador"
          align="|left|left"
          format="boolean"
          sort="PayerName=asc"
          key="PayerGuid"
          onselectset="PayerGuid=[[PayerGuid]]"
          onselect="PayerGuid">
          <control type="button" name="btnInsertNewPayer"
            icon="plus" label="Añadir Nuevo"
            action="redirect" target="mdlNewPayer"/>
          <control type="button" name="btnPrintPayersList" icon="print" label="Imprimir"
            action="print"
            mode="report" 
            append="id=c6dbfe1f656,FacilityId=(facility),ReportName=Pagadores,UserId=(userName),DateTimeNow=(dateTimeNow)"/>  
          <control type="button" name="btnRefreshPayers"
            icon="refresh" label="Actualizar"
            action="trigger" provoke="grdPayersAndInsurers"/>
          </control>    
      </row>
    </group>
  </section>  
  <!-- tabmodal to enter/edit payers -->
  <section type="tabmodal" name="mdlNewPayer" title="Empresa" badge="none" provoke="grdPayersAndInsurers">
    <group>
      <row showif="never">
        <control type="hidden" name="PayerGuid"
          acctsvcreq="true"
          datarequest="GetPayerByPayerGuid"
          appendrequest="PayerGuid=[PayerGuid]"
          inject="grpPayerGroup"
          provoke="PayerButtonGroupSelect"/>
          <!-- ??,GetMoneyLaundering -->
        <control type="hidden" name="GetMoneyLaundering"
          acctsvcreq="true"
          datarequest="GetMoneyLaundering"
          appendrequest="RelatedGuid=[PayerGuid]"
          set="[[PersonType]]=;[MoneyLaunderingFound]=False^[MoneyLaunderingFound]=True"/>
        <control type="hidden" name="MoneyLaunderingFound" default="False"/>
      </row>
    </group>
    <group name="grpPayerGroup"> 
      <columns>
        <column span="10">
          <subset bgcolor="white">
          <!-- Payer type -->
          <row>
            <control type="label" label="NIT Empresa" span="3"/>
            <control type="text" name="Pyr_PayerId" span="3" edit="true" required="true" 
              regex="^[A-Z0-9]{2,6}$"/>
            <control type="checkbox" name="Pyr_International" label="NIT Internacional"
              source="True,False" span="3" edit="true" default="True" />
            <control type="checkbox" name="Pyr_Active" label="Vigente" 
               source="True,False" span="2" edit="true" default="True" />
          </row>
          <row>
            <control type="label" label="Razón" span="3"/>
            <control type="text" name="Pyr_PayerName" span="9" required="true" edit="true" 
            regex="^[A-Z0-9., \-]{3,100}$"/>
          </row>
          <row>
            <control type="label" label="Dirección Página Web" span="3"/>
            <control type="text" name="Pyr_WebPage" span="9" edit="true" 
            regex="^[A-Z0-9., \@-]{3,100}$"/>
          </row>
          <row>
            <control type="label" label="Razón Social DIAN" span="3"/>
            <control type="text" name="Pyr_PayerName2" span="9" required="true" edit="true" 
            regex="^[A-Z0-9., \-]{3,100}$"/>
          </row>
          <row>
            <control type="label" label="Código" span="3"/>
            <control type="text" name="Payer2_RFC" span="3" edit="true" required="true" 
              regex="^[A-Z0-9]{2,6}$"/>
            <control type="label" span="1" label="Tipo"/>
            <control type="select" name="Pyr_PayerType" span="5" required="true"
            source="01,05,07,06,03,02,09,08,12,11,04,13" explicit="true"
            sourcelabels="01 EMRESA PROMOTORA DE SALUD - EPS,
              05 EMPRESA PARTICULAR,
              07 ADMINISTRADORA DE RIESGOS PROFESIONALES - ARP,
              06 INSTITUCION PRESTADORA DE SALUD - IPS,
              03 EMPRESA DE SEGURIDAD SOCIAL DEL ESTADO - ESS,
              02 ADMINSTRADORS DE REGIMEN SUBSIDIADO - ARS,
              09 COMPANIA NACIONAL DE SEGUROS,
              08 CAJA DE COMPENSACION FAMILIAR,
              12 EMPRESA MEDICINA PREPAGADA,
              11 ENTIDADES GUBERNAMENTALES,
              04 PERSONA NATURAL,
              13 CONVENIO ESPECIAL" 
            edit="true"/>
          </row>    
        </subset>
        </column>
        <column span="2">
          <row>
            <control type="button" name="btnSaveNewPayer" label="Continuar" color="green" icon="cloud-upload" span="12"
              reveal="[PayerGuid]="
              action="save"
              acctsvc="true"
              affector="PayerGuid"
              setaffector="PayerGuid"
              datainsert="InsertPayer"
              capture="grpPayerGroup"/>
            <control type="button" name="btnUpdateNewPayer" label="Actualizar" icon="cloud-upload" span="12"
              reveal="[PayerGuid]!"
              action="save|close|new"
              acctsvc="true"
              affector="none"
              dataupdate="UpdatePayer"
              appendupdate="PayerGuid=[PayerGuid]"
              capture="grpPayerGroup"/>
            <control type="button" name="btnMoneyLaunderingFound" label="Declaración Orig De Fondo" icon="search" span="12"
              reveal="[PayerGuid]!+[MoneyLaunderingFound]=True"
              preset="RelatedGuid=[PayerGuid]"
              trigger="RelatedGuid"
              action="redirect" target="mdlMoneyLaundering"/>
            <control type="button" name="btnMoneyLaunderingNotFound" label="Declaración Orig De Fondo" icon="search" color="orange" span="12"
              reveal="[PayerGuid]!+[MoneyLaunderingFound]=False"
              action="redirect" target="mdlMoneyLaundering"/>
          </row>
        </column>
        <column span="12">
        <subset bgcolor="white">
          <row>
            <control type="label" label="Responsabilidad" span="4"/>
            <control type="select" name="Pyr_Responsable" span="8" edit="true"
              source="0-13,R-99-PN"/>
          </row>
          <row>
            <control type="label" label="Registro Mercantil" span="4"/>
            <control type="text" name="Pyr_Registry" span="8" edit="true"/>
          </row>
        </subset>
        <subset bgcolor="white">
          <row>
            <control type="label" label="Representante Legal" span="5" align="left"/>
          </row>
          <row>
            <control type="label" label="Tipo Documento" span="3"/>
            <control type="select" name="Pyr_DocumentType" span="3" required="true" edit="true"
              source="SI,RC,TI,CC,CE,NI,MS,PA,AS,NU,CD,SC,PE,CN,DE,PT" searchable="true"
              sourcelabels="SIN IDENTIFICACIÓN,REGISTRO CIVIL DE NACIMIENTO,TARJETA DE IDENTIDAD,CEDULA DE CIUDADANIA,CEDULA DE EXTRANJERIA,NIT,MENOR SIN IDENTIFICAR,PASAPORTE,ADULTO SIN IDENTIFICAR,NUIP,CARNÉ DIPLOMÁTICO,SALVOCONDUCTO,PERMISO ESPECIAL PERMANENCIA,CERTIFICADO DE NACIDO VIVO,DOCUMENTO EXTRANJERO,PERMISO PROTECCIÓN TEMPORAL"/>
            <control type="label" label="Numero Documento" span="3"/>
            <control type="text" name="Payer0_DocumentNumber" span="3" readonly="true"
              reveal="[Pyr_DocumentType]=SI|"/>
            <control type="text" name="Payer1_DocumentNumber" span="3" required="true" tooltip="11 caracteres alfanuméricos"
              reveal="[Pyr_DocumentType]=RC" edit="true"
              regex="^[a-zA-Z0-9]{11}$"/>
            <control type="text" name="Payer2_DocumentNumber" span="3" required="true"  tooltip="11 caracteres numéricos"
              reveal="[Pyr_DocumentType]=TI" edit="true"
              regex="^[0-9]{11}$"/>
            <control type="text" name="Payer3_DocumentNumber" span="3" required="true"  tooltip="10 caracteres numéricos"
              reveal="[Pyr_DocumentType]=CC"  edit="true"
              regex="^[0-9]{10}$"/>
            <control type="text" name="Payer4_DocumentNumber" span="3" required="true" tooltip="7 caracteres numéricos"
              reveal="[Pyr_DocumentType]=CE"  edit="true"
              regex="^[0-9]{7}$"/>
            <control type="text" name="Payer5_DocumentNumber" span="3" required="true" tooltip="13 caracteres numéricos"
              reveal="[Pyr_DocumentType]=NI"  edit="true"
              regex="^[0-9]{13}$"/>
            <control type="text" name="Payer6_DocumentNumber" span="3" required="true" tooltip="12 caracteres alfanuméricos"
              reveal="[Pyr_DocumentType]=MS"  edit="true"
              regex="^[a-zA-Z0-9]{12}$"/>
            <control type="text" name="Payer7_DocumentNumber" span="3" required="true" tooltip="16 caracteres alfanuméricos"
              reveal="[Pyr_DocumentType]=PA"  edit="true"
              regex="^[a-zA-Z0-9]{16}$"/>
            <control type="text" name="Payer8_DocumentNumber" span="3" required="true" tooltip="10 caracteres alfanuméricos"
              reveal="[Pyr_DocumentType]=AS"  edit="true"
              regex="^[a-zA-Z0-9]{10}$"/>
            <control type="text" name="Payer9_DocumentNumber" span="3" required="true" tooltip="12 caracteres numéricos"
              reveal="[Pyr_DocumentType]=NU"  edit="true"
              regex="^[0-9]{12}$"/>
            <control type="text" name="Payer10_DocumentNumber" span="3" required="true" tooltip="11 caracteres alfanuméricos"
              reveal="[Pyr_DocumentType]=CD"  edit="true"
              regex="^[a-zA-Z0-9]{11}$"/>
            <control type="text" name="Payer11_DocumentNumber" span="3" required="true" tooltip="12 caracteres alfanuméricos"
              reveal="[Pyr_DocumentType]=SC"  edit="true"
              regex="^[a-zA-Z0-9]{12}$"/>
            <control type="text" name="Payer12_DocumentNumber" span="3" required="true" tooltip="15 caracteres numéricos"
              reveal="[Pyr_DocumentType]=PE"  edit="true"
              regex="^[0-9]{15}$"/>
            <control type="text" name="Payer13_DocumentNumber" span="3" required="true" tooltip="14 caracteres numéricos"
              reveal="[Pyr_DocumentType]=CN"  edit="true"
              regex="^[0-9]{14}$"/>
            <control type="text" name="Payer14_DocumentNumber" span="3" required="true" tooltip="16 caracteres alfanuméricos"
              reveal="[Pyr_DocumentType]=DE"  edit="true"
              regex="^[a-zA-Z0-9]{16}$"/>
            <control type="text" name="Payer15_DocumentNumber" span="3" required="true" tooltip="15 caracteres numéricos"
              reveal="[Pyr_DocumentType]=PT"  edit="true"
              regex="^[0-9]{15}$"/>
          </row>
          <row>
            <control type="label" label="Nombres" span="3"/>
            <control type="text" name="Pyr_LegalName" span="9" edit="true"/>
          </row>
          <row>
            <control type="label" label="Direccion" span ="3"/>
            <control type="text" name="Pyr_LegalAddress" span="9" edit="true"
              regex="^[A-Za-z0-9 ,]{5,100}$"/>
          </row>
          <row>
          <control type="label" label="País" span ="3"/>
          <control type="select" name="Pyr_LegalCountryCode" span="3" edit="true" 
              default="(facilityData.HospitalCountry)"
              namefield="Pyr_LegalCountry"
              searchable="true"
              required="true"
              sort="CountrySpanish=asc"
              datasource="GetCountries" 
              source="CountrySpanish,Code"
              provoke="Pyr_LegalStateCode"/>  
          <control type="label" label="Departamento" span="3"/>
          <control type="select" name="Pyr_LegalStateCode" span="3" namefield="Pyr_LegalState"
              explicit="true" required="true" edit="true" searchable="true"           
              idle="[Pyr_LegalCountryCode]="
              datarequest="GetStatesProvincesByCountryCode"
              appendrequest="CountryCode=[Pyr_LegalCountryCode]"
              source="Name,Code"
              provoke="Pyr_LegalMunicipalityCode"/>
          </row>
          <row>
            <control type="label" label="Municipio" span="3"/>
            <control type="select" name="Pyr_LegalMunicipalityCode" span="3"       
              edit="true" sort="Name" explicit="true" namefield="Pyr_LegalMunicipaliiy"
              searchable="true"  
              idle="[Pyr_LegalStateCode]=" 
              source="Name,Code" 
              acctsvcreq="true"     
              datarequest="GetColombiaMunicipalities"         
              appendrequest="State=[Pyr_LegalStateCode]"/>  
            <control type="label" label="Código Postal" span="3"/>
            <control type="text" name="Pyr_LegalPostalCode" span="3" edit="true"
              regex="^(\d{6})?$"/> 
          </row>
          <row>
            <control type="label" label="Teléfonos" span="3"/>
            <control type="text" name="Pyr_LegalPhones" span="9" edit="true"/>
          </row>
        </subset>
        <subset bgcolor="white">
          <row>
            <control type="label" label="Información Tributaria" span="5" align="left"/>
          </row>
          <row>
            <control type="label" label="Régimen Tributario" span="3"/>
            <control type="buttongroup" name="Pyr_RegTribute" span="3" edit="true"
              source="C,S" sourcelabels="Común,Simplificado"/>
            <control type="label" label="Tipo Contribuyente" span="3"/>
            <control type="buttongroup" name="Pyr_Contribute" span="3" edit="true"
              source="P,G" sourcelabels="Pequeño,Grande"/>
          </row>
          <row>
            <control type="label" label="" span="3"/>
            <control type="checkbox" name="Pyr_Exempt" span="3" edit="true" label="Exento" source="True,False"/>
            <control type="checkbox" name="Pyr_AutoRetain" span="3" label="Auto Retenedor" edit="true" source="True,False"/>
            <control type="checkbox" name="Pyr_AgRetain" span="3"  label="Ag Retenedor" edit="true" source="True,False"/>
          </row>
        </subset>
      </column>
      </columns>
      <!-- Display list of contracts and scanned documents -->
    </group>
    <group name="grpPayerCharges" reveal="[PayerGuid]!">
       <row>
        <control type="buttongroup" name="PayerButtonGroupSelect" edit="true" mode="auto" span="8"
          source="Contacts,Contracts,Documents" 
          sourcelabels="Contactos del Empressa,Contratos del Empressa,Documentos" 
          default="Contacts"  
          provoke="PayerGridOptions|options"/>
      </row>
      <row>
        <control type="options" name="PayerGridOptions" affector="PayerButtonGroupSelect" span="12">
          <control type="datagrid" label="Contactos del Empressa" name="Contacts" 
            option="Contacts"
            span="12" rows="5"
            modalname="mdlPayerContacts"
            idle="[PayerGuid]=|reset"
            datarequest="GetPatientSupportContactsByPatientId"
            datainsert="InsertPatientSupportContacts"
            dataupdate="UpdatePatientSupportContacts"
            appendrequest="patientId=[PayerGuid]"
            appendinsert="patientId=[PayerGuid]"
            source="Active,FirstName,MiddleName,LastName,HomeTelephone,MobileTelephone,EmailAddress"
            sourcelabels="Activo,Nombre(s),Apellido Primario,Apellido Segundo,Teléfono,Celular,Correo Electrónico"
            align="|left|left|left|left|left|left|left|left"
            format="boolean" 
            key="ContactGuid"/>
          <control type="datagrid" label="Contratos del Empressa" name="dgrContracts" rows="5" option="Contracts"
            acctsvcreq="true"
            datarequest="GetInsuranceContracts"
            appendrequest="PayerGuid=[PayerGuid]"
            source="DocumentType,ContractCode,ContractName,Active,ContractType"
            sourcelabels="Tipo Documento,Código,Nombre de Convenio,Vigente,Tipo de Convenio"
            align="|left|left|left|left|left|left"
            format="|||boolean"
            sort="StartDate=desc"
            key="ContractGuid"
            action="redirect"
            target="mdlContracts"
            onselectset="ContractGuid=[[ContractGuid]]"
            onselect="ContractGuid">
            <control type="button" name="btnNewContract" label="Añadir Nuevo" icon="plus" 
              action="redirect"
              target="mdlContracts"/>
          </control>
          <control type="datagrid" label="Documentos" name="dgrPayerScannedDocuments"
            rows="5" option="Documents" searchable="true"
            acctsvcreq="true"
            filter="Status=Active"
            datarequest="GetImagingOrderFilesByImagingOrderGuid"
            appendrequest="ImagingOrderGuid=[PayerGuid]"
            source="DateEntered,FileType,FileName,EnteredByFullName"
            sourcelabels="Fecha y Hora,Tipo,Documento,Entregado por"
            translate="FileType"
            align="left|left|left|left"
            format="datetime"
            sort="DateTimeEntered=desc"
            key="PhotoGuid"
            action="redirect|url"
            target="printables/uploadviewer.html"
            usesource="login"
            append="fileGuid=[[PhotoGuid]],fileType=[[FileType]]">
            <control type="button" name="btnRemoveDocument"
              label="Eliminar" icon="remove" color="red"
              showif="feature"
              action="save"
              acctsvc="true"
              confirm="Confirme que desea eliminar este archivo."
              dataupdate="UpdatePatientFilesByPhotoGuid"
              appendupdate="PhotoGuid=[[PhotoGuid]],Status=Canceled"
              provoke="dgrPayerScannedDocuments"/>
          <!-- Upload scanned documents -->
            <control type="button"
              name="PO_ScanDocuments"
              label="Subir Documentos"
              icon="folder-open"
              append="labOrderId=[PayerGuid]"
              action="upload"
              filter="pdf,jpg,jpeg,png"
              provoke="dgrPayerScannedDocuments"/>
          </control>
        </control>
      </row>
    </group>
  </section>
  <!-- Patient Address modal -->
  <section type="tabmodal" name="mdlPayerAddress" title="Dirección del Empresa" size="small" badge="none">
    <group>
      <control type="hidden" name="GetPayerAddress"
          acctsvcreq="true"
          datarequest="GetPayerByPayerGuid"
          appendrequest="PayerGuid=[PayerGuid]"
          inject="grpPayerAddressInfo"/>
    </group>
    <group name="grpPayerAddressInfo">
      <row>
        <control type="label" label="Dirección" span ="4"/>
        <control type="text" name="Pya_MailingAddressLine1" span="5" edit="true"
          regex="^[A-Za-z0-9 ,]{5,120}$"/>
      </row>
      <row>
       <control type="label" label="País" span ="4"/>
       <control type="select" name="Pya_MailingCountry" span="5" edit="true" 
          default="(facilityData.HospitalCountry)"
          searchable="true"
          required="true"
          sort="CountrySpanish=asc"
          datasource="GetCountries" 
          source="CountrySpanish,Code"
          provoke="Pya_MailingStateProvince"/>  
      </row>
      <row>
       <control type="label" label="Departamento" span="4"/>
       <control type="select" name="Pya_MailingStateProvince" span="5"
          explicit="true" required="true" edit="true" searchable="true"           
          idle="[Pya_MailingCountry]="
          datarequest="GetStatesProvincesByCountryCode"
          appendrequest="CountryCode=[Pya_MailingCountry]"
          source="Name,Code"
          provoke="Pya_MailingCity"/>
      </row>
      <row>
        <control type="label" label="Municipio" span="4"/>
         <control type="select" name="Pya_MailingCity" span="5"       
          edit="true" sort="Name" explicit="true"
          searchable="true"  
          idle="[Pya_MailingStateProvince]="
          acctsvcreq="true"       
          datarequest="GetColombiaMunicipalities"         
          source="Name,Code" 
          appendrequest="State=[Pya_MailingStateProvince]"/>  
      </row>  
      <row>
        <control type="label" label="Código Postal" span="4"/>
        <control type="text" name="Pya_MailingPostalCode" span="3" edit="true"
          regex="^(\d{6})?$"/> 
      </row>
      <row>
        <control type="modalbutton" name="btnUpdatePayerAddress" label="Actualizar" icon="cloud-upload" span="12"
          action="save|close|new"
          capture="grpPayerAddressInfo"
          acctsvc="true"
          affector="none"
          dataupdate="UpdatePayer"
          appendupdate="PayerGuid=[PayerGuid]"/>
      </row>
    </group>
  </section>  
</partial>