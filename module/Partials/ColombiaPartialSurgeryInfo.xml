<partial>
  <!-- GoPartialSurgeryInformation -->
  <row>
    <control type="hidden" name="Surgery_PatientId"/>
    <control type="hidden" name="Surgery_ScheduledBy" default="(userName)"/>
    <control type="hidden" name="Surgery_TemplateGuid"/>
    <control type="hidden" name="Surgery_QuoteTemplateGuid"/>
    <control type="hidden" name="CalendarRoomType2"/>
  </row>
  <row>
    <control type="label" label="Tipo de Consulta" span="3"/>
    <control type="buttongroup" name="Surgery_AttentionType" span="3" required="true"
      source="Ambulatory,Hospital" sourcelabels="Ambulatorio,Hospitalización" 
      edit="[FileName]=SurgeryScheduling+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"/>
    <control type="label" label="Especialidad" span="3"/>
    <control type="select" name="Surgery_MedicalSpecialty" span="3" 
      acctsvc="true" required="true"
      datasource="GetMedicalSpecialties" 
      filter="ParentSpecialty=null"
      default="[SearchSurgerySpecialty]"
      source="Specialty,MedicalSpecialtyGuid"
      edit="[FileName]=SurgeryScheduling+[Surgery_Status]=Requested|Scheduled|Confirmed"/>
  </row>
   <row>
    <control type="label" label="Tipo de Solicitud" span="3"/>
    <control type="select" name="Surgery_Priority" span="3" 
      edit="[FileName]=SurgeryScheduling+[Surgery_Status]=Requested|Scheduled|Confirmed"
      required="true"
      source="Electiva,Urgente" default="Electiva"/>
    <control type="label" label="Estatus" span="3"/>
    <control type="select" name="Surgery_Status" span="3" edit="(user.UserRoles)%SysAdmin" 
      explicit="true" 
      source="Requested,Scheduled,Confirmed,In Process,Completed,Canceled"
      sourcelabels="Solicitado,Reservada,Confirmado,En Proceso,Realizada,Cancelada" 
      default="Requested"
      when="[Surgery_Status]=;Requested"/>
  </row>
  <row name="rowSurgeryCalendar" reveal="[EditMode]=Surgery">
    <control type="label" label="Calendario" span="3"/>
    <control type="select" name="Surgery_CalendarGuid" span="3"
      datasource="GetSchedulerAppointmentTypesByFacility" 
      source="CalendarName,CalendarGuid" 
      required="true"
      readonly="true"
      set="[[Service]]!;CalendarRoomType2=[[Service]]^CalendarRoomType2=None"
      provoke="Surgery_RoomGuid"/>
    <control type="label" label="Sala" span="3"/>
    <control type="select" name="Surgery_RoomGuid" span="3" 
      reveal="[EditMode]=Surgery" required="true"
      datarequest="GetRoomsAndBedsForThisFacility"
      source="RoomAndBedNumber,RoomGuid"
      filter="RoomTypeGuid=[CalendarRoomType2]"
      explicit="true" edit="[FileName]=SurgeryScheduling,[Surgery_RoomGuid]=" 
      sort="RoomAndBedNumber=asc"/>
  </row>
  <row name="rowSurgeryDateTime" reveal="[EditMode]=Surgery">
    <control type="label" label="Fecha Programada" span="3"/>
    <control type="datetime" name="Surgery_DateTimeScheduled" span="3" 
    edit="[FileName]=SurgeryScheduling+[Surgery_Status]=Requested|Scheduled|Confirmed" 
    required="true"/>
    <control type="label" label="Fecha Realizada" span="3"/>
    <control type="datetime" name="Surgery_DateTimePerformed" span="3"
      required="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=In Process"
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=In Process"/>
  </row>
  <row>
    <control type="label" label="Vía Ingreso Usuario" span="3"/>
    <control type="select" name="Surgery_ArrivedByCode" span="3" edit="true" required="true"
        source="01,02,03,04"
        sourcelabels="01 URGENCIAS,02 REMITIDO (REFERENCIA),03 CONSULTA EXTERNA,04 Novedad"/>
    <control type="label" label="Finalidad Procedimiento" span="3"/>
    <control type="select" name="Surgery_FinalizedProcedure" span="3" edit="true" required="true"
        source="1,2,3"
        sourcelabels="1 Diagnóstico, 2 Terapéutico, 3 Preventivo"/>
  </row>
  <row>
    <control type="label" label="Numero Prescripcion MIPRES" span="3"/>
    <control type="text" name="Surgery_MIPRESPrescription" span="3" edit="true"/>
  </row>
  <row>
    <control type="label" label="Duración Prevista" badge="min" span="3"/>
    <control type="integer" name="Surgery_EstimatedLength" span="2" 
    edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"
    required="true" 
    when="=1440;60"/>
    <control type="label" label="Duración Actual" badge="min" span="3"/>
    <control type="integer" name="Surgery_ActualLength" span="2" 
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=In Process"/>
  </row>
  <row>
    <control type="label" label="Tipo de Cirugía" span="3"/>
    <control type="select" name="Surgery_SurgeryType" span="3" required="true"
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"
      source="Ortopedia,Mano,Columna,Retiro,Plástica,Plástica Reconstructiva,
      Cirugía con Laser,No ortopédica,Especial"/>
    <control type="label" label="Tipo de Anestesia" span="3"/>
    <control type="select" name="Surgery_AnesthesiaType" span="3" required="true"
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|Anesthesiologist+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"
      source="Sin Información,Regional peridural,Bloqueo regional,Anestesia pediatria,
      Local,Regional requidea,Anestesia general,Local asistida,Regional suplementada"/>
  </row>
  <row name="rowSurgeryDescription" reveal="[EditMode]!Template">
    <control type="label" label="Descripción Cirugía" span="3"/>
    <control type="textarea" name="Surgery_ScheduleNotes" span="9" rows="1" 
    required="true"
    edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant|Anesthesiologist" />
  </row>
  <row>
    <control type="label" label="Diagnóstico Preoperatorio" span="3"/>
    <control type="typeahead" name="ConfirmedDiagnosis,ConfirmedDiagnosisCode" span="9" 
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process" 
      required="true"
      datasource="GetICD10CodesSearchByTerm"
      term="term"
      source="ICD10CodeDescription,ICD10Code"/>
  </row>
  <row>
    <control type="label" label="Diagnóstico Postoperatorio" span="3"/>
    <control type="typeahead" name="SecondaryDiagnosis,SecondaryDiagnosisCode" span="9" 
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process|Completed" 
      datasource="GetICD10CodesSearchByTerm"
      term="term"
      source="ICD10CodeDescription,ICD10Code"/>
  </row>
  <row>
    <control type="label" label="Procedimiento Programada" span="3"/>
    <control type="typeahead" name="PrimaryProcedureName,PrimaryProcedure" span="9" 
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"
      source="ProcedureDescription,ProcedureGuid"
      datasource="GetProceduresFromProcedureAdministration"
      term="procedureDescription" required="true"/>
  </row>
  <row>
    <control type="label" label="Cirujano Principal" span="3"/>
    <control type="select" name="Surgery_SurgeonId"
      acctsvc="true" datasource="GetUsersByAttributes" 
      append="LocationId=(facilityData.LocationId),role=Surgeon"
      source="UserFirstMiddleLast,UserId"
      span="3" explicit="true" 
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"/>
    <control type="label" label="Clasificación de la Herida" span="3"/>
    <control type="select" name="Surgery_WoundType" span="3" required="true"
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"
      source="Limpia,Limpia contaminada,Contaminada,Sucia"/>
  </row>
  <row>
    <control type="label" label="Equipos especiales" span="3"/>
    <control type="select" name="Surgery_SpecialEquipment" span="9" searchable="multiple"
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"
      filter="DeviceType=Surgery"
      datasource="GetMedicalDeviceItemsActive"
      source="DeviceCode|DeviceDescription,DeviceGuid"/>
  </row>
  <row>
    <control type="label" label="Material de osteosíntesis, prótesis y/o material implantable" span="6"/>
    <control type="textarea" name="SpecialResources" span="6" rows="1"
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"/>
  </row>
   <row>
    <control type="label" label="" span="3"/>
    <control type="checkbox" name="ReserveBed" span="3"  source="True,False" label="Reservar habitación"
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"/>
    <control type="label" label="Dias" span="1"/>
    <control type="integer" name="BedReserveDays" span="1" 
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"/>
    <control type="label" label="" span="1"/>
    <control type="checkbox" name="ReserveICU" span="3" source="True,False" label="Reservar UCI"
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"/>
  </row>
  <row>
    <control type="label" label="Observaciones antes de la cirugía" span="5"/>
    <control type="textarea" name="Surgery_PreOpNotes" span="7" rows="1" 
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"/>
  </row>
  <row>
    <control type="label" label="Observaciones posteriores a la cirugía" span="5"/>
    <control type="textarea" name="Surgery_PostOpNotes" span="7" rows="1" 
    edit="[FileName]=SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"/>
  </row>  
  <row>
    <control type="label" label="Duración Anestesia" badge="min" span="4"/>
    <control type="integer" name="Surgery_AnesthesiaDuration" span="1" 
    edit="[FileName]=SurgeryScheduling|SurgeryDoctor|Anesthesiologist+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"/>
    <control type="label" label="Duración t. Quirúrgico" badge="min" span="4"/>
    <control type="integer" name="Surgery_SurgeryDuration" span="1" 
      edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=Requested|Scheduled|Confirmed|In Process"/>
  </row>
  <row>
    <control type="checkbox" name="ExtendedRecuperation" label="Via Recuperacion Ampliada" span="4" edit="true" offset="3"
      source="True,False"/>
    <control type="checkbox" name="ExtracorporealPump" label="Uso Bomba Extracorporea" span="4" edit="true"
      source="True,False"/>
  </row>
  <row name="rowSurgeryIncidents" reveal="[EditMode]=Surgery+[Surgery_Status]=In Process|Complete">
    <control type="label" label="Incidentes" span="3"/>
    <control type="select" name="Surgery_SurgeryIncidents" span="9"
      explicit="true" edit="[FileName]=SurgeryScheduling|SurgeryDoctor|SurgeryAssistant+[Surgery_Status]=In Process|Complete" 
      searchable="multiple"
      source="Ninguno,Intubación Nasal,Colapso Pulmonar,Acceso Venoso Dificil,
      Punción de dura madre,Intubación Dificil,Espasmo Laringeo,Bloqueo Insuficiente,
      Desaturación,Bronco Espasmo,No se pudo intubar"/>
  </row>
</partial>