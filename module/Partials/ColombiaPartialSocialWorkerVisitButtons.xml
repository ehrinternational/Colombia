<partial>
   <row>
      <!-- Display the patient timeline -->
      <control type="button" name="btnTimeline"
        reveal="[PatientId]!+[PatientVisitGuid]!"
        span="12"
        color="yellow" icon="time" 
        label="Cronograma"
        action="redirect|view"
        target="timeline"
        append="patientid=[PatientId],patientvisit=[PatientVisitGuid],distinct=true"/>
  </row>
  <row>
      <!-- Transfer patient to another department -->
      <control type="button" name="btnTransferPatient"
      reveal="[HasOpenVisit]=true"
      span="12" icon="hospital" label="Transferir"
      color="orange" action="redirect"
      preset="Transfer2_DepartmentGuid=[DepartmentGuidLookup]"
      target="mdlTransferPatient"/>
  </row>
  <row>
    <control type="button" name="btnMove"
      reveal="[HasOpenVisit]=true"
      span="12" icon="move" label="Mover"
      color="orange"
      action="redirect"
      target="mdlMovePatient"/>
  </row>
  <!-- Return patient to their prior department and service -->
  <row name="rowReturnPatientToPriorDepartmentAndService" 
    reveal="[PriorDepartmentGuid]!+[PatientId]!+[PatientVisitGuid]!">
    <control type="button" name="btnReturnPatient" label="Dpto. previo"
      color="green" icon="move" span="12"
      affector="none" 
      action="save|close|new"
      confirm="Confirme que desea devolver a este paciente a su departamento y servicio anterior."
      dataupdate="UpdatePatientVisitAllFields"
      appendupdate="patientId=[PatientId],
        patientVisitUniqueId=[PatientVisitGuid],
        hospitalService=Esperando,
        departmentGuid=[PriorDepartmentGuid],
        departmentService=[PriorDepartmentService],
        DateTimeCalled=null,
        RoomService=null"/>
    </row>
</partial>