<partial>
<section type="tabmodal" name="mdlSurgeryBundle" title="Paquete de Cirugía" badge="none">
    <group>
      <row>
        <control type="hidden" name="GetSurgeryPackage"
          datarequest="GetScheduledSurgeryBySurgeryGuid"
          appendrequest="SurgeryGuid=[SurgeryGuid]"
          inject="BundleSurgeryInfo"/>
      </row>
    </group>
    <group name="BundleSurgeryInfo">
      <row showif="edit">
        <control type="label" label="" span="3"/>
        <control type="buttongroup" name="Bdl_IsBundle" span="3"
          source="True,False" sourcelabels="Sí,No" default="True" edit="true" />
      </row>
      <row>
        <control type="label" label="Procedimiento" span="3"/>
        <control type="select" name="Bdl_ProcedureGuid" span="8" edit="true" required="[Ssm_IsBundle]=True"
          filter="Active=true" searchable="true"
          acctsvc="true"
          datasource="GetProcedureAdministrationItems"
          source="RVSCode|ProcedureDescription,ProcedureGuid"/>
      </row>
      <row>
        <control type="label" label="Descripción" span="3"/>
        <control type="text" name="Bdl_BundleDescription" span="8" edit="true" required="[Ssm_IsBundle]=True"/>
      </row>
      <row>
        <control type="label" label="Precio" span="3"/>
        <control type="text" name="Bdl_BundlePrice" span="3" edit="true" format="0,0.00" required="[Ssm_IsBundle]=True"/>
      </row>
      <row>
        <control type="checkbox" source="True,False" name="Bdl_SurgeonIncluded" label="Cirujano Incluido" span="3" offset="3" edit="true"/>
        <control type="checkbox" source="True,False" name="Bdl_AnesthesiologistIncluded" label="Anestesiólogo Incluido" span="3" edit="true"/>
        <control type="checkbox" source="True,False" name="Bdl_AssistantIncluded" label="Ayudante Incluido" span="3" edit="true"/>
      </row>
      <row>
        <control type="checkbox" source="True,False" name="Bdl_RoomIncluded" label="Sala Incluido" span="3" offset="3" edit="true"/>
        <control type="checkbox" source="True,False" name="Bdl_MaterialIncluded" label="Material Incluido" span="3" edit="true"/>
        <control type="checkbox" source="True,False" name="Bdl_MedicationIncluded" label="Medicamentos Incluido" span="3" edit="true"/>
      </row>
      <row>
        <control type="modalbutton" name="btnUpdateSurgeryBundle" label="Actualizar" icon="cloud-upload"
          action="save|close|new"
          affector="none"
          capture="BundleSurgeryInfo" 
          confirm="Por favor confirme que quiere actualizar esta cirugía."
          dataupdate="UpdateScheduledSurgeries"
          appendupdate="surgeryGuid=[SurgeryGuid]"/>
      </row>
    </group>
  </section>
</partial>