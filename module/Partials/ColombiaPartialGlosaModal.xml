<partial>
  <!-- ==================================================================== -->
  <!-- 1. MAIN GLOSA HEADER & LINES DATAGRID                                -->
  <!-- ==================================================================== -->

  <section type="tabmodal" badge="none" name="mdlGlosaModal" title="Gestión de Glosa" size="medium">
    <group showif="never">
      <row>
        <!-- Load an existing Glosa Header -->
        <control type="hidden" name="GlosaGuid"
          datarequest="COLGetGlosas"
          appendrequest="GlosaGuid=[GlosaGuid]" 
          inject="grpGlosaHinfo"
          provoke="grdGlosaLines"/>
      </row>
    </group>
    <group name="grpGlosaHinfo">
      <columns>
        <!-- Left Column: Primary Glosa Metadata -->
        <column span="10">
          <row>
            <control type="label" label="Origen" span="2"/>
            <control type="select" name="Gls_CreationSource" span="3" readonly="true"
              source="Electronic,Manual" sourcelabels="Electrónica,Manual"/>
          </row>
          <row>
            <control type="label" label="Factura DIAN" span="2"/>
            <control type="text" name="Gls_InvoiceNumber" span="3" readonly="true"/>
            <control type="label" label="Referencia EPS" span="3"/>
            <control type="text" name="Gls_PayerGlosaReference" span="4" 
              required="true" edit="[Gls_Status]=Radicada|En_Auditoria"/>
          </row>
          <row>
            <control type="label" label="Fecha Radicación" span="2"/>
            <control type="date" name="Gls_RadicationDate" span="3" 
              required="true" edit="[GlosaGuid]="/>
            <control type="label" label="Límite Legal (SLA)" span="3"/>
            <control type="date" name="Gls_ResponseDeadlineDate" span="4" readonly="true"/>
          </row>
          <row>
            <control type="label" label="Estatus" span="2"/>
            <control type="select" span="3" name="Gls_Status" default="Radicada" edit="[GlosaGuid]="
              source="Radicada,En_Auditoria,Respondida,Aceptada,Levantada,Conciliada" 
              sourcelabels="Radicada,En Auditoría,Respondida,Aceptada,Levantada,Conciliada"/>
            <control type="label" label="Días Restantes" span="3"/>
            <control type="text" name="Gls_DaysRemaining" span="4" readonly="true"/>
          </row>
          <!-- Financial Rollups -->
          <row>
            <control type="label" label="Total Disputado" span="2"/>
            <control type="calc" name="Gls_TotalDisputedAmount" span="2" format="0,0" source="1*DisputedAmountTotal"/>
            <control type="label" label="Total Aceptado" span="2"/>
            <control type="calc" name="Gls_TotalAcceptedAmount" span="2" format="0,0" source="1*AcceptedAmountTotal"/>
            <control type="label" label="Total Defendido" span="2"/>
            <control type="calc" name="Gls_TotalDefendedAmount" span="2" format="0,0" source="1*DefendedAmountTotal"/>
          </row>
        </column>

        <!-- Right Column: Action Buttons -->
        <column span="2">
          <row>
            <!-- Submit Defense and trigger Node.js transmission payload -->
            <control type="button" name="btnSubmitGlosaResponse"
              reveal="[GlosaGuid]!+[Gls_Status]=Radicada|En_Auditoria+[Gls_CreationSource]=Electronic"
              span="12" icon="check" color="blue" label="Enviar Respuesta"
              action="save|close|new"
              capture="grpGlosaHinfo"
              confirm="¿Confirma que desea enviar la respuesta y la evidencia a la EPS?"
              dataupdate="COLUpdateGlosa"
              appendupdate="GlosaGuid=[GlosaGuid],ActionType=Respuesta_IPS,TargetStatus=Respondida"
              provoke="GlosaQueueList"/>
            <!-- Update Manual Glosa (Internal use only) -->
            <control type="button" name="btnUpdateGlosa"
              reveal="[GlosaGuid]!+[Gls_Status]=Radicada|En_Auditoria+[Gls_CreationSource]=Manual"
              span="12" icon="check" color="blue" label="Actualizar"
              action="save|close|new"
              capture="grpGlosaHinfo"
              confirm="¿Confirma que desea actualizar esta Glosa?"
              dataupdate="COLUpdateGlosa"
              appendupdate="GlosaGuid=[GlosaGuid]"
              provoke="GlosaQueueList"/>
          </row>
        </column>
      </columns>
    </group>

    <!-- Disputed Lines Grid -->
    <group>
      <row>
        <control type="buttongroup" name="btgGlosaView" span="4" default="Lines"
          source="Lines,Documents" sourcelabels="Lineas,Documentos"
          provoke="optGlosaGridList|options"/>
      </row>
      <row>
        <control name="optGlosaGridList" affector="btgGlosaView" type="options" span="12">
          
          <!-- Lines Grid -->
          <control type="datagrid" label="Detalle de Líneas Disputadas" name="grdGlosaLines"       
            searchable="true" rows="10" option="Lines" edit="edit"
            mode="batch"
            modalname="mdlAuditGlosaLine"
            datarequest="COLGetGlosaLines"
            appendrequest="GlosaGuid=[GlosaGuid]"        
            source="GlosaLineNumber,CupsCode,ItemDescription,GlosaCodeDescription,OriginalLineAmount,DisputedAmount,AcceptedAmount,DefendedAmount,LineStatus,IpsAuditResponse"
            sourcelabels="Linea,CUPS,Descripción,Motivo EPS,Valor Original,Disputado,IPS Acepta,IPS Defiende,Estatus"
            format="||||0,000|0,000|0,000|0,000"
            align="left|left|left|left|right|right|right|right|center"
            total="||||+|+|+|+"
            key="GlosaLineGuid"> 
            
            <!-- Consolidated Save Button: Only performs a batch update on edited rows -->
            <control type="button" name="btnUpdateGlosaLines" label="Guardar Líneas" icon="cloud-upload"
              action="batchupdate" color="green"
              confirm="Por favor, confirme que desea actualizar los cambios en la Glosa."
              capture="grdGlosaLines"
              dataupdate="InvoiceGlosaLines"
              skipbatchrow="[[Status]]=update"
              postwithout="Status"
              provoke="grdGlosaLines,grpGlosaHinfo"/>
          </control>
          
          <!-- Scanned Documents Grid -->
          <control type="datagrid" label="Documentos" name="grdGlosaAttachments"
              option="Documents" rows="10"
              fitrows="true"
              acctsvcreq="true"
              filter="Status=Active"
              datarequest="GetImagingOrderFilesByImagingOrderGuid"
              appendrequest="ImagingOrderGuid=[GlosaGuid]"
              source="DateEntered,FileType,Type,FileName,EnteredByFullName,Status"
              sourcelabels="Fecha y Hora,Tipo,Categoria,Documento,Entregado por,Estatus"
              translate="FileType,Status"
              align="left|left|left|left|left|left"
              format="datetime"
              sort="DateTimeEntered=desc"
              key="PhotoGuid"
              action="redirect|url"
              target="printables/uploadviewer.html"
              usesource="login"
              append="fileGuid=[[PhotoGuid]],fileType=[[FileType]]">
              
              <control type="button" name="btnRemoveDocument"
                label="Eliminar" icon="remove" color="red"
                showif="feature"
                action="save"
                acctsvc="true"
                confirm="Confirme que desea eliminar este archivo."
                dataupdate="UpdatePatientFilesByPhotoGuid"
                appendupdate="PhotoGuid=[[PhotoGuid]],Status=Canceled"
                provoke="grdGlosaAttachments"/>
              
              <control type="button" name="PO_ScanDocuments" label="Subir Documentos" icon="folder-open"
                append="ImagingOrderGuid=[GlosaGuid]"
                action="upload"
                filter="pdf,jpg,jpeg"
                provoke="grdGlosaAttachments"/>
          </control>
        </control>
      </row>
    </group>
  </section>

  <!-- ==================================================================== -->
  <!-- 2. AUDIT LINE MODAL (The Auditor's Workbench)                        -->
  <!-- ==================================================================== -->
  <section type="modal" title="Auditoría de Línea" name="mdlAuditGlosaLine">
    <group name="GlosaLineAuditData">  
      <row>  
        <!-- Read-only context from the EPS -->
        <control type="label" span="2" label="Código CUPS"/>
        <control type="text" span="4" name="CupsCode" readonly="true"/>
        <control type="label" span="2" label="Línea"/>
        <control type="text" span="2" name="DianLineNumber" readonly="true"/>
      </row>
      <row>    
        <control type="label" label="Descripción" span="2"/>
        <control type="textarea" span="10" name="ItemDescription" readonly="true" rows="1"/>
      </row>
      <row>
        <control type="label" label="Concepto EPS" span="2"/>
        <control type="text" span="10" name="GlosaCodeDescription" readonly="true"/>
      </row>
      <row>
        <control type="label" label="Observación EPS" span="2"/>
        <control type="textarea" span="10" name="PayerObservation" edit="[Gls_CreationSource]=Manual+[Gls_Status]=Radicada|En_Auditoria" rows="2"/>
      </row>
      <!-- Auditor Inputs -->
      <row>        
        <control type="label" label="Valor Disputado" span="2"/>       
        <control type="text" name="DisputedAmount" span="2" format="0,000" 
          edit="[Gls_CreationSource]=Manual+[Gls_Status]=Radicada|En_Auditoria"/>
      </row>
      <row>
        <control type="label" label="Aceptado (Concedido)" span="2"/>
        <control type="text" name="AcceptedAmount" span="2" default="0" format="0,000" 
          compare="[BalanceCheck]=0"
          edit="[Gls_Status]=Radicada|En_Auditoria" required="true"/>
        <control type="label" label="Defendido (Justificado)" span="3"/>
        <control type="text" name="DefendedAmount" span="2" default="0" format="0,000" 
          compare="[BalanceCheck]=0"
          edit="[Gls_Status]=Radicada|En_Auditoria" required="true"/>
      </row>
      <!-- Real-time calculation check to prevent over-allocation -->
      <row>
        <control type="label" label="Balance de Auditoría" span="2"/>
        <control type="calc" name="BalanceCheck" span="2" format="0,0" 
        source="DisputedAmount - (AcceptedAmount + DefendedAmount)"/>
      </row>
      <row>
        <control type="label" label="Defensa Médica IPS" span="2"/>
        <control type="textarea" name="IpsAuditResponse" span="10" rows="3"
          edit="[Gls_Status]=Radicada|En_Auditoria" 
          required="[DefendedAmount]>0"/>
      </row>
      <row>
        <control type="hidden" name="ru_Status" value="update" ignore="add" persist="true"/>
      </row>
    </group>
  </section>  
</partial>