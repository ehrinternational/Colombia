<partial>
  <row>
    <!-- Button to update patient visit info -->
    <control type="button" name="btnUpdatePatientVisit"
      span="12" icon="cloud-upload" label="Actualizar"
      reveal="[PatientVisitGuid]!"
      action="save"
      affector="none"
      capture="VisitInfo"
      acctsvc="true"
      dataupdate="UpdatePatientVisitNoDepartmentTracking"
      appendupdate="patientVisitUniqueId=[PatientVisitGuid]"
      provoke="PatientList"/>
  </row>
  <row>
    <control type="button" name="btnReports"
       reveal="[PatientId]!"
      span="12"
      icon="print" label="Informes"
      preset="Report_PatientId=[PatientId],Report_Type=Admitting,Report_PatientFirstName=[Consult_PatientFirstName],Report_PatientMiddleName=[Consult_PatientMiddleName],Report_PatientLastName=[Consult_PatientLastName]"
      trigger="ReportList,Report_VisitId"
      action="redirect" target="mdlReports"/>
  </row>
  <row>
    <control type="button" name="btnEmailPatient" reveal="[PatientId]!"
      span="12" icon="envelope" label="Email"
      preset="bmd_PatientId=[PatientId],
      bmd_PatientFirstName=[Consult_PatientFirstName],
      bmd_PatientMiddleName=[Consult_PatientMiddleName],
      bmd_PatientLastName=[Consult_PatientLastName],
      bmd_EmailAddress=[Consult_PatientEmail]"
      trigger="grdEmailAndText,bmd_PatientAttachmentGuids"   
      action="redirect" target="mdlSendWYSIWYGEmail"/>
  </row>
  <row>
    <control type="button" name="btnInitiateTextMessage" 
      reveal="[PatientId]!"
      span="12" icon="envelope" label="Enviar Texto"
      trigger="grdPhysicianMessages2"
      preset="Send_PhoneNumber=[Consult_PatientCellPhone],Send_PatientId=[PatientId]"
      action="redirect" target="mdlSendTextMessage"/>
  </row>
  <row>
    <!-- Admit patient with no open visit -->
    <control type="button" name="btnAdmitButton" label="Ingresar Paciente" span="12"
      reveal="[PatientId]!+[HasOpenVisit]=false+[Patient_Active]=true"
      color="orange" icon="cloud-upload"
      action="save" 
      confirm="Por favor confirme que quiere ingresar a este paciente."
      affector="PatientVisitGuid"
      setaffector="PatientVisitUniqueId"
      capture="VisitInfo"
      datainsert="InsertPatientVisitAllFields"
      appendinsert="copyDiagnosis=true,
        patientId=[PatientId],
        visitType=[DefaultAdmitType],
        hospitalService=Esperando,
        ambulatoryStatus=Outpatient,
        preAdmit=0,admitDateTime=(now),
        locationId=(facilityData.LocationId),
        readyForDischarge=false"
      set="HasOpenVisit=true,
        PatientVisit=[PatientVisitGuid],
        ReadyForDischarge=false,AllowDischarge=true"
      provoke="PatientVisitGuid,ButtonGroupSelect"/>
  </row>
  <row>
      <control type="hidden" name="AllowDischarge"/>
      <control type="button" name="btnDischargePatient"
        icon="home" label="Dar de alta" color="green" span="12"
        reveal="[PatientVisitGuid]!+[AllowDischarge]=true"
        confirm="Confirme que desea cerrar esta visita del paciente."
        action="save|close|new"
        acctsvc="true"
        dataupdate="UpdatePatientVisitNoDepartmentTracking"
        appendupdate="patientVisitUniqueId=[PatientVisitGuid],DischargeDateTime=(now),DischargedBy=(userName)"/>
    </row>
  <!-- Call the patient in the waiting room -->
  <partial link="Partials/ColombiaPartialCallPatientButton.xml"/>
  <!-- AI buttons -->
  <partial link="Partials/ColombiaPartialCLARAPhysicianButtons.xml"/>
</partial>