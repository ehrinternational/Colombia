 <partial>
  <!-- ECD forms with new, edit and cancel --> 
  <control type="datagrid" label="Documentos" name="SurgeryEcdForms"
    span="12" rows="5"
    searchable="true"
    action="redirect|url" 
    target="ecd/index.html"
    usesource="login"
    filter="MostRecent=true"
    append="ecdGuid=[[rowGuid]],patientid=[[PatientId]],patientvisit=[[PatientVisit]],ecdMode=review,department=[DepartmentGuidLookup]" 
    idle="[PatientId]=|reset"
    datarequest="GetCompletedPatientFormsForPriorVisits"
    appendrequest="patientId=[PatientId]"
    source="DateTimeEntered,RevisionId,Type,FormName,FullUserName,SignedByFullUserName"
    sourcelabels="Fecha y Hora,Modificado,Tipo,Documento,Ingresado por,Firmado por"
    align="left|left|left|left|left|left"
    format="datetime|boolean"
    translate="Type"
    sort="DateTimeEntered=desc"
    key="rowGuid">
    <control type="button" name="btnCombinedECDs" label="Visualizador DCEs" color="lightblue"
      reveal="[PatientId]!"
      action="redirect"
      target="mdlCombinedECDForms"
      trigger="hidGetPatientToDisplay"/>
    <control type="button" name="uploadECD" action="generateupload"
        mode="ecd" showif="feature" provoke="ScannedForms"
        append="ecdGuid=[[rowGuid]],patientid=[[PatientId]],patientvisit=[[PatientVisit]]"
        color="lightblue"
        label="Subir a Documentos"
        icon="cloud-upload"/>
      <control type="button" name="btnNewCEDForm1" label="Añadir Nuevo" icon="plus"
        onclose="Advertencia: No ha guardado este documento. ¿Todavía quiere salir?"
        reveal="[PatientId]!+[Surgery_PatientVisit]!"
        action="redirect|url" 
        target="ecd/index.html" 
        usesource="login"
        append="patientid=[PatientId],patientvisit=[PatientVisit]"
        provoke="EREcdForms"/>
      <control type="button" name="reviseECD1" 
        reveal="[PatientId]!"
        action="redirect|url" 
        target="ecd/index.html"
        onclose="Advertencia: No ha guardado este documento. ¿Todavía quiere salir?"
        usesource="login"
        mode="ecd"
        append="patientid=[[PatientId]],patientvisit=[[PatientVisit]],ecdMode=revise,department=[DepartmentGuidLookup],ecdGuid=[[rowGuid]]" 
        showif="feature"
        confirm="Por favor confirme que desea revisar este documento"
        label="Revisar"
        icon="refresh"
        provoke="EREcdForms"/>
      <!-- feature button to copy an ECD to a new one-->  
      <control type="button" name="btnCopyECD1" 
        reveal="[PatientId]!+[PatientVisitGuid]!" 
        action="redirect|url" 
        target="ecd/index.html"
        onclose="Advertencia: No ha guardado este documento. ¿Todavía quiere salir?"
        usesource="login"
        append="ecdMode=copy,patientid=[[PatientId]],patientvisit=[PatientVisitGuid],department=[DepartmentGuidLookup],ecdGuid=[[rowGuid]]" 
        showif="feature"
        confirm="Por favor confirme que desea copiar este documento"
        label="Copiar"
        icon="copy"
        provoke="EREcdForms"/>
      <control type="button" name="printECD2" label="Imprimir" action="print"
        usesource="login" mode="ecd" showif="feature"
        append="ecdGuid=[[rowGuid]],patientid=[[PatientId]],patientvisit=[[PatientVisit]],department=[DepartmentGuidLookup]"
        icon="print"/>
      <control type="button" name="printECD2NoDates" action="print"
        usesource="login" mode="ecd" showif="feature"
        reveal="(facilityData.HospitalShortName)%OCC"
        append="ecdGuid=[[rowGuid]],patientid=[[PatientId]],patientvisit=[[PatientVisit]],noAdmitDates=true"
        label="Imprimir no Fechas"
        icon="print"/>
  </control>
</partial>