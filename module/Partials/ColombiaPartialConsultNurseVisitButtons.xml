<partial>
    <row>
      <control type="hidden" name="CalendarVisitType"/>
      <!-- Admit patient with no open visit -->
      <control type="button" name="btnAdmitButton" label="Ingresar Paciente" span="12"
        reveal="[PatientId]!+[HasOpenVisit]=false+[Patient_Active]=true+[CalendarVisitType]=Telemedicine"
        color="orange" icon="cloud-upload" action="save" 
        confirm="Por favor confirme que quiere ingresar a este paciente."
        affector="PatientVisitGuid"
        setaffector="PatientVisitUniqueId"
        capture="VisitInfo"
        datainsert="InsertPatientVisitAllFields"
        appendinsert="copyDiagnosis=true,
          patientId=[PatientId],
          visitType=[DefaultAdmitType],
          hospitalService=Esperando,
          ambulatoryStatus=Outpatient,
          preAdmit=0,
          admitDateTime=(now),
          locationId=(facilityData.LocationId),
          readyForDischarge=false"
        set="HasOpenVisit=true,
          PatientVisit=[PatientVisitGuid],
          ReadyForDischarge=false,
          AllowDischarge=true"
        provoke="PatientVisitGuid,ButtonGroupSelect"/>
    </row>
    <row>
      <!-- Transfer patient to another department -->
      <control type="button" name="btnTransferPatient"
      reveal="[HasOpenVisit]=true+[PatientVisitGuid]!"
      span="12" icon="hospital" label="Transferir"
      color="orange" action="redirect"
      preset="Transfer2_DepartmentGuid=[DepartmentGuidLookup]"
      target="mdlTransferPatient"/>
    </row>
    <!-- Return patient to their prior department and service -->
    <row name="rowReturnPatientToPriorDepartmentAndService" reveal="[PriorDepartmentGuid]!+[PatientId]!+[PatientVisitGuid]!">
      <control type="button" name="btnReturnPatient" label="Dpto. previo"
        color="green" icon="move" span="12"
        affector="none" 
        action="save|close|new"
        confirm="Confirme que desea devolver a este paciente a su departamento y servicio anterior."
        dataupdate="UpdatePatientVisitAllFields"
        appendupdate="patientId=[PatientId],
          patientVisitUniqueId=[PatientVisitGuid],
          hospitalService=Esperando,
          departmentGuid=[PriorDepartmentGuid],
          departmentService=[PriorDepartmentService],
          DateTimeCalled=null,
          RoomService=null"/>
    </row>
    <row>
      <control type="button" name="btnMove"
        reveal="[HasOpenVisit]=true"
        span="12" icon="move" label="Mover"
        color="orange"
        action="redirect"
        target="mdlMovePatient"/>
    </row>
    <row name="rowReadyForDischargeButtons" reveal="HasOpenVisit=true">
      <control type="button" name="btnAltaMedica"
        reveal="ReadyForDischarge=true"
        span="12" icon="home" label="Alta Médica"
        color="green" action="redirect"
        trigger="GetReadyForDischarge"
        preset="Ready_PatientId=[PatientId],Ready_PatientVisitGuid=[PatientVisitGuid]"
        target="mdlReadyForDischarge"/>
      <control type="button" name="btnNoAltaMedica"
        reveal="ReadyForDischarge=false"
        span="12" icon="home" label="Alta Médica"
        color="grey" action="redirect"
        trigger="GetReadyForDischarge"
        preset="Ready_PatientId=[PatientId],Ready_PatientVisitGuid=[PatientVisitGuid]"
        target="mdlReadyForDischarge"/>
    </row>
</partial>