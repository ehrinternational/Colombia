<partial>
    <control type="datagrid" label="Cargos del Paciente" name="Charges_grdNewPatientCharges" rows="10"     
      searchable="true" option="Charges" action="redirect" target="mdlNewPatientCharge"
      acctsvcreq="true" 
      idle="[VisitSelect]=|reset"
      filter="Status=Active"
      datarequest="GetChargesByPatientVisit"     
      appendrequest="patientVisit=[VisitSelect],ClaimGuid=Patient,Status=Active"     
      source="TransactionDateTime,TransactionType,ChargeNumber,ItemName,TransactionQuantity,PerItemChargeAmount,DiscountAmount,TaxAmount,NetAmount"
      sourcelabels="Fecha,Tipo,Folio,Artículo,Cantidad,Precio,Descuento,Impuesto,Neto"
      translate="TransactionType"
      sort="TransactionDateTime=desc"
      format="datetime||||0,000.00|0,000|0,000|0,000|0,000"
      align="left|left|left|left|right|right|right|right|right"
      total="||||||+|+|+"
      key="TransactionGuid"
      onselectset="NewChargeGuid=[[TransactionGuid]]"
      onselect="NewChargeGuid,Ncg_SelectClaimGuid">
    <control type="button" name="btnNewPatientCharge" icon="plus" label="Añadir Nuevo"
      trigger="Ncg_SelectClaimGuid"
      preset="Ncg_SelectClaimGuid="
      action="redirect" target="mdlNewPatientCharge"/>
    </control>     
</partial>