<partial>
<section type="tabmodal" title="Solicitud de Cirugía" name="NewSurgeryRequestModal" badge="none">
    <group showif="never">
      <row>
        <!-- Get the surgery request information -->
        <control type="hidden" name="SurgeryRequest_PatientConsultGuid"
          acctsvcreq="true"
          datarequest="GetConsultRequestsByConsultRequestGuid"
          appendrequest="consultRequestGuid=[SurgeryRequest_PatientConsultGuid]"
          set="SurgeryRequest_PatientId=[[PatientId]]"
          inject="SurgeryRequest_grpConsultInfo"
          provoke="SurgeryRequest_PatientId"/>
        <!-- Get the patient info -->
        <control type="hidden" name="SurgeryRequest_PatientId"
          datarequest="GetPatientAllFields"
          appendrequest="PatientId=[SurgeryRequest_PatientId]"
          inject="SurgeryRequestPatientInfo"/>
        <control type="hidden" name="SetSurgeryRequestPatientId" 
          set="SurgeryRequest_PatientId=[PatientSearchResults]"
          provoke="SurgeryRequest_PatientId"/>
        <control type="button" name="btnCloseNewSurgeryRequestModal"
          action="close"/>
      </row>
    </group>
    <group name="SurgeryRequestPatientInfo" bgcolor="white">
      <columns>
        <column span="10">
          <!-- Partial prospect patient demographic information -->
          <row>
            <control type="hidden" name="SurgeryRequest_HasOpenVisit"/>
            <control type="hidden" name="SurgeryRequest_PatientVisit"/>
          </row>
          <row>
            <control type="label" label="" span="1"/>
            <control type="label" label="Expediente" align="left" span="2"/>
            <control type="label" label="Nombre(s)" align="left" span="3"/>
            <control type="label" label="Apellido Paterno" align="left" span="3"/>
            <control type="label" label="Apellido Materno" align="left" span="3"/>
          </row>
          <row>
            <control type="label" label="" span="2"/>
            <control type="text" name="SurgeryRequest_MedicalRecordNumber" span="1" readonly="true"/>
            <control type="text" name="SurgeryRequest_PatientFirstName" regex="^[A-ZÑ\s]+$" format="ucase" span="3" readonly="true"  />
            <control type="text" name="SurgeryRequest_PatientMiddleName" regex="^[A-ZÑ\s]+$" format="ucase" span="3" readonly="true"  />
            <control type="text" name="SurgeryRequest_PatientLastName" regex="^[A-ZÑ\s]+$" format="ucase" span="3" readonly="true" />
          </row>
          <row>
            <control type="label" label="Nacimiento" span="2" />
            <control type="date" name="SurgeryRequest_PatientDOB" span="2"  readonly="true"/>
            <control type="text" name="SurgeryRequest_PatientAge" span="2" readonly="true"/>
            <control type="label" label="Sexo" span="1" />
            <control type="select" 
              name="SurgeryRequest_PatientSex" span="2" 
              source="Male,Female,Indeterminate"
              readonly="true" 
              sourcelabels="Masculino,Femenino,Indeterminado"/>
            <control type="label" label="Sangre" span="1"/>
            <control type="select" name="SurgeryRequest_BloodType" span="2"
              source="A+,A-,B+,B-,O+,O-,AB+,AB-" readonly="true"/>
          </row>
          <row>      
            <control type="label" label="País Nacimiento" span="2"/>
            <control type="select" name="SurgeryRequest_Nationality" span="3" readonly="true"
              default="(facilityData.HospitalCountry)"
              sort="CountrySpanish=asc"
              datasource="GetCountries" 
              source="CountrySpanish,Code"
              trigger="[LastCountry]![SurgeryRequest_Nationality];SurgeryRequest_BirthPlace"/>
            <control type="label" label="Estado Nacimiento" span ="3"/>
            <control type="select" name="SurgeryRequest_BirthPlace" span="4" readonly="true"
              idle="SurgeryRequest_Nationality=" 
              datasource="GetStatesProvincesByCountryCode"
              source="Name,Code" explicit="true"
              append="countryCode=[SurgeryRequest_Nationality]"/>
          </row>
          <row>
            <control type="label" label="Celular" span="2"/>
            <control type="text" name="SurgeryRequest_PatientCellPhone" span="2" readonly="true" />
            <control type="label" label="Casa" span="1"/>
            <control type="text" name="SurgeryRequest_PtPhoneNumber" span="2" readonly="true" />
            <control type="label" label="Email" span="1"/>
            <control type="text" name="SurgeryRequest_PatientEmail" span="4" readonly="true"/>
          </row>
          <row>
            <control type="label" label="Parentesco" span="2"/>
            <control type="select" name="SurgeryRequest_Companion"
                span="4" readonly="true" 
                source="Institución,Padre,Madre,Hermana,Hermano,Abuelo,Abuela,Tía,Tío,Club Colombia,Primo,Prima,Sobrino,Hermanastro,Hermanastra,Tutor Legal,Ningún parentesco,Otros"/>
            <control type="label" label="Medio de Transporte" span="3"/>
            <control type="select" name="SurgeryRequest_Transportation" span="3" 
                source="Transporte público,coche propio,avión,otro" 
                readonly="true"/>
          </row>
          <row>
            <control type="label" label="Diagnostico por Familia" span="4"/>
            <control type="text" name="SurgeryRequest_FamilyDiagnosis" span="8" readonly="true"/>
          </row>
          <row>
            <control type="label" label="Estatus CRM" span="2" />
            <control type="select" name="SurgeryRequest_CRMStatus" span="4" readonly="true"
              acctsvc="true" explicit="true" 
              filter="Active=true"
              datasource="GetCRMStatusTypes"
              source="StatusName,StatusGuid"/>
            <control type="label" label="Establecimiento" span="2"/>
            <control type="text" name="Surgery_Sector" span="4" readonly="true"/> 
          </row>
          <row>
            <control type="label" label="Notas" span="2"/>
            <control type="textarea" name="SurgeryRequest_CRMNotes" span="10" rows="1" edit="true"/>
          </row>
          <row>
            <control type="label" label="Observaciones" span="2" />
            <control type="textarea" name="SurgeryRequest_Remarks" span="10" rows="1" edit="true"/>
          </row>
        </column>
        <column span="2">
          <row>
            <control type="button" name="btnFindSurgeryRequestPatient" span="12"
              reveal="[SurgeryRequest_PatientId]="
              icon="search" label="Buscar Paciente" action="redirect"
              preset="PatientSearchSource=4"
              target="mdlFindPatients"/>
          </row>
          <row name="rowSurgeryRequestUpdate" reveal="[SurgeryRequest_PatientId]!">
            <!--Save patient information-->
            <control type="button" 
              name="btnSurgeryRequestPatientUpdate"
              span="12" label="Actualizar Paciente" icon="cloud-upload"
              affector="SurgeryRequest_PatientId"
              setaffector="RecordUniqueId"
              capture="SurgeryRequestPatientInfo" 
              action="save"
              confirm="Por favor confirme que quiere actualizar a este paciente."
              dataupdate="UpdatePatient"
              appendupdate="PatientId=[SurgeryRequest_PatientId]"/>
          </row>
        </column>
      </columns>
    </group>
    <!-- Consult request group -->
    <group name="SurgeryRequest_grpConsultInfo">
      <row>
        <control type="label" span="3" label="Originado por"/>
        <control type="text" name="SurgeryRequest_EnteredByFullName" span="3" readonly="true"/>
        <control type="datetime" span="3" name="SurgeryRequest_DateTimeEntered" readonly="true" default="now"/>
        <control type="label" span="1" label="Estatus"/>
        <control type="select" span="2"
          name="SurgeryRequest_ConsultRequestStatus"  
          source="Active,Approved,Scheduled,Rejected,Completed,Canceled"
          sourcelabels="Esperando,Aprobado,Programada,Rechazada,Completa,Cancelado"
          default="Active" readonly="true"
          required="true"/>
      </row>
      <!-- Folio number (record number of Consult Request), Date and Priority -->
      <row>
        <control type="label" span="3" label="Fecha de Solicitud"/>
        <control type="datetime" span="3" name="SurgeryRequest_ConsultRequestDateTime" 
          edit="[SurgeryRequest_ConsultRequestStatus]=Active" required="true" default="now"
          compare="≥now-1"/>
        <control type="label" span="1" label="Prioridad"/>
        <control type="select" span="2" name="SurgeryRequest_ConsultRequestPriority"
          source="Normal,Medium,Emergency"  
          sourcelabels="Normal,Medio,Crítico"
          edit="[SurgeryRequest_ConsultRequestStatus]=Active" default="Normal"
          required="true"/>
      </row>
      <row>
        <control type="label" label="Tipo de Consulta" span="3"/>
        <control type="buttongroup" name="Surgery_AttentionType" span="4"
          source="Ambulatory,Hospital" sourcelabels="Ambulatorio,Hospitalización" edit="true" required="true"/>
        <control type="label" span="2" label="Folio"/>
        <control type="text" span="2" name="SurgeryRequest_ConsultNumber" readonly="true"/>
      </row>
      <!-- Consult request types (SIC,OA, and DAU) and ConsultFileReport (required) -->
      <row>
        <control type="label" span="3" label="Tipo de Atención"/>
        <control type="select" span="3" name="SurgeryRequest_SurgeryType" 
          source="Ortopedia,Mano,Columna,Retiro,Plástica,Plástica Reconstructiva,Cirugía con Laser,No ortopédica,Especial"
          default="true"  edit="[SurgeryRequest_ConsultRequestStatus]=Active"
          required="true"/>
        <control type="label" label="Tipo de Anestesia" span="3"/>
        <control type="select" name="SurgeryView_AnesthesiaType" span="3" edit="true"
          source="A. Gral. Inha,A. Gral IV,TIVA,T.E,TE + BPC,TE + BPL,TE + BPB,ML,ML + BPC,
          ML + BPL,ML + BPB,ML + BPOPLITEO,BPC,BPL.BPDL,BTP,BSA,BPB,SED + LOCAL,
          V. ANESTÉSICA /TRAQUEOSTOMIA,BLOQUEO PENEANO,BLOQUEO PEDIO"/>      
      </row>
      <!-- Consult  diagnosis (optional)-->
      <row>
        <control type="label" label="Hipótesis Diagnóstica o Diagnóstico" span="4"/>
        <control type="typeahead" name="SurgeryRequest_ConsultRequestDiagnosis" span="8" 
          edit="[SurgeryRequest_ConsultRequestStatus]=Active" 
          datasource="GetICD10CodesSearchByTerm"
          term="term"
          source="ICD10CodeDescription,ICD10Code"/>
      </row>
      <row>
        <control type="label" label="Confirmación Diagnóstica" span="4"/>
        <control type="typeahead" name="SurgeryRequest_ConfirmedDiagnosis" span="8" 
          edit="[SurgeryRequest_ConsultRequestStatus]=Active" 
          datasource="GetICD10CodesSearchByTerm"
          term="term" required="true"
          source="ICD10CodeDescription,ICD10Code"/>
      </row>
      <row>
        <control type="label" label="Procedimiento Primario" span="3"/>
        <control type="typeahead" name="Sreq_ProcedureName,Sreq_ProcedureGuid" span="9"
          edit="[SurgeryRequest_ConsultRequestStatus]=Active"
          source="ProcedureDescription,ProcedureGuid"
          datasource="GetProceduresFromProcedureAdministration"
          term="procedureDescription" required="true"/>
      </row>
      <row>
        <control type="label" label="Procedimiento Secundario" span="3"/>
        <control type="typeahead" name="Sreq_SecondaryProcedureName,Sreq_SecondaryProcedure" span="9"
          edit="[SurgeryRequest_ConsultRequestStatus]=Active"
          source="ProcedureDescription,ProcedureGuid"
          datasource="GetProceduresFromProcedureAdministration"
          term="procedureDescription"/>
      </row>
      <row name="rowSrqThirdProcedure" reveal="[Sreq_SecondaryProcedure]!">
        <control type="label" label="Procedimiento Adicional" span="3"/>
        <control type="typeahead" name="Sreq_ProcedureName3,Sreq_Procedure3" span="9"
          edit="[SurgeryRequest_ConsultRequestStatus]=Active"
          source="ProcedureDescription,ProcedureGuid"
          datasource="GetProceduresFromProcedureAdministration"
          term="procedureDescription"/>
      </row>
      <row name="rowSrqFourthProcedure" reveal="[Sreq_ProcedureName3]!">
        <control type="label" label="Procedimiento Adicional" span="3"/>
        <control type="typeahead" name="Sreq_ProcedureName4,Sreq_Procedure4" span="9"
          edit="[SurgeryRequest_ConsultRequestStatus]=Active"
          source="ProcedureDescription,ProcedureGuid"
          datasource="GetProceduresFromProcedureAdministration"
          term="procedureDescription"/>
      </row>
      <row name="rowSrqFifthProcedure" reveal="[Sreq_ProcedureName4]!">
        <control type="label" label="Procedimiento Adicional" span="3"/>
        <control type="typeahead" name="Sreq_ProcedureName5,Sreq_Procedure5" span="9"
          edit="[SurgeryRequest_ConsultRequestStatus]=Active"
          source="ProcedureDescription,ProcedureGuid"
          datasource="GetProceduresFromProcedureAdministration"
          term="procedureDescription"/>
      </row>
      <row name="rowSrqSixthProcedure" reveal="[Sreq_ProcedureName5]!">
        <control type="label" label="Procedimiento Adicional" span="3"/>
        <control type="typeahead" name="Sreq_ProcedureName6,Sreq_Procedure6" span="9"
          edit="[SurgeryRequest_ConsultRequestStatus]=Active"
          source="ProcedureDescription,ProcedureGuid"
          datasource="GetProceduresFromProcedureAdministration"
          term="procedureDescription"/>
      </row>
      <row name="rowSrqSeventhProcedure" reveal="[Sreq_ProcedureName6]!">
        <control type="label" label="Procedimiento Adicional" span="3"/>
        <control type="typeahead" name="Sreq_ProcedureName7,Sreq_Procedure7" span="9"
          edit="[SurgeryRequest_ConsultRequestStatus]=Active"
          source="ProcedureDescription,ProcedureGuid"
          datasource="GetProceduresFromProcedureAdministration"
          term="procedureDescription"/>
      </row>
      <row>
        <control type="label" label="Duración" badge="min" span="3"/>
        <control type="integer" name="SurgeryRequest_Duration" span="1" required="true"
          edit="[SurgeryRequest_ConsultRequestStatus]=Active"/>
        <control type="label" label="Plano" span="1"/>
        <control type="select" name="SurgeryRequest_Laterality" span="2"
          source="1,2,3" required="true"
          sourcelabels="1 Izquierdo,2 Derecho,3 Bilateral" 
          edit="true"/>
      </row>
      <!-- Observations (notes) (optional)-->
      <row>
        <control type="label" label="Observaciones" span="3"/>
        <control type="textarea" name="SurgeryRequest_ConsultNote" rows="1" span="9" edit="[SurgeryRequest_ConsultRequestStatus]=Active"/>
      </row>
      <row name="SurgeryRequest_rowAssignedPhysician">
        <!-- Originating physician (required)-->
        <control type="label" span="3" label="Médico"/>
        <control type="select" name="SurgeryRequest_ConsultRequestAssignedToId" span="5"
          namefield="ConsultRequestAssignedToName"
          acctsvc="true" searchable="true"
          datasource="GetUsersByAttributes" 
          append="LocationId=(facilityData.LocationId),role=Physician" 
          source="UserFirstMiddleLast,UserId"
          edit="[SurgeryRequest_ConsultRequestStatus]=Active" 
          required="true"/>
      </row>
      <row>
        <!-- Originating physician (required)-->
        <control type="label" span="3" label="Aprobado por"/>
        <control type="select" name="SurgeryRequest_ApprovedBy" span="5"
          acctsvc="true" searchable="true"
          datasource="GetUsersByAttributes" 
          append="LocationId=(facilityData.LocationId),role=Physician" 
          source="UserFirstMiddleLast,UserId"
          edit="[SurgeryRequest_ConsultRequestStatus]=Active"/>
      </row>
      <row name="grpApproveSurgeryRequest" reveal="[SurgeryRequest_ConsultRequestStatus]=Active">
        <control type="label" label="NIP" span="3"/>
        <control type="password" name="ApprovingUserPIN" span="1" edit="true"/>
      </row>
    </group>
    <group>
      <row>
        <!-- Save and close new records -->
        <control type="modalbutton" name="SurgeryRequestSaveAndClose"
          reveal="[SurgeryRequest_PatientConsultGuid]=+[SurgeryRequest_PatientId]!+[SurgeryRequest_ApprovedBy]="
          color="green" label="Guardar" icon="cloud-upload" 
          action="save|close|new"
          affector="none"
          acctsvc="true"
          capture="SurgeryRequest_grpConsultInfo"
          datainsert="InsertConsultRequests"
          appendinsert="ConsultType=Surgery,
            LocationId=(facilityData.LocationId),
            PatientId=[SurgeryRequest_PatientId],
            PatientFirstName=[SurgeryRequest_PatientFirstName],
            PatientMiddleName=[SurgeryRequest_PatientMiddleName],
            PatientLastName=[SurgeryRequest_PatientLastName],
            PatientDOB=[SurgeryRequest_PatientDOB],
            PatientSex=[SurgeryRequest_PatientSex]"
          provoke="SurgeryRequestList,ConsultList"/>
         <!-- Save and close new records -->
        <control type="modalbutton" name="SurgeryRequestSaveApproveAndClose"
          reveal="[SurgeryRequest_PatientConsultGuid]=+[SurgeryRequest_PatientId]!+[SurgeryRequest_ApprovedBy]!"
          color="green" label="Guardar y Aprobar" icon="cloud-upload" 
          action="save"
          affector="SurgeryRequest_PatientConsultGuid"
          setaffector="ConsultRequestGuid"
          acctsvc="true"
          capture="SurgeryRequest_grpConsultInfo"
          confirm="Por favor, confirma que desea aprobar esta solicitud de cirugía nuevo"
          confirmrequest="VerifyThisUsersPin"
          appendconfirm="pin=[ApprovingUserPIN],userIdToVerify=[SurgeryRequest_ApprovedBy]"
          confirmresponse="value=Correct Pin|Este NIP no es válido!"
          datainsert="InsertConsultRequests"
          appendinsert="ConsultType=Surgery,
            LocationId=(facilityData.LocationId),
            PatientId=[SurgeryRequest_PatientId],
            PatientFirstName=[SurgeryRequest_PatientFirstName],
            PatientMiddleName=[SurgeryRequest_PatientMiddleName],
            PatientLastName=[SurgeryRequest_PatientLastName],
            PatientDOB=[SurgeryRequest_PatientDOB],
            PatientSex=[SurgeryRequest_PatientSex],
            AdminApproved=true,
            AdminApproval=Approved,
            AdminApprovedBy=[SurgeryRequest_ApprovedBy],
            AdminApprovedDateTime=(dateTimeNow)"
          set="NewSurgeryRequestStatus=Approved"
          provoke="btnSaveNewStatus"/>
        <!-- update an existing record -->
        <control type="modalbutton" name="SurgeryRequestUpdateAndClose"
          reveal="[SurgeryRequest_PatientConsultGuid]!+[SurgeryRequest_ConsultRequestStatus]=Active"
          color="green" label="Actualizar" icon="cloud-upload" 
          action="save|close|new"
          affector="none"
          acctsvc="true"
          capture="SurgeryRequest_grpConsultInfo"
          dataupdate="UpdateConsultRequests"
          appendupdate="ConsultRequestGuid=[SurgeryRequest_PatientConsultGuid],PatientFirstName=[SurgeryRequest_PatientFirstName],PatientMiddleName=[SurgeryRequest_PatientMiddleName],PatientLastName=[SurgeryRequest_PatientLastName],PatientDOB=[SurgeryRequest_PatientDOB],PatientSex=[SurgeryRequest_PatientSex]"
          provoke="SurgeryRequestList,ConsultList"/>
        <!-- Approve an existing record -->
        <control type="modalbutton" name="SurgeryRequestAdminApproveAndClose"
          reveal="[SurgeryRequest_ConsultRequestStatus]=Active+[SurgeryRequest_PatientConsultGuid]!"
          color="yellowgreen" label="Aprobar" icon="thumbs-up" 
          action="save"
          affector="none"
          acctsvc="true"
          confirm="Por favor, confirma que desea aprobar esta solicitud de cirugía"
          confirmrequest="VerifyThisUsersPin"
          appendconfirm="pin=[ApprovingUserPIN],userIdToVerify=[SurgeryRequest_ApprovedBy]"
          confirmresponse="value=Correct Pin|Este NIP no es válido!"
          capture="SurgeryRequest_grpConsultInfo"
          dataupdate="UpdateConsultRequests"
          appendupdate="ConsultRequestGuid=[SurgeryRequest_PatientConsultGuid],
            AdminApproved=true,
            AdminApproval=Approved,
            AdminApprovedBy=[SurgeryRequest_ApprovedBy],
            AdminApprovedDateTime=(dateTimeNow)"
          set="NewSurgeryRequestStatus=Approved"
          provoke="btnSaveNewStatus"/>
        <!-- Schedule a Surgery from a surgery wait list -->
        <control type="modalbutton" name="btnScheduleSurgeryFromWaitList"
          icon="calendar" label="Programar" color="green"
          reveal="[SurgeryRequest_PatientConsultGuid]!+[SurgeryRequest_ConsultRequestStatus]=Approved"
          preset="DefaultSurgeryRequestGuid=[SurgeryRequest_PatientConsultGuid]"
          trigger="SurgeryTimes|resource"
          action="redirect"
          target="tabSurgeryCalendarAppointments"/>
        <!-- Reject an existing record -->
        <control type="modalbutton" name="SurgeryRequest_RejectConsultRequest"
          reveal="[SurgeryRequest_PatientConsultGuid]!+[SurgeryRequest_ConsultRequestStatus]=Active"
          color="red" label="Rechazar" icon="remove" 
          action="redirect"
          target="mdlReasonToRejectSurgery"/>
        <!-- Reject an existing record -->
        <control type="modalbutton" name="SurgeryRequest_CancelConsultRequest"
          reveal="[SurgeryRequest_PatientConsultGuid]!+[SurgeryRequest_ConsultRequestStatus]!Active|Canceled|Rejected"
          color="red" label="Cancelar" icon="remove"
          confirm="Por favor, confirma que desea cancelar esta solicitud de cirugía"
          set="NewSurgeryRequestStatus=Canceled"
          action="trigger"
          provoke="btnSaveNewStatus"/>
      </row>
      <!-- Save new status of Physician and close -->
      <row showif="never">
        <control type="hidden" name="NewSurgeryRequestStatus"/>
        <control type="button" name="btnSaveNewStatus"
          action="save|close|new"
          acctsvc="true"
          affector="none"
          dataupdate="UpdateConsultRequests"
          appendupdate="ConsultRequestGuid=[SurgeryRequest_PatientConsultGuid],
            ConsultRequestStatus=[NewSurgeryRequestStatus]"
          provoke="SurgeryRequestList"/>
      </row>
    </group>
  </section>
  <!-- Modal for surgeon to reject a surgery request -->
  <section type="tabmodal" name="mdlReasonToRejectSurgery" title="Motivo del Rechazo" badge="none" size="small">
    <group name="grpReasonToRejectSurgery">
      <row>
          <control type="label" label="Motivo" span="3"/>
          <control type="textarea" name="SurgeryRequest_AdminReason" span="8" rows="2" required="true" reveal="[SurgeryRequest_ConsultRequestStatus]=Active"/>
          <control type="textarea" name="SurgeryRequest_PhysicianReason" span="8" rows="2" required="true" reveal="[SurgeryRequest_ConsultRequestStatus]=Physician"/>
          <control type="textarea" name="SurgeryRequest_DirectorReason" span="8" rows="2" required="true" reveal="[SurgeryRequest_ConsultRequestStatus]=Director"/>
      </row>
      <row>
        <control type="modalbutton" name="btnSaveReasonToRejectSurgery" 
          label="Rechazar" icon="remove" color="red"
          action="save|close|new"
          capture="grpReasonToRejectSurgery"
          acctsvc="true"
          affector="none"
          dataupdate="UpdateConsultRequests"
          appendupdate="ConsultRequestGuid=[SurgeryRequest_PatientConsultGuid],
          [SurgeryRequest_ConsultRequestStatus]=Active;AdminApproval=Rejected,
          [SurgeryRequest_ConsultRequestStatus]=Active;AdminApprovedBy=(userName),
          [SurgeryRequest_ConsultRequestStatus]=Active;AdminApproved=true,
          [SurgeryRequest_ConsultRequestStatus]=Physician;PhysicianApproval=Rejected,
          [SurgeryRequest_ConsultRequestStatus]=Physician;PhysicianApprovedBy=(userName),
          [SurgeryRequest_ConsultRequestStatus]=Physician;PhysicianApproved=true,
          [SurgeryRequest_ConsultRequestStatus]=Director;DirectorApproval=Rejected,
          [SurgeryRequest_ConsultRequestStatus]=Director;DirectorApprovedBy=(userName),
          [SurgeryRequest_ConsultRequestStatus]=Director;DirectorApproved=true,
          ConsultRequestStatus=Rejected"
          provoke="SurgeryRequestList,btnCloseNewSurgeryRequestModal"/>
      </row>
    </group>
  </section>
  
  </partial>