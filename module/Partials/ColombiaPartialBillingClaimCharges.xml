<partial>
    <control type="datagrid" label="Cargos del Paciente" name="Clm_grdNewPatientCharges" rows="10"     
      searchable="true"                          
      option="Charges"
      acctsvcreq="true" 
      idle="[VisitSelect]=|reset"
      filter="Status=Active"
      datarequest="GetChargesByPatientVisit"     
      appendrequest="patientVisit=[VisitSelect],ClaimGuid=[ClaimGuid]"     
      source="TransactionDateTime,ChargeNumber,ItemName,TransactionQuantity,PerItemChargeAmount,DiscountAmount,TaxableAmount,TaxAmount,Retention,NetAmount"
      sourcelabels="Fecha,Folio,Artículo,Cantidad,Precio,Descuento,Gravable,Impuesto,Retención,Total"
      translate="Status"
      sort="TransactionDateTime=desc"
      format="datetime|||0,000.00|0,000.00|0,000.00|0,000.00|0,000.00|0,000.00|0,000.00"
      align="left|left|left|right|right|right|right|right|right|right"
      total="|||||+|+|+|+|+|+"
      key="TransactionGuid">
    </control>     
</partial>