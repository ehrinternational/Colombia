<partial>
  <control type="datagrid" label="Convenios de la Atención" name="grdPatientClaims" rows="5" 
    action="redirect"
    target="mdlNewClaims"
    option="PayerClaims"
    acctsvcreq="true"
    idle="[VisitSelect]=|reset"
    datarequest="GetPayerClaimsByPatientVisit"
    appendrequest="patientVisit=[VisitSelect]"
    source="ClaimDate,ClaimNumber,ClaimAuthorization,Status,PayerName,Notes"
    sourcelabels="Fecha,Folio,Autorización,Estatus,Pagador,Notas"      
    translate="Status"               
    key="ClaimGuid"
    align="||left|left|left|left"
    format="datetime"
    onselectset="ClaimGuid=[[ClaimGuid]]"
    onselect="ClaimGuid">
    <control type="button" name="btnInsertNewClaim" label="Añadir Nuevo" icon="plus"
      reveal="[VisitSelect]!"
      preset="[Clm_PatientVisit]=[VisitSelect],
      [Clm_PatientId]=[PatientId]"
      action="redirect" target="mdlNewClaims"/>
    </control>
</partial>