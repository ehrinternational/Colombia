<partial>
  <!-- Billing payer claims modal -->
  <section type="tabmodal" title="Convenios de la Atención" name="mdlNewClaims" badge="none" >
    <group showif="never">
      <row>
        <!-- get a payer claim and display -->
        <control type="hidden" name="ClaimGuid"
          acctsvcreq="true"
          datarequest="GetPayerClaimByClaimGuid"
          appendrequest="ClaimGuid=[ClaimGuid]"
          inject="NewClaimsInfo"
          provoke="Clm_PayerGuid"/>
        <control type="button" name="btnEnableButtons" action="trigger" 
          enable="btnInsertPayerDIANInvoice"/>
        <!-- store recalculated -->
        <control type="hidden" name="Clm_Recalculated" default="false"/>
        <control type="hidden" name="Clm_DateTimeProcessed"/>
      </row>
    </group>
    <group name="NewClaimsInfo">
      <columns>
        <column span="10">
          <subset>
            <row>
              <control type="hidden" name="Clm_PlanGuid"/>
              <control type="hidden" name="Clm_PatientVisit"/>
              <control type="hidden" name="Clm_PatientId"/>
            </row>
            <row>
              <control type="label" label="Folio" span="3"/>
              <control type="text" name="Clm_ClaimNumber" readonly="true" span="3" />
              <control type="label" label="Fecha" span="3"/>
              <control type="date" name="Clm_ClaimDate" span="3" default="now" 
                edit="[Clm_Status]=Pending+[Clm_Recalculated]=false"/>
            </row>
            <row>
              <control type="label" label="Estatus" span="3"/>
              <control type="select" name="Clm_Status" required="true" 
                sourcelabels="Pendiente,Facturada,Establecido,Cancelado" 
                source="Pending,Submitted,Settled,Canceled" 
                readonly="true" span="3" default="Pending" />
              <control type="label" label="Ordinal" span="3"/>
              <control type="buttongroup" name="Clm_BatchNumber" edit="true" source="1,2,3" default="1" span="3"/>
            </row>
            <row>
              <control type="label" label="Convenio del Paciente" span="3"/>
              <control type="select" name="Clm_PayerGuid" span="9" edit="[ClaimGuid]="
                filter="Active=true" required="true" explicit="true" 
                datarequest="GetPatientPayers"
                appendrequest="PatientId=[PatientId]"
                source="PayerName,PatientPayerGuid"/>
            </row>
            <row> 
              <control type="label" span="3" label="Autorización"/>
              <control name="Clm_ClaimAuthorization" type="text" span="3" edit="true" 
                required="[Pld_RequiresAuthorization]=True"/>
              <control type="label" span="3" label="Fecha de Autorización"/>
              <control name="Pl3_AthorizationDate" type="date" span="3" edit="true" 
                required="[Pld_RequiresAuthorization]=True"/>
            </row>
          </subset>
        </column>
        <column span="2">
          <subset>
          <row>
            <control type="button" name="btnInsertNewPayerClaim" span="12" label="Continuar" 
              icon="cloud-upload" action="save" color="green"
              reveal="[ClaimGuid]="
              acctsvc="true"
              affector="ClaimGuid"
              setaffector="ClaimGuid"
              capture="NewClaimsInfo"
              datainsert="InsertPayerClaim"/>
          </row>
          <!-- Update a payer claim -->
          <row>
            <control type="button" name="btnUpdatePayerClaim" span="12" label="Actualizar" icon="cloud-upload" 
              reveal="[ClaimGuid]!+[Clm_Status]=Pending"
              action="save"
              acctsvc="true"
              capture="NewClaimsInfo"
              affector="ClaimGuid"
              setaffector="ClaimGuid"
              dataupdate="UpdatePayerClaim"
              appendupdate="ClaimGuid=[ClaimGuid]"/>
          </row>
          <row>
            <control type="button" span="12" name="btnRecalculatePayerClaim" icon="refresh" label="Recalcular"
              reveal="[ClaimGuid]!+[Clm_Status]=Pending"
              action="save"
              acctsvc="true"
              capture="NewClaimsInfo"
              affector="ClaimGuid"
              setaffector="ClaimGuid"
              dataupdate="UpdatePayerClaim"
              appendupdate="ClaimGuid=[ClaimGuid]"
              provoke="btnLiquidateClaim"/>
           </row>
          <row showif="never">
            <!-- Liquidate surgeries -->
            <control type="button" name="btnLiquidateClaim"
              action="save" 
              acctsvc="true"
              datainsert="COLLiquidateSurgeries"
              appendinsert="patientVisit=[VisitSelect],TargetClaimGuid=[ClaimGuid]"
              provoke="btnLiquidateProceduresClaim"/>
            <!-- Liquidate procedures -->
            <control type="button" name="btnLiquidateProceduresClaim"
              action="save" 
              acctsvc="true"
              datainsert="COLLiquidateProcedures"
              appendinsert="patientVisit=[VisitSelect],TargetClaimGuid=[ClaimGuid]"
              provoke="btnLiquidateDiagnosticsClaim"/>
            <!-- Liquidate diagnostics -->
            <control type="button" name="btnLiquidateDiagnosticseClaim"
              action="save" 
              acctsvc="true"
              datainsert="COLLiquidateDiagnostics"
              appendinsert="patientVisit=[VisitSelect],TargetClaimGuid=[ClaimGuid]"
              provoke="btnLiquidateRoomChargesClaim"/>
            <!-- Liquidate room charges -->
            <control type="button" name="btnLiquidateRoomChargesClaim"
              action="save" 
              acctsvc="true"
              datainsert="COLLiquidateRoomCharges"
              appendinsert="patientVisit=[VisitSelect],TargetClaimGuid=[ClaimGuid]"
              provoke="btnLiquidateMedicationsClaim"/>
              <!-- Liquidate medications -->
            <control type="button" name="btnLiquidateMedicationsClaim"
              action="save" 
              acctsvc="true"
              datainsert="COLLiquidateMedications"
              appendinsert="patientVisit=[VisitSelect],TargetClaimGuid=[ClaimGuid]"
              provoke="btnScrubPatientInvoiceClaim"/>
            <!-- Scrub patient invoice -->
            <control type="hidden" name="btnScrubPatientInvoiceClaim" 
              acctsvcreq="true"
              datarequest="COLInvoiceScrubber"
              appendrequest="patientVisit=[VisitSelect],TargetClaimGuid=[ClaimGuid]"
              set="[btnScrubPatientInvoice]=;ClaimCalculated=True"
              provoke="Charges_grdNewPatientCharges|active,[btnScrubPatientInvoice]!;btnDisplayInvoiceErrors"/>
            <control type="button" name="btnDisplayInvoiceErrors" action="redirect" target="mdlInvoiceErrors"
              preset="[dsp_ClaimGuid]=Patient,[dsp_PatientVisit]=[VisitSelect]" trigger="grdDisplayErrors"/>
          </row>
          <!-- Insert a DIAN invoice for Colombia facilities -->
          <row>
            <control type="button" span="12" name="btnInsertPayerDIANInvoice"
              icon="cloud-upload" label="Procesar" color="yellowgreen"
              reveal="{[Clm_Status]=Pending+[Clm_Recalculated]=true+[ClaimGuid]!+[Clm_PayerNetAmount]»0}"
              action="trigger"
              provoke="btnCompleteDIANInvoice"/>
          </row>
          <row showif="never">
            <control type="button" name="btnCompleteDIANInvoice"
              disable="btnInsertPayerDIANInvoice"
              action="save"
              affector="none"
              acctsvc="true"
              datainsert="COLInsertDIANInvoice"
              appendinsert="PatientVisit=[VisitSelect],ClaimGuid=[ClaimGuid]"
              set="Clm_Status=Submitted"/>
          </row>
          <!-- Set the status on a claim to settled -->
          <row>
            <control type="button" name="btnSettleClaim" span="12"
              label="Establecido" icon="cloud-upload" action="save|close|new"
              reveal="[ClaimGuid]!+[Clm_Status]=Submitted"
              acctsvc="true" 
              confirm="Confirme que desea resolver este Convenio de la Atención."
              compare="[Clm_ClaimBalance]=0|El saldo de la factura debe ser cero para marcar el pago."
              dataupdate="UpdatePayerClaim"
              appendupdate="ClaimGuid=[ClaimGuid],Status=Settled"
              provoke="gridPayerclaims"/>
          </row>
          <!-- cancel a payer claim with no charges -->
          <row>
            <control type="button" name="btnCancelClaim" span="12"
              label="Cancelar" icon="remove" action="save|close|new" color="red"
              reveal="[ClaimGuid]!+[Clm_Status]=Pending+[NetAmountTotal]=0"
              acctsvc="true" 
              confirm="Confirme que desea cancelar este Convenio de la Atención."
              dataupdate="UpdatePayerClaim"
              appendupdate="ClaimGuid=[ClaimGuid],Status=Canceled"
              provoke="gridPayerclaims"/>
          </row>
          <row>
            <!--  Button to print claim invoice summary-->
            <control type="button" name="btnPrintClaimInvoice" 
              label="Cuenta Solicitud" icon="print" span="12" 
              reveal="[ClaimGuid]!"
              action="print" mode="report" 
              append="id=be61e526b62,HospitalGuid=(facilityData.HospitalGuid),FacilityId=(facility),ClaimGuid=[ClaimGuid],UserName=(userName),CurrentDateTime=(dateTimeNow)"/>            
          </row>
          <row>
            <control type="button" name="mbtDisplayPlanDetails2" label="Detalles del Plan" icon="search" span="12"
              action="redirect"
              target="mdlDisplayPlan"
              preset="PlanGuid=[Clm_PlanGuid]"
              trigger="PlanGuid"/>
          </row> 
            </subset>
           </column>
          <column span="12">
          <!-- Claim related tables -->
          <subset name="subClaimTotals" bgcolor="white" reveal="[FileName]=PatientBilling">
            <row>
              <control type="label" label="Cargos" span="2"/>
              <control type="calc" name="Clm_ChargeTotal" format="0,000" span="2" source="1*Clm_TotalChargeAmountTotal"/>
              <control type="label" label="Impuesto" span="2"/>
              <control type="calc" name="Clm_TaxTotal" format="0,000" span="2" source="1*Clm_TaxAmountTotal"/>
              <control type="label" label="Neto" span="2"/>
              <control type="calc" name="Clm_NetTotal" format="0,000" span="2" source="1*Clm_NetAmountTotal"/>
            </row>
            <row> 
               <control type="label" label="Cuota" span="2"/>
              <control type="text" name="Clm_Copay" format="0,000" span="2"/>
              <control type="label" label="Coaseguro" span="2" badge="%"/>
              <control type="text" name="Clm_CoInsurance" format="0.00" default="0.00" edit="true" span="2"/>
              <control type="label" label="Copago" span="2"/>
              <control type="text" name="Clm_MedicalCoinsurance" format="0,000" span="2" readonly="true"/>
            </row>
           <row>
            <control type="label" label="Reducciones" span="2"/>
            <control type="calc" name="Clm_TotalReductions" span="2" format="0,000" source="Clm_Copay+Clm_MedicalCoinsurance" />
            <control type="label" label="Cobertura Pagador" span="2"/>
            <control type="text" name="Clm_PayerCoverageAmount" span="2" format="0,000" readonly="true"/>
            <control type="label" label="Total a Pagar" span="2"/>
            <!-- Matches the exact Payer responsibility without adding PayerCoverageAmount twice -->
            <control type="calc" name="Clm_PayerNetAmount" format="0,000" span="2" source="Clm_NetTotal-Clm_TotalReductions"/>
          </row>
      </subset>
      </column>
      </columns>
    </group>
    <!-- Display list of charges, payments and SAT Invoices -->
    <group name="grpPayerCharges" reveal="[ClaimGuid]!+[FileName]=PatientBilling">
       <row>
        <control type="buttongroup" name="ClaimButtonGroupSelect" edit="true" mode="auto" 
          source="Charges,Payments,DIANInvoices" 
          sourcelabels="Cargos,Pagos,Facturas de DIAN" 
          span="6" 
          default="Charges"  
          provoke="ClaimGridOptions|options"/>
      </row>
      <row>
        <!-- Claim charges -->
        <control type="options" name="ClaimGridOptions" affector="ClaimButtonGroupSelect" span="12">
          <partial link="Partials/ColombiaPartialBillingClaimCharges.xml"/>
          <partial link="Partials/ColombiaPartialBillingClaimPayments.xml"/>
          <partial link="Partials/ColombiaPartialClaimDIANInvoiceList.xml"/>
        </control>
      </row> 
    </group>
  </section>
</partial>