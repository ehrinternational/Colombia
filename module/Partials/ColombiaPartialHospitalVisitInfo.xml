<partial>
  <!-- Partial Hospital Patient Visit information -->
    <row>
      <control type="hidden" name="ReadyForDischarge"/>
      <control type="hidden" name="PriorDepartmentGuid"/>
      <control type="hidden" name="PriorDepartmentService"/>
    </row>
    <row>
        <control type="label" label="Tipo de Atención" span="2"/>
        <control type="select" name="mdlAdmit_AdmitType" span="4" 
          namefield="mdlAdmit_AdmissionType"
          sort="AdmissionType=asc"
          datasource="GetLookupAdmissionTypesActive" 
          source="AdmissionType,AdmissionTypeGuid" 
          required="true" 
          explicit="true"
          edit="true"/>
        <control type="label" label="Tipo de llegada" span="2"/>
        <control type="select" name="mdlAdmit_AdmitSource" span="4" 
          datasource="GetLookupAdmitSourcesByFacility" 
          source="AdmitSource,AdmitSource"
          edit="true" sort="AdmitSource=asc"
          required="true" 
          explicit="true"
          filter="Active=true"/>
      </row>
      <row>
        <control type="label" label="Tipo de Caso" span="2"/>
        <control type="select" name="mdlAdmit_CaseType" span="4" 
          acctsvc="true" required="true" edit="true"
          datasource="GetCaseTypesActive" 
          source="CaseTypeName,CaseTypeGuid" 
          sort="CaseTypeName=asc" 
          explicit="true"/>
        <control type="label" label="Estatus" span="2"/>
        <control type="text" name="mdlAdmit_CurrentService" span="4" readonly="true"/>
      </row>
     <row>
        <control type="label" label="Departamento" span="2"/>
        <control type="select" name="mdlAdmit_CurrentDepartment" span="4"
          reveal="[HasOpenVisit]=true" readonly="true"
          acctsvc="true"
          explicit="true"
          datasource="GetDepartmentsActive" 
          append="LocationId=(facilityData.LocationId)"
          source="DepartmentName,DepartmentGuid"/>
        <control type="select" name="AdmitSelect_DepartmentGuid" span="4"
          reveal="[HasOpenVisit]=false" edit="true" required="true"
          acctsvc="true"
          datasource="GetDepartmentsActive" 
          append="LocationId=(facilityData.LocationId)"
          source="DepartmentName,DepartmentGuid"
          provoke="[HasOpenVisit]=false;AdmitSelect_DepartmentService^mdlAdmit_DepartmentService"/>
        <control type="label" label="Servicio" span="2"/>
        <control type="select" name="mdlAdmit_DepartmentService" span="4"
          reveal="[HasOpenVisit]=true"
          filter="DepartmentGuid=[AdmitSelect_DepartmentGuid]"
          explicit="true"
          acctsvcreq="true"
          datarequest="GetDepartmentServices" 
          source="ServiceName,DepartmentServicesGuid"/>
        <control type="select" name="AdmitSelect_DepartmentService" span="4"
          reveal="[HasOpenVisit]=false+Length(AdmitSelect_DepartmentService)»0" required="true" edit="true"
          explicit="true"
          acctsvcreq="true"
          filter="DepartmentGuid=[AdmitSelect_DepartmentGuid]"
          datarequest="GetDepartmentServices" 
          source="ServiceName,DepartmentServicesGuid"/>
      </row>
      <row>
        <control type="label" label="Cama" span="2"/>
        <control type="text" name="mdlAdmit_OpenRoom" span="4" readonly="true"/>
      </row>
</partial>