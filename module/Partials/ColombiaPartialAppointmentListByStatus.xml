<partial>
  <section type="tab" name="tabPatientAppointments" title="Citas de Pacientes" trigger="[calStartDate]!+[calEndDate]!;grdPatientAppointmentList">
    <group>
      <row>
        <control type="buttongroup" name="btngrpSelectStatusList"
          span="8" default="Scheduled" mode="auto"
          source="Scheduled,Confirmed,Completed,No Show,Canceled,Reschedule"
          color="green,darkgreen,yellow,orange,red,lightblue"
          sourcelabels="Programada,Confirmada,Completa,No Asistio,Cancelada,Reprograma"
          trigger="[calStartDate]!+[calEndDate]!;grdPatientAppointmentList"/>
        <control type="date" name="calStartDate" default="now" span="2" 
          trigger="[calStartDate]!+[calEndDate]!;grdPatientAppointmentList"/>
        <control type="date" name="calEndDate" default="now+1" span="2" 
          trigger="[calStartDate]!+[calEndDate]!;grdPatientAppointmentList"/>
      </row>
      <row>
        <!-- Patient Appointment List with admit and edit -->
        <control type="datagrid" 
          label="Citas de Pacientes" 
          name="grdPatientAppointmentList" 
          idle="[calStartDate]=,[calEndDate]="
          searchable="true"
          rows="20" span="12"
          action="redirect"
          target="[[CalendarType]]=FirstVisit;mdlFirstVisitAppointmentModal,
                  [[CalendarType]]=ConsultVisit;mdlConsultVisitAppointmentModal"
          datarequest="GetPatientAppointmentsByDateRange"
          appendrequest="LocationId=(facilityData.LocationId),startDateTime=[calStartDate],endDateTime=[calEndDate],status=[btngrpSelectStatusList]"
          source="Start,CalendarName,PatientFirstMiddleLast,PatientCellPhone,Subject,ProviderFullName"
          sourcelabels="Fecha y Hora,Calendario,Paciente,Celular,Asunto,Médico"
          translate="Status"
          sort="Start=desc"
          align="|left|left|left|left|left"
          format="datetime"
          key="AppointmentGuid"
          onselectset="[[CalendarType]]=FirstVisit;FirstVisit_AppointmentGuid=[[AppointmentGuid]],
            [[CalendarType]]=ConsultVisit;ConsultVisit_AppointmentGuid=[[AppointmentGuid]]"
          onselect="[[CalendarType]]=FirstVisit;FirstVisit_AppointmentGuid,
            [[CalendarType]]=ConsultVisit;ConsultVisit_AppointmentGuid">
        <!-- button to admit patient -->
        <control type="button" name="btnAdmitFromAppointment"
          showif="feature"
          reveal="[[Status]]=Scheduled|Confirmed"
          icon="cloud-upload" label="Admitir"
          action="redirect" target="PatientTabModal"
          preset="DefaultAppointmentGuid=[[AppointmentGuid]],PatientId=[[PatientId]]"
          trigger="PatientId"/>
        </control>
      </row>
    </group>
  </section>
</partial>