<partial>
  <section type="tabmodal" name="mdlDisplayPlan" title="Detalles del Convenio" badge="none">
      <group>
        <row>
          <control type="hidden" name="PlanGuid"
            acctsvcreq="true"
            datarequest="GetInsurancePlans" 
            appendrequest="PlanGuid=[PlanGuid]"
            inject="grpPlanDetails"/>
        </row>
      </group>
      <group name="grpPlanDetails" bgcolor="white" title="Detalles del Plan">
        <row>
          <control type="label" span="3" label="Activo"/>
          <control name="Pld_IsActive" type="buttongroup" span="3" readonly="true" sourcelabels="Sí,No"
            source="True,False" default="True"/>
          <control type="label" span="3" label="Folio"/>
          <control name="Pld_PlanNumber" type="text" span="2" readonly="true"/>
        </row>
        <row>
          <control type="label" span="3" label="Fecha Inicio"/>
          <control name="Pld_StartDate" type="date" span="3" readonly="true" />
          <control type="label" span="3" label="Fecha Final"/>
          <control name="Pld_EndDater" type="date" span="3" readonly="true" />
        </row>
        <row>
          <control type="label" span="3" label="Código"/>
          <control name="Pld_PlanCode" type="text" span="3" readonly="true"/>
          <control type="label" span="3" label="Tipo de Plan"/>
          <control name="Pld_Category" type="select" span="3" readonly="true"  explicit="true"
            source="EPS_POS,PREPAGADA,SOAT,ARL_ATEP,POLIZA_PRIVADA"/>
        </row>  
        <row>
          <control type="label" span="3" label="Nombre"/>
          <control name="Pld_PlanName" type="text" span="9" readonly="true" />
        </row> 
        <row>
          <control type="label" span="3" label="Copago"/>
          <control name="Pld_Copay" type="text" span="3" readonly="true" format="0.00"/>
          <control type="label" span="4" label="Max de Gastos de Bolsillo" />
          <control name="Pld_MaxOutOfPocket" type="text" span="2" readonly="true" format="0.00"/>
        </row> 
        <row>
          <control type="label" span="3" label="Coaseguro Cirugía" badge="%"/>
          <control name="Pld_MedicalCoinsurance" type="text" span="3" readonly="true" format="0.0000"/>
          <control type="label" span="4" label="Coaseguro Comercial" badge="%"/>
          <control name="Pld_Coinsurance" type="text" span="2" readonly="true" format="0.0000"/>
        </row> 
        <row>
          <control type="label" span="3" label="Cap Tope"/>
          <control name="Pld_HasTopeCap" type="buttongroup" span="3" source="True,False" default="False" 
            sourcelabels="Sí,No" readonly="true"/>
          <control type="label" span="4" label="Max Tope por Evento"/>
          <control name="Pld_MaxTopeEvent" type="text" span="2" readonly="true" format="0.00"/>
        </row> 
        <row>
          <control type="label" span="3" label="Max Tope Anual"/>
          <control name="Pld_MaxTopeAnnual" type="text" span="3" readonly="true" format="0.00"/>
          <control type="label" span="4" label="Deducible Anual"/>
          <control name="Pld_DeductibleAnnual" type="text" span="2" readonly="true" format="0.00"/>
        </row> 
        <row>
          <control type="label" span="3" label="Requiere Autorización"/>
          <control name="Pld_RequiresAuthorization" type="buttongroup" span="3" readonly="true"
            source="True,False" sourcelabels="Sí,No" default="False"/>
          <control type="label" span="3" label="Convenio de Anulación" />
          <control name="Pld_CoverageOverride" type="text" span="3" readonly="true"/>
        </row> 
        <row>
          <control type="label" span="3" label="Notas" />
          <control name="Pld_Notes" type="text" span="9" readonly="true"/>
        </row>
    </group>
  </section>
</partial>