   <partial target="mdlReferringMd" link="./Partial/Modals/PartialReferringMds.xml"/>
   <partial target="mdlFindPatients" link="./Partial/Admin/PartialPatientSearchmodal.xml"/>
   <partial target="mdlLabOrders" link="./Partial/Modals/PartialLabOrdersWithScanResultsModalNoEdit.xml"/>
   <partial target="ImageOrderModalForReview" link="./Partial/Modals/PartialImagingOrderModalForReview.xml"/>
   <partial link="Partials/ColombiaPartialInterconsultRequestNoEdit.xml"/>
   <partial target="mdlCombinedECDForms" link="./Partial/Modals/PartialCombineECDFormsToPDF.xml"/>
</module>
