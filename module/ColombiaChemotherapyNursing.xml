<?xml version="1.0" encoding="utf-8"?>
<module name="Enfermería de Tratamiento" type="onload" trigger="PatientList">
  <facet name="SurgeryRequestOption" value="Physician"/>
  <facet name="DefaultAdmitType" value="Inpatient"/>
  <facet name="FileName" value="TreatmentNursing"/>
  <facet name="FieldEdit" value="3"/>
  <facet name="AllowBedReservations" value="false"/>
  <facet name="DefaultInventoryLocation"/>
  <facet name="InventoryLocationType" value="Nursing"/>
   <!-- Import templates -->
  <partial link="Partials/ColombiaPartialTemplates.xml"/>
  <!-- Headerbutton displays report list -->
  <headerbutton name="btnReportsByType"
    icon="print" label="Informes"
    preset="Report_Type=Nurse"
    trigger="ReportList"
    action="redirect" target="mdlReports"/>
  <headerbutton name="btnTreatmentCalendar"
    icon="calendar" label="Tratamiento"
    trigger="TreatmentAppointmentTimes"
    preset="DefaultPatientId=,DefaultOrderGuid="
    action="redirect" target="mdlTreatmentAppointments"/>
  <!-- Admitted patient list -->
  <section name="tabAdmittedPatients" type="tab" title="Pacientes por Departamento" trigger="PatientList">
    <group>
      <row>
          <control type="select" 
            span="4"
            name="DepartmentGuidLookup"
            acctsvc="true"
            explicit="true"
            edit="true"
            filter="DepartmentName%Sala"
            datasource="GetDepartmentsActive" 
            append="LocationId=(facilityData.LocationId)" 
            source="DepartmentName,DepartmentGuid"
            provoke="PatientList"/>
      </row>
      <row>
        <control type="datagrid" label="Pacientes por Departamento" 
          name="PatientList"
          persist="true"
          action="redirect" 
          target="PatientTabModal"
          searchable="true"
          edit="only"
          span="12"
          rows="25"
          fitrows="true"
          gridfilter="ListFilter|HospitalService"
          datarequest="GetPatientListWithOpenVisitsByFacility"
					rowcolor="ReadyForDischarge|True=green"
          idle="[DepartmentGuidLookup]=|reset"
          appendrequest="DepartmentGuid=[DepartmentGuidLookup]" 
          source="ProfilePhoto,ReadyForDischarge,AdmitDateTime,MedicalRecordNumber,PatientFullName,PatientDOB,PatientAge,PatientSex,HospitalService,AttendingDoctorFullName,OpenRoom"
          sourcelabels="Foto,Alta,Admitido,Expediente,Nombre,Nacimiento,Edad,Sexo,Servicio,Médico Tratante,Consultorio"
          align="|||left|left|left|left|left|left|left"
          translate="PatientSex"
          format="image=circle|boolean|datetime_short|||date"
          sort="AdmitDateTime=asc"
          key="RecordUniqueId"
          onselectset="PatientId=[[RecordUniqueId]],PatientVisitGuid=[[PatientVisitId]]"
          onselect="PatientId,PatientVisitGuid"> 
          <control type="button" name="btnSearchForPatients"
						reveal="[DepartmentGuidLookup]!"
						action="redirect" icon="folder-open" label="Buscar Pacientes"
						target="mdlInitiateFindPatients"/>
					<control type="button" name="RefreshAppointments2" label="Actualizar"
						icon="refresh" action="trigger" trigger="PatientList"/>
        </control>
        </row>
      </group>
  </section>
  <!-- Nurse version of Bed Map -->
  <partial link="./Partial/Beds/PartialBedMapSupervisor.xml"/>
  <!-- Nursing orders for nurse based on bed assignment -->
  <partial link="./Partial/Admin/PartialNursingOrderAdministration.xml"/>
  <!-- Medication administration for nurse based on bed assignment -->
  <partial link="./Partial/Admin/PartialInpatientMedicationDepartmentAdministration.xml"/>
  <!-- Inventory Patient charge of stock items -->
  <partial link="../../ERPSpanish/module/Partials/PartialESPatientChargeStockItems.xml"/>
  <!-- Stock requisitions -->
  <partial link="../../ERPSpanish/module/Partials/PartialESStockRequests.xml"/>
  <!-- Inventory stock items for location -->
  <partial link="../../ERPSpanish/module/Partials/PartialESStockItemsByLocationNoEdit.xml"/>
  <!-- Inventory count -->
  <partial link="../../ERPSpanish/module/Partials/PartialESCountStockItemsByLocation.xml"/>
  <partial link="../../ERPSpanish/module/Partials/PartialESInventoryScanCount.xml"/>
  <!-- Patient tabmodal displays the patient chart -->
  <section type="tabmodal" badge="none" name="PatientTabModal" title="Información del Paciente" edit="false">
    <group name="GuidStorage">
      <row showif="never">
        <!-- Get patient information -->
        <control type="text" name="PatientId"
          datarequest="GetPatientAllFields"
          appendrequest="PatientId=[PatientId]"
          inject="PatientInfo"
          provoke="[HasOpenVisit]=true;GetCurrentPatientVisit"/>
        <!-- Get the current patient visit -->
        <control type="button" name="GetCurrentPatientVisit"
          action="trigger"
          preset="PatientVisitGuid=[PatientVisit]"
          provoke="PatientVisitGuid"/>
        <!-- Get visit information -->
        <control type="hidden" name="PatientVisitGuid"
          datarequest="GetPatientVisitByUniqueId"
          appendrequest="UniqueId=[PatientVisitGuid]"
          inject="rowUnacknowledged,VisitInfo"
          provoke="ERNursingOrders|active,ERNursingOrdersComplete|active,ERPatientLines|active,GetCurrentPatientProtocol"/>
        <!-- Get current Protocol for treatment -->
        <control type="select" name="GetCurrentPatientProtocol"
          acctsvcreq="true"
          filter="Status=Approved"
          default="true"
          sort="DateTimeEntered=desc"
          source="Description,ProtocolGuid"
          datarequest="GetChemotherapyProtocols"
          appendrequest="patientId=[PatientId]"
          set="CurrentProtocolNumber=[[ProtocolNumber]],CurrentProtocolDescription=[[Description]],CurrentProtocolGuid=[[ProtocolGuid]],CurrentProtocolNotes=[[Notes]],CurrentApprovedByName=[[ApprovedByFullName]],CurrentApprovedBy=[[ApprovedBy]]"
          provoke="[CurrentProtocolGuid]!;GetCurrentProtocolCycle"/>
        <control type="select" name="GetCurrentProtocolCycle"
          acctsvcreq="true"
          filter="Status=Active"
          default="true"
          sort="CycleNumber=asc"
          source="CycleNumber,CycleGuid"
          datarequest="GetChemotherapyProtocolCycles"
          appendrequest="ProtocolGuid=[CurrentProtocolGuid]"
          set="CurrentCycleNumber=[[CycleNumber]],CurrentCycleGuid=[[CycleGuid]],CurrentCycleDescription=[[Description]]"
          provoke="[CurrentCycleGuid]!;GetCurrentProtocolDay"/>
        <control type="select" name="GetCurrentProtocolDay"
          acctsvcreq="true"
          filter="Status=Active|Scheduled|Confirmed"
          default="true"
          sort="CycleDayText=asc"
          source="DayNumber,DayGuid"
          datarequest="GetChemotherapyProtocolCycleDays"
          appendrequest="CycleGuid=[CurrentCycleGuid]"
          set="CurrentDayNumber=[[DayNumber]],CurrentDayDescription=[[Description]],CurrentDayGuid=[[DayGuid]],CurrentDayNotes=[[Note]]"
          provoke="grdCurrentProtocolMeds"/>
        <!-- Insert new bed assignment -->
        <control type="text" span="4" name="InsertNewBedAssignment"
          datarequest="GetPatientVisitByUniqueId"
          appendrequest="UniqueId=[PatientVisitGuid]"
          set="mdlAdmit_OpenRoom=[[OpenRoom]]"/>
        <!-- Get unacknowledged orders -->
        <control type="hidden" name="GetUnAcknowledgedOrders"
          datarequest="GetPatientVisitByUniqueId"
          appendrequest="UniqueId=[PatientVisitGuid]"
          inject="rowUnacknowledged"/>
        <!-- Close patient tab modal -->
        <control type="button" name="ClosePatientTabModal" action="close|new"/>
      </row>
      <row name="rowUnacknowledged">
        <control type="hidden" name="UnAcknowledgedOrders"/>
      </row>
    </group>
    <!-- Patient information and nursing buttons -->
    <group name="PatientInfo">
      <columns>
        <column span="10">
          <partial link="Partials/ColombiaPartialHospitalPatientInformation.xml"/>
        </column>
        <column span="2">
          <partial link="Partials/ColombiaPartialHospitalNursePatientButtons.xml"/>
        </column>
      </columns>
    </group>
    <!-- Patient visit and nursing buttons -->
    <group name="VisitInfo">
      <columns>
        <column span="10">
          <partial link="Partials/ColombiaPartialTreatmentVisitInfo.xml"/>
        </column>
        <column span="2">
          <partial link="Partials/ColombiaPartialHospitalNurseVisitButtons.xml"/>
        </column>
      </columns>
    </group>
    <group name="PatientGridGroup">
      <row>
        <control type="buttongroup" name="ButtonGroupSelect" edit="true" mode="auto" span="12" default="Nursing"
          source="Problems,Nursing,Vitals,Physicians,Studies,Medication,Surgery,Documents,Appointments,Protocols,Quotes" 
          sourcelabels="Diagnósticos,Enfermería,Vitales,Médicos,Estudios,Medicamentos,Procedimientos,Documentos,Citas,Esquemas,Cotizaciones" 
          provoke="ERGridList|options"/>
      </row>
      <row>
          <control name="ERGridList" affector="ButtonGroupSelect" type="options" span="12">
          <partial link="./Partial/Grids/PartialDiagnosisActiveForPatientNoAdd.xml"/>
          <partial link="./Partial/Grids/PartialDiagnosisHistoryForPatient.xml"/>
          <partial link="./Partial/Grids/PartialAllergiesWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialNursingOrdersWithNewAndManage.xml"/>
          <partial link="./Partial/Grids/PartialNursingOrdersCompleted.xml"/>
          <partial link="./Partial/Grids/PartialPatientChargesAndNewAsNursing.xml"/>
          <partial link="./Partial/Grids/PartialPatientLines.xml"/>
          <partial link="./Partial/Grids/PartialVitalSignsWithNewAndGraph.xml"/>
          <partial link="./Partial/Grids/PartialFluidsWithTotalsAnd24Hour.xml"/>
          <partial link="./Partial/Grids/PartialBloodSugarVitalSignsWithNew.xml"/>
          <partial link="./Partial/Grids/PartialNeuroVitalSignsWithNew.xml"/>
          <partial link="./Partial/Grids/PartialPhysicianAssignmentsWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialLabOrdersWithScannedResultsNoEdit.xml"/>
          <partial link="./Partial/Grids/PartialPathologyReportsNewAndCancel.xml"/>
          <partial link="./Partial/Grids/PartialGenomicReportsNewAndCancel.xml"/>
          <partial link="./Partial/Grids/PartialImagingOrderListNoEdit.xml"/>
          <partial link="./Partial/Grids/PartialImagingReports.xml"/>
          <partial link="./Partial/Grids/PartialProtocolMedsForDay.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationWithTemplateAdministration.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationsCompleted.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationActiveAdministrations.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationCompletedAdministrations.xml"/>
          <partial link="./Partial/Grids/PartialInpatientMedicationAdministrationsHistory.xml"/>
          <partial link="./Partial/Grids/PartialHomeMedicationNoEdit.xml"/>
          <partial link="./Partial/Grids/PartialProcedureOrdersWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialSurgeryListForPatient.xml"/>
          <partial link="./Partial/Grids/PartialECDFormsWithNewEditAndCancelOnlyByUserWindowMode.xml"/>
          <partial link="./Partial/Grids/PartialScannedDocumentsWithNewAndCancel.xml"/>
          <partial link="./Partial/Grids/PartialChemoProtocolsWithNewAndEdit.xml"/>
          <partial link="./Partial/Grids/PartialAdverseMedicationEventsNoEdit.xml"/>
          <partial link="./Partial/Grids/PartialInternalConsultRequestsForPatient.xml"/>
          <partial link="./Partial/Grids/PartialPatientQuotesPrintOnlyNoAmounts.xml"/>
          <partial link="./Partial/Grids/PartialAppointmentListForPatientNoEdit.xml"/>
        </control>
       </row>
     </group>
   </section>
    <!-- Calendars -->
    <partial link="./Partial/Calendars/PartialCalendarCancelCOIAppointments.xml"/>
    <partial link="./Partial/Calendars/PartialCalendarTreatmentAsModal.xml"/>
    <partial link="./Partial/Calendars/PartialCalendarTreatmentAppointmentModal.xml"/>
    <!-- General modals -->
    <partial target="mdlCombinedECDForms" link="./Partial/Modals/PartialCombineECDFormsToPDF.xml"/>
    <partial link="./Partial/Admin/PartialInitiatePatientSearchModalAllPatients.xml"/>
    <partial link="./Partial/Requests/PartialInternalConsultRequest.xml"/>
    <partial link="./Partial/Modals/PartialChemotherapyProtocolModal2.xml"/>
    <partial link="./Partial/Modals/PartialLabOrdersWithScanResultsModalNoEdit.xml"/>
    <partial link="./Partial/Grids/PartialFluidTotals.xml"/>
    <partial link="./Partial/Admin/PartialPatientSearchModal.xml"/>
    <partial link="./Partial/Admin/PartialReportModals.xml"/>
    <partial link="./Partial/Admin/PartialReadyForDischarge.xml"/>
    <partial link="./Partial/Modals/PartialPatientChargesModal.xml"/>
    <partial link="./Partial/Grids/Partial24HourBalance.xml"/>
    <partial link="./Partial/Modals/PartialReferringMds.xml"/>
    <partial link="./Partial/Move/PartialTransferPatientWithBedAssignment.xml"/>
    <!-- Inventory Patient charge of stock items -->
    <partial link="../../ERPSpanish/module/Partials/PartialESInventoryPatientCharges.xml"/>
    <partial link="../../ERPSpanish/module/Partials/PartialESViewPatientCharges.xml"/>
   </module>
